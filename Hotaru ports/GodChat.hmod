import secrets
from types import SimpleNamespace
import threading
import time
from datetime import datetime, timedelta, timezone

_LOCK = threading.RLock()
_SESSIONS = {}
_INPUTS = {}
_ME = None
_CHAT_LOCKS = {}
_JOB = contextvars.ContextVar("godchat_job", default=None)
_GLOBAL_LOCK = threading.Lock()
_LINKED = {}
_NATIVE_JOBS = {}
_HISTORY_AT = 0.0
_NATIVE_EXECUTING = contextvars.ContextVar('godchat_native_job', default=False)
_ICONS = {"ok": '<tg-emoji emoji-id="5206607081334906820">✅</tg-emoji>', "error": '<tg-emoji emoji-id="5121063440311386962">👎</tg-emoji>', "settings": '<tg-emoji emoji-id="4904936030232117798">⚠️</tg-emoji>', "user": '<tg-emoji emoji-id="5188678912883827293">🤖</tg-emoji>', "time": '<tg-emoji emoji-id="5870921681735781843">⏱</tg-emoji>'}
_ICONS.update({
    'settings': '<tg-emoji emoji-id="5258096772776991776">⚙️</tg-emoji>',
    'reason': '<tg-emoji emoji-id="5879841310902324730">✏️</tg-emoji>',
    'source': '<tg-emoji emoji-id="5253590213917158323">💬</tg-emoji>',
    'count': '<tg-emoji emoji-id="5877485980901971030">📊</tg-emoji>',
    'send': '<tg-emoji emoji-id="5873225338984599714">📤</tg-emoji>',
    'ban': '<tg-emoji emoji-id="5278578973595427038">🚫</tg-emoji>',
    'mute': '<tg-emoji emoji-id="5407001145740631266">🤐</tg-emoji>',
})
_DURATION_ALIASES = {'': ('minutes', 60), 's': ('seconds', 1), 'с': ('seconds', 1), 'sec': ('seconds', 1), 'secs': ('seconds', 1), 'second': ('seconds', 1), 'seconds': ('seconds', 1), 'сек': ('seconds', 1), 'секунда': ('seconds', 1), 'секунды': ('seconds', 1), 'секунд': ('seconds', 1), 'm': ('minutes', 60), 'м': ('minutes', 60), 'min': ('minutes', 60), 'mins': ('minutes', 60), 'minute': ('minutes', 60), 'minutes': ('minutes', 60), 'мин': ('minutes', 60), 'минута': ('minutes', 60), 'минуты': ('minutes', 60), 'минут': ('minutes', 60), 'h': ('hours', 60 * 60), 'ч': ('hours', 60 * 60), 'hour': ('hours', 60 * 60), 'hours': ('hours', 60 * 60), 'час': ('hours', 60 * 60), 'часа': ('hours', 60 * 60), 'часов': ('hours', 60 * 60), 'd': ('days', 24 * 60 * 60), 'д': ('days', 24 * 60 * 60), 'day': ('days', 24 * 60 * 60), 'days': ('days', 24 * 60 * 60), 'день': ('days', 24 * 60 * 60), 'дня': ('days', 24 * 60 * 60), 'дней': ('days', 24 * 60 * 60), 'y': ('years', 365 * 24 * 60 * 60), 'г': ('years', 365 * 24 * 60 * 60), 'л': ('years', 365 * 24 * 60 * 60), 'year': ('years', 365 * 24 * 60 * 60), 'years': ('years', 365 * 24 * 60 * 60), 'год': ('years', 365 * 24 * 60 * 60), 'года': ('years', 365 * 24 * 60 * 60), 'лет': ('years', 365 * 24 * 60 * 60)}
_DURATION_ALIASES.update({key: ("weeks", 604800) for key in ("w", "н", "week", "weeks", "неделя", "недели", "недель")})


_LOCALE = contextvars.ContextVar('godchat_locale', default=None)

def _l(key):
    ctx = _LOCALE.get()
    language = getattr(getattr(ctx, 'i18n', None), 'language', 'ru')
    language = 'en' if str(language).lower().startswith('en') else 'ru'
    default = HOTARU['lexicon'][language]['ui'].get(key, key)
    translator = getattr(ctx, 't', None)
    return translator('ui.' + key, default=default) if callable(translator) else default

def _localized(handler):
    async def localized(ctx, *args, **kwargs):
        token = _LOCALE.set(ctx)
        try:
            return await handler(ctx, *args, **kwargs)
        finally:
            _LOCALE.reset(token)
    return localized

class GodChatError(Exception):
    pass

class _JobStopped(GodChatError):
    pass


def _esc(value):
    return html.escape(str(value), quote=True)

def _body(value):
    if isinstance(value, dict) and value.get('ok') is False:
        raise GodChatError(str(value.get('error') or value.get('error_message') or _l('m000'))[:240])
    if isinstance(value, dict) and 'result' in value and ('_' not in value or value.get('_') == 'rpc_result'):
        value = value['result']
    if isinstance(value, dict) and value.get('ok') is False:
        raise GodChatError(str(value.get('error') or value.get('error_message') or _l('m000'))[:240])
    if isinstance(value, dict) and value.get('_') in ('boolTrue', 'boolFalse'):
        return value['_'] == 'boolTrue'
    return value

def _rows(value, key):
    value = _body(value)
    return value if isinstance(value, list) else value.get(key, []) if isinstance(value, dict) else []

def _id(value):
    if isinstance(value, int) and (not isinstance(value, bool)):
        return value
    if not isinstance(value, dict):
        return None
    for key, factor, offset in (('user_id', 1, 0), ('channel_id', -1, -1000000000000), ('chat_id', -1, 0)):
        if value.get(key) is not None:
            return factor * int(value[key]) + offset
    raw = value.get('id')
    if raw is None:
        return None
    tag = value.get('_', '').lower()
    return -1000000000000 - int(raw) if tag in ('channel', 'channelforbidden') else -int(raw) if tag in ('chat', 'chatforbidden') else int(raw)

def _sender(message):
    value = _id(message.get('from_id') or message.get('sender_id'))
    if value is not None:
        return value
    peer = message.get('peer_id') or {}
    return int(peer['user_id']) if not message.get('out') and isinstance(peer, dict) and peer.get('user_id') else None

def _in_topic(message, topic):
    header = message.get('reply_to') or {}
    return not topic or message.get('id') == topic or header.get('reply_to_top_id') == topic or (header.get('reply_to_msg_id') == topic)

def _username(entity):
    return entity.get('username') or next((item.get('username') for item in entity.get('usernames', []) if isinstance(item, dict) and item.get('active') and item.get('username')), None)

def _original_name(entity):
    return entity.get('title') or ' '.join(filter(None, (entity.get('first_name'), entity.get('last_name')))) or ('@' + _username(entity) if _username(entity) else _l('m001'))

def _name(ctx, entity):
    custom = ctx.state.get('name_overrides', {}).get(str(_id(entity)), {})
    return custom.get('name') or _original_name(entity)

def _label(ctx, entity):
    uid, username, name = (_id(entity), _username(entity), _esc(_name(ctx, entity)))
    if username:
        name = f'<a href="https://t.me/{_esc(username)}">{name}</a>'
    elif uid and uid > 0 and (entity.get('_') != 'userEmpty'):
        name = f'<a href="tg://openmessage?user_id={uid}">{name}</a>'
    return f'{name} (<code>{uid}</code>)'

def _rich(ctx):
    return bool(ctx.state.get('rich_mode', ctx.config.get('rich_mode', True)))

def _without_custom_emoji(value):
    if isinstance(value, str):
        return re.sub(r'(<tg-button\b[^>]*?)\sicon="[^"]*"', r'\1', re.sub(r'</?tg-emoji\b[^>]*>', '', value, flags=re.I), flags=re.I)
    if isinstance(value, dict):
        return {key: _without_custom_emoji(item) for key, item in value.items() if key != 'icon_custom_emoji_id'}
    if isinstance(value, (list, tuple)):
        return [_without_custom_emoji(item) for item in value]
    return value

def _emoji_error(exc):
    return any((code in str(exc).upper() for code in ('RICH_MESSAGE_EMOJI_INVALID', 'CUSTOM_EMOJI_INVALID', 'CUSTOM_EMOJI_DOCUMENT_INVALID')))

async def _emit(send, *args, **kwargs):
    try:
        return await send(*args, **kwargs)
    except Exception as exc:
        if not _emoji_error(exc):
            raise
        return await send(*_without_custom_emoji(args), **_without_custom_emoji(kwargs))

def _text_row_icon(key, value):
    if '<tg-emoji' in value:
        return ''
    groups = {
        'user': ('m054', 'm056', 'm063'),
        'source': ('m057', 'm160', 'm166'),
        'count': ('m093', 'm161', 'm189', 'm212', 'm213', 'm214', 'm219', 'm225', 'm259', 'm268', 'm304', 'm310', 'm320', 'm359', 'm374', 'm375'),
        'time': ('m031', 'm034', 'm068', 'm112', 'm162', 'm163', 'm226'),
        'reason': ('m053', 'm134', 'm135', 'm164', 'm360'),
        'send': ('m165',),
    }
    for icon, keys in groups.items():
        if key in (_l(item) for item in keys):
            return _ICONS[icon]
    if value in (_l(item) for item in ('m007', 'm115', 'm120', 'm151', 'm196', 'm234', 'm269', 'm309', 'm350', 'm367')):
        return _ICONS['error']
    if value in (_l(item) for item in ('m084', 'm087', 'm088', 'm108', 'm114', 'm121', 'm149', 'm150', 'm195', 'm270', 'm348', 'm349', 'm366')):
        return _ICONS['ok']
    return _ICONS['reason']

def _text_title_icon(title):
    if title in ('ID', _l('m002'), _l('m003'), _l('m004')):
        return _ICONS['user']
    if title == _l('m005') or title in (_l('m119'), _l('m303')):
        return _ICONS['ban']
    if title in (_l('m006'), _l('m086')):
        return _ICONS['mute']
    if title == _l('m007'):
        return _ICONS['error']
    if title in (_l('m065'), _l('m067'), _l('m302')):
        return _ICONS['ok']
    if title in (_l('m163'), _l('m255'), _l('m296'), _l('m297')) or _l('m008') in title:
        return _ICONS['time']
    if title in (_l('m111'), _l('m347')):
        return _ICONS['settings']
    return _ICONS['reason']

def _table(ctx, title, rows, note=''):
    decorated = []
    for key, value in rows:
        value = str(value)
        marker = _text_row_icon(key, value)
        decorated.append((key, marker + ' ' + value if marker else value))
    rows = decorated
    icon = _text_title_icon(title)
    if not _rich(ctx):
        return f'{icon} <b>GodChat · {_esc(title)}</b>\n\n' + '\n'.join((f'<b>{_esc(key)}:</b> {value}' for key, value in rows)) + ('\n\n' + note if note else '')
    table = '<table bordered striped compact>' + ''.join((f'<tr><td><b>{_esc(key)}</b></td><td>{value}</td></tr>' for key, value in rows)) + '</table>' if rows else ''
    return f'<h3>{icon} GodChat · {_esc(title)}</h3>' + table + (note if note.startswith(('<blockquote', '<p>')) else '<p>' + note + '</p>' if note else '')

async def _answer(ctx, title, rows, note=''):
    return await _emit(ctx.respond, _table(ctx, title, rows, note), parse_mode='HTML', rich=_rich(ctx))

def _save(ctx, key, identity, value):
    with _LOCK:
        data = dict(ctx.state.get(key, {}))
        if value is None:
            data.pop(str(identity), None)
        else:
            data[str(identity)] = value
        ctx.state.set(key, data)

def _setting(ctx, key, chat=None):
    return ctx.state.get(key, {}).get(str(ctx.chat_id if chat is None else chat))

def _tz(ctx):
    return timezone(timedelta(minutes=int(ctx.state.get('timezone_minutes', 180))))

def _date(value):
    if isinstance(value, datetime):
        return value.timestamp()
    if isinstance(value, (int, float)):
        return float(value)
    if isinstance(value, str):
        try:
            return datetime.fromisoformat(value.replace('Z', '+00:00')).timestamp()
        except ValueError:
            pass
    return 0

def _duration(words):
    if not words:
        return (0, 0)
    if words[0].lower() in ('forever', 'навсегда', '0'):
        return (0, 1)
    if not words[0][:1].isdigit():
        return (0, 0)
    match = re.fullmatch('(\\d+)([^\\d\\s]*)', words[0].lower())
    if not match or int(match[1]) <= 0:
        raise GodChatError(_l('m010'))
    alias, consumed = (match[2], 1)
    if not alias and len(words) > 1 and (words[1].lower() in _DURATION_ALIASES):
        alias, consumed = (words[1].lower(), 2)
    if alias not in _DURATION_ALIASES:
        raise GodChatError(_l('m011'))
    seconds = int(match[1]) * _DURATION_ALIASES[alias][1]
    if seconds > 315360000:
        raise GodChatError(_l('m012'))
    return (seconds, consumed)

def _duration_label(seconds):
    if not seconds:
        return _l('m009')
    parts = []
    for size, forms in ((31536000, (_l('m013'), _l('m014'), _l('m015'))), (604800, (_l('m016'), _l('m017'), _l('m018'))), (86400, (_l('m019'), _l('m020'), _l('m021'))), (3600, (_l('m022'), _l('m023'), _l('m024'))), (60, (_l('m025'), _l('m026'), _l('m027'))), (1, (_l('m028'), _l('m029'), _l('m030')))):
        amount, seconds = divmod(seconds, size)
        if amount:
            form = forms[2] if 11 <= amount % 100 <= 14 else forms[0] if amount % 10 == 1 else forms[1] if 2 <= amount % 10 <= 4 else forms[2]
            form = forms[0] if amount == 1 else forms[2] if _l('language') == 'en' else form
            parts.append(f'{amount} {form}')
    return ' '.join(parts)

def _wait(exc):
    match = re.search('(?:FLOOD(?:_PREMIUM)?_WAIT[_ :]*(\\d+)|(?:wait|sleep|retry)[^\\d]{0,25}(\\d+))', str(exc), re.I)
    return int(next((part for part in match.groups() if part), '0')) if match else 0

async def _rpc(ctx, method, values, retry=True):
    attempts = 0
    emoji_retry = False
    options = dict(values)
    if method != 'upload.getFile':
        options['retry'] = 0
    while True:
        try:
            return _body(await ctx.tg.call(method, options))
        except Exception as exc:
            if not emoji_retry and _emoji_error(exc) and ('rich_message' in options or 'reply_markup' in options):
                emoji_retry = True
                options = _without_custom_emoji(options)
                continue
            seconds = _wait(exc)
            if not retry or not seconds:
                raise
            if _JOB.get():
                await _job_wait(seconds)
            elif attempts == 0 and seconds <= 30:
                attempts += 1
                await asyncio.sleep(seconds + 1)
            else:
                raise

async def _job_wait(seconds):
    ctx, callback, state = _JOB.get()
    buttons = [] if state.get('sending') else [[_button(ctx, _l('m033'), state, 'stop', 'danger')]]
    await _emit(callback.edit, _table(ctx, _l('m031'), [(_l('m034'), str(seconds) + _l('m035'))]), reply_markup=buttons, rich=_rich(ctx))
    for _ in range(seconds + 1):
        if state['cancelled'] and (not state.get('sending')):
            raise _JobStopped(_l('m032'))
        await asyncio.sleep(1)

async def _run_job(ctx, callback, state, handler, *args):
    if state.get('native') and not _NATIVE_EXECUTING.get():
        with _LOCK:
            if state.get('busy') or state.get('queued') or state['token'] in _NATIVE_JOBS:
                raise GodChatError(_l('m266'))
            state.update(queued=True, cancelled=False, native_job_active=True)
            _NATIVE_JOBS[state['token']] = dict(ctx=ctx, state=state, handler=handler, args=args, running=False)
        await callback.edit(_table(ctx, _l('m373'), [(_l('m064'), _l('native_queued'))]), reply_markup=[[_button(ctx, _l('m033'), state, 'stop', 'danger')]], rich=_rich(ctx))
        return
    token = _JOB.set((ctx, callback, state))
    try:
        return await handler(ctx, state, callback, *args)
    finally:
        _JOB.reset(token)

async def _retry_action(factory):
    while True:
        try:
            return await factory()
        except _JobStopped:
            raise
        except Exception as exc:
            seconds = _wait(exc)
            if not seconds or not _JOB.get():
                raise
            await _job_wait(seconds)

async def _me(ctx, refresh=False):
    global _ME
    if _ME is None or refresh:
        users = _rows(await _rpc(ctx, 'users.getUsers', {'id': [{'_': 'inputUserSelf'}]}), 'users')
        if not users:
            raise GodChatError(_l('m036'))
        _ME = users[0]
    return _ME

async def _resolve(ctx, value):
    if isinstance(value, dict) and value.get('_') not in ('peerUser', 'peerChat', 'peerChannel'):
        return value
    value = _id(value) if isinstance(value, dict) else value
    if isinstance(value, str) and value.lstrip('-').isdigit():
        value = int(value)
    if value == 'self':
        return await _me(ctx)
    if isinstance(value, str) and re.fullmatch(r'@?[A-Za-z0-9_]+', value):
        result = await _rpc(ctx, 'contacts.resolveUsername', {'username': value.lstrip('@')})
        peer = result.get('peer') if isinstance(result, dict) else None
        identity = _id(peer)
        if identity is None:
            raise GodChatError(_l('m037'))
        entities = _rows(result, 'users') if identity > 0 else _rows(result, 'chats')
        found = next((entity for entity in entities if _id(entity) == identity), None)
        if isinstance(found, dict):
            return found
        raise GodChatError(_l('m037'))
    found = await ctx.resolve(value)
    if not isinstance(found, dict):
        raise GodChatError(_l('m037'))
    return found

async def _input(ctx, value, kind='peer'):
    if isinstance(value, dict) and str(value.get('_', '')).startswith('input'):
        return value
    if value == 'self':
        return {'_': 'inputUserSelf' if kind == 'user' else 'inputPeerSelf'}
    entity = await _resolve(ctx, value)
    uid = _id(entity)
    if uid is None:
        raise GodChatError(_l('m038'))
    if uid > 0:
        if uid == _id(await _me(ctx)):
            return {'_': 'inputUserSelf' if kind == 'user' else 'inputPeerSelf'}
        if entity.get('access_hash') is None:
            raise GodChatError(_l('m040'))
        return {'_': 'inputUser' if kind == 'user' else 'inputPeerUser', 'user_id': uid, 'access_hash': entity['access_hash']}
    if uid < -1000000000000:
        if entity.get('access_hash') is None:
            raise GodChatError(_l('m041'))
        return {'_': 'inputChannel' if kind == 'channel' else 'inputPeerChannel', 'channel_id': -uid - 1000000000000, 'access_hash': entity['access_hash']}
    if kind != 'peer':
        raise GodChatError(_l('m039'))
    return {'_': 'inputPeerChat', 'chat_id': -uid}

async def _target(ctx, invocation, allow_channel=False):
    words = list(invocation.args)
    reply = await ctx.reply()
    if isinstance(reply, dict):
        uid = _sender(reply)
        if uid is None and reply.get('out'):
            uid = _id(await _me(ctx))
        if uid is None:
            raise GodChatError(_l('m043'))
        entity = await _resolve(ctx, uid)
    elif words:
        index = next((index for index, word in enumerate(words) if word not in ('-a', '-d', '-f', '-all')), None)
        if index is None:
            raise GodChatError(_l('m045'))
        entity = await _resolve(ctx, words.pop(index))
    else:
        raise GodChatError(_l('m044'))
    uid = _id(entity)
    if uid is None or (uid < 0 and (not allow_channel)):
        raise GodChatError(_l('m042'))
    return (entity, words, reply)

async def _permissions(ctx, chat=None, user='self'):
    chat = ctx.chat_id if chat is None else chat
    if not isinstance(chat, int) or chat >= 0:
        return {'private': True, 'delete_messages': True, 'ban_users': False}
    if chat < -1000000000000:
        result = await _rpc(ctx, 'channels.getParticipant', {'channel': await _input(ctx, chat, 'channel'), 'participant': await _input(ctx, user)})
        participant = result.get('participant', {})
        creator = participant.get('_') == 'channelParticipantCreator'
        rights = dict(participant.get('admin_rights') or {})
        rights.update(creator=creator, admin=creator or participant.get('_') == 'channelParticipantAdmin', participant=participant)
        if creator:
            rights.update({key: True for key in ('delete_messages', 'ban_users', 'invite_users', 'add_admins', 'change_info')})
        return rights
    result = await _rpc(ctx, 'messages.getFullChat', {'chat_id': -chat})
    uid = _id(await _me(ctx)) if user == 'self' else _id(await _resolve(ctx, user))
    participants = result.get('full_chat', {}).get('participants', {}).get('participants', [])
    row = next((item for item in participants if item.get('user_id') == uid), {})
    admin = row.get('_') in ('chatParticipantCreator', 'chatParticipantAdmin')
    return {'admin': admin, 'creator': row.get('_') == 'chatParticipantCreator', 'delete_messages': admin, 'ban_users': admin, 'invite_users': admin, 'add_admins': admin, 'change_info': admin, 'participant': row}

async def _require(ctx, right='ban_users', chat=None):
    rights = await _permissions(ctx, chat)
    if rights.get('private') or not rights.get(right):
        raise GodChatError(_l('m046') + right)
    return rights

async def _protect(ctx, entity):
    if _id(entity) == _id(await _me(ctx)):
        raise GodChatError(_l('m047'))
    if ctx.chat_id < 0:
        try:
            permissions = await _permissions(ctx, user=entity)
        except Exception as exc:
            if 'USER_NOT_PARTICIPANT' not in str(exc).upper():
                raise
        else:
            if permissions.get('admin'):
                raise GodChatError(_l('m048'))

def _session_expired(state, now):
    return not any(state.get(key) for key in ('busy', 'queued', 'native_job_active')) and now - state.get('touched', state['created']) > 3600

def _session(ctx, kind, **values):
    with _LOCK:
        now = time.time()
        for token, item in list(_SESSIONS.items()):
            if _session_expired(item, now):
                _SESSIONS.pop(token, None)
        token = secrets.token_hex(8)
        state = dict(token=token, kind=kind, created=now, chat=ctx.chat_id, topic=getattr(ctx, 'topic_id', None), actor=_id(ctx._msg.get('from_id')), busy=False, cancelled=False, **values)
        _SESSIONS[token] = state
        return state

def _get(token, actor=None):
    state = _SESSIONS.get(token)
    if not state or _session_expired(state, time.time()):
        raise GodChatError(_l('m049'))
    if actor is not None and actor != state['actor']:
        raise GodChatError(_l('m050'))
    state['touched'] = time.time()
    return state

def _button(ctx, text, state, action, style=None, **values):
    payload = dict(token=state['token'], action=action, **values)
    if state.get('picker') and (action.startswith('picker_') or action in ('hours', 'minutes', 'date_clear')):
        payload['picker_token'] = state['picker']['token']
    if _native_mode(ctx, state):
        button = dict(text=text, _native_action=payload)
        if style:
            button['style'] = style
        return _button_appearance(button, state, payload)

    async def handler(callback, payload):
        try:
            item = _get(payload['token'], callback.from_id)
            await _callback(ctx, callback, item, payload)
        except asyncio.CancelledError:
            raise
        except Exception as exc:
            await callback.respond(str(exc)[:180], alert=True)
    handler.__qualname__ = 'godchat_' + state['token'] + '_' + action + '_' + secrets.token_hex(5)
    button = ctx.ui.button(text, handler, payload, style=style)
    return _button_appearance(button, state, payload)

async def _form(ctx, state, text, buttons, callback=None):
    buttons = [[_button_appearance(button, state) if button.get('url') or button.get('copy_text') is not None else button for button in row] for row in buttons]
    if _native_mode(ctx, state):
        _native_view(state, text, buttons)
        if isinstance(callback, _NativeCallback):
            return
        if state.get('native_message'):
            await _native_refresh(ctx, state, force=True)
            return
        state['native'] = True
        try:
            message = await ctx.screens.show(_native_screen(ctx, state))
        except Exception as exc:
            if not _emoji_error(exc) or state.get('emoji_disabled'):
                raise
            state['emoji_disabled'] = True
            message = await ctx.screens.show(_native_screen(ctx, state))
        state['native_message'] = message.get('id') if isinstance(message, dict) else message if isinstance(message, int) and not isinstance(message, bool) else None
        state['form'] = 'native:' + state['token']
        if callback and not isinstance(callback, _SavedForm):
            await callback.delete()
        return
    if callback:
        await _emit(callback.edit, text, reply_markup=buttons, rich=_rich(ctx))
    else:
        state['form'] = await _emit(ctx.inline_form, text, buttons=buttons, form_handle=True, output='auto', inline=True, rich=_rich(ctx))

class _SavedForm:

    def __init__(self, ctx, state):
        self.ctx = ctx
        self.state = state

    async def edit(self, text, reply_markup=None, **kwargs):
        if self.state.get('native'):
            _native_view(self.state, text, reply_markup or [])
            await _native_refresh(self.ctx, self.state)
            return
        return await _emit(self.ctx.edit_form, self.state['form'], text, buttons=reply_markup)


def _native_mode(ctx, state):
    return bool((_rich(ctx) or state.get('native')) and callable(getattr(getattr(ctx, 'screens', None), 'screen', None)))

def _native_view(state, text, buttons):
    with _LOCK:
        state['native_view'] = dict(text=text, buttons=buttons)
        state['native_dirty'] = True

def _input_hint(action):
    if action == 'quote_input':
        return 'Введи значение после служебного кода.'
    if action in ('quote_author', 'quote_text'):
        return 'Автор: @username или ID. Пример: @telegram.' if action == 'quote_author' else 'Текст цитаты. Пример: Привет!'
    keys = {'req_amount': 'm380', 'name_input': 'm381', 'timezone_input': 'm382', 'panic_slow': 'm383', 'panic_joins': 'm392', 'panic_window': 'm393', 'hours': 'm386', 'minutes': 'm387', 'date_input': 'm388', 'name_value': 'm391', 'member_prefix': 'm398'}
    return _l(keys[action]) if action in keys else ''

def _native_input(action):
    return bool(_input_hint(action))

def _native_descriptor(payload, text, style=None):
    kind = 'input' if _native_input(payload['action']) else 'go'
    spec = dict(k=kind, m='godchat', f='screen_input' if kind == 'input' else 'screen_action', a=payload)
    if kind == 'input':
        spec['p'] = (payload.get('prompt') or _input_hint(payload['action'])) + ' ' + _l('input_submit_hint')
    return spec

def _native_button_icon(button, state=None, payload=None):
    if button.get('_quote_plain'):
        return None
    state = state or {}
    payload = payload or button.get('_native_action') or {}
    action = payload.get('action', '')
    if action in ('noop', 'day', 'calendar', 'picker_day', 'picker_shift', 'bulk_page', 'global_page', 'names_page'):
        return None
    if button.get('url'):
        return ('5445326466067754897', '🌐')
    if button.get('copy_text') is not None:
        return ('5445260044398524944', '📋')
    icons = {
        'close': ('5447647474984449520', '✖️'),
        'stop': ('5447647474984449520', '✖️'),
        'member_kick': ('5873225338984599714', '📤'),
        'member_ban': ('5447128406711891434', '🚫'),
        'member_unban': ('5444987348334965906', '✅'),
        'activity': ('5877485980901971030', '📊'),
        'member_prev': ('5447651546613449378', '◀️'),
        'member_next': ('5445364025556759279', '▶️'),
        'member_inline': ('5445373775132522312', '🔑'),
        'member_guest': ('5247029067256987229', '🤖'),
        'member_nochan': ('5447128406711891434', '🚫'),
        'member_prefix': ('5445373775132522312', '🔑') if payload.get('admin') else ('5879841310902324730', '✏️'),
        'native_refresh': ('5258420634785947640', '🔄'),
        'back': ('5258236805890710909', '⬅️'),
    }
    kind = state.get('kind')
    if action == 'config':
        view = payload.get('view')
        if view == 'quotes':
            return ('5253590213917158323', '💬')
        if view in ('names', 'names_saved', 'name_detail'):
            return ('5188678912883827293', '🤖')
        if view == 'timezone':
            return ('5870921681735781843', '⏱')
        if view == 'panic':
            return ('4904936030232117798', '⚠️')
        if view == 'chat':
            return ('5879841310902324730', '✏️')
        return ('5258236805890710909', '⬅️')
    if action in ('rich_toggle', 'panic_option'):
        enabled = button.get('style') == 'success'
        return ('5206607081334906820', '✅') if enabled else ('5985346521103604145', '❌') if action == 'rich_toggle' else ('5121063440311386962', '👎')
    if action in ('quote_author', 'quote_text', 'quote_send', 'quote_add', 'quote_remove', 'quote_store'):
        return {'quote_author': ('5188678912883827293', '🤖'), 'quote_text': ('5879841310902324730', '✏️'), 'quote_send': ('5873225338984599714', '📤'), 'quote_add': ('5444987348334965906', '✅'), 'quote_remove': ('5445005936953424165', '🗑'), 'quote_store': ('5444987348334965906', '✅')}[action]
    if action == 'quote_option' and button.get('style') in ('success', 'danger'):
        return ('5206607081334906820', '✅') if button['style'] == 'success' else ('5121063440311386962', '👎')
    if kind == 'req':
        if action in ('req_run', 'req_confirm'):
            return ('5444987348334965906', '✅') if payload.get('approve') else ('5445005936953424165', '🗑')
        if action == 'req_amount':
            return ('5879841310902324730', '✏️')
    if action in ('close', 'stop') and kind in ('gcfg', 'tkick'):
        return ('5121063440311386962', '👎')
    if action in ('name_input', 'name_open', 'panic_joins'):
        return ('5188678912883827293', '🤖')
    if action in ('name_value', 'name_delete'):
        return ('5879841310902324730', '✏️')
    if action in ('timezone', 'timezone_input', 'panic_window', 'panic_slow', 'date', 'hours', 'minutes', 'date_input'):
        return ('5870921681735781843', '⏱')
    if action in ('bulk_confirm', 'bulk_run'):
        return ('5121063440311386962', '👎')
    if action in icons:
        return icons[action]
    if _native_input(action):
        return ('5258331647358540449', '✍️')
    return ('5258096772776991776', '⚙️')

def _button_appearance(button, state, payload=None):
    button = dict(button)
    icon = _native_button_icon(button, state, payload)
    if icon:
        label = _native_button_text(str(button.get('text') or ' '))
        button['text'] = label
        if state.get('emoji_disabled'):
            button.pop('icon_custom_emoji_id', None)
            button['text'] = icon[1] + ' ' + label
        else:
            button['icon_custom_emoji_id'] = icon[0]
    return button

def _native_button_text(text):
    return re.sub(r'^[\U0001F000-\U0001FAFF\u2300-\u23FF\u2600-\u27FF\u2B00-\u2BFF\uFE0F\u200D]+\s*', '', text).strip() or text

def _native_screen(ctx, state):
    with _LOCK:
        view = state.get('native_view') or dict(text='<b>GodChat</b>', buttons=[])
        text, rows = view['text'], [list(row) for row in view['buttons']]
    if state.get('queued') or state.get('busy') or state.get('native_job_active'):
        rows.append([dict(text=_l('native_refresh'), _native_action=dict(token=state['token'], action='native_refresh'))])
    ordinary, html_rows = [], []
    rich = _rich(ctx)
    for row in rows:
        ordinary_row, rich_row, keyboard_row = [], [], []
        for button in row:
            label = str(button.get('text') or ' ')
            icon = _native_button_icon(button, state)
            if icon:
                label = _native_button_text(label)
            payload = button.get('_native_action')
            if payload:
                spec = _native_descriptor(payload, label, button.get('style'))
                ordinary_row.append(dict(text=label, **spec, **({'style': button['style']} if button.get('style') else {})))
                data = base64.urlsafe_b64encode(json.dumps(spec, ensure_ascii=False, separators=(',', ':')).encode()).decode('ascii').rstrip('=')
                attrs = ' type="switch_inline_query_current_chat"' if spec['k'] == 'input' else ' type="callback_data"'
                attrs += ' data-hs="' + data + '"'
            elif button.get('url'):
                ordinary_row.append({key: value for key, value in button.items() if not key.startswith('_')})
                attrs = ' type="url" url="' + _esc(button['url']) + '"'
            elif button.get('copy_text') is not None:
                value = button['copy_text']
                value = value.get('text', '') if isinstance(value, dict) else value
                ordinary_row.append(dict(text=label, copy_text=str(value)))
                attrs = ' type="copy_text" text="' + _esc(value) + '"'
            else:
                continue
            if button.get('style'):
                attrs += ' style="' + _esc(button['style']) + '"'
            ordinary_row[-1]['text'] = label
            rendered_label = _esc(label)
            if icon:
                if state.get('emoji_disabled'):
                    ordinary_row[-1]['text'] = icon[1] + ' ' + label
                    rendered_label = _esc(icon[1]) + ' ' + rendered_label
                else:
                    ordinary_row[-1]['icon_custom_emoji_id'] = icon[0]
                    rendered_label = '<tg-emoji emoji-id="' + icon[0] + '">' + icon[1] + '</tg-emoji> ' + rendered_label
            if (not payload or not _native_input(payload['action'])) and not button.get('_quote_keyboard'):
                rich_row.append('<tg-button' + attrs + '>' + rendered_label + '</tg-button>')
            if ordinary_row[-1].get('k') == 'input' or button.get('_quote_keyboard'):
                keyboard_row.append(ordinary_row[-1])
        if ordinary_row:
            visible = keyboard_row if rich else ordinary_row
            if visible:
                ordinary.append(visible)
        if rich_row:
            html_rows.append('<tg-button-row>' + ''.join(rich_row) + '</tg-button-row>')
    screen = ctx.screens.screen(text + ''.join(html_rows) if rich else text, ordinary, rich=rich)
    return _without_custom_emoji(screen) if state.get('emoji_disabled') else screen

class _NativeCallback:
    def __init__(self, ctx, nav, state):
        self.ctx, self.nav, self.state = ctx, nav, state
        self.from_id = nav.actor
        self.value = nav.value
        self.deleted = False

    async def edit(self, text, reply_markup=None, **kwargs):
        _native_view(self.state, text, reply_markup or [])

    async def respond(self, text='', alert=False):
        if text:
            await self.nav.answer(str(text), alert=alert)

    async def delete(self):
        message = self.state.get('native_message')
        if message:
            await _delete(self.ctx, self.state['chat'], [message])
        self.deleted = True

@_localized
async def screen_action(ctx, nav):
    try:
        state = _get(nav.arg('token'), nav.actor)
    except GodChatError as exc:
        await nav.answer(str(exc), alert=True)
        return None
    if not isinstance(getattr(ctx, 'chat_id', None), int):
        ctx.chat_id = state['chat']
    if not isinstance(getattr(ctx, 'message_id', None), int):
        ctx.message_id = state.get('native_message')
    if getattr(ctx, 'topic_id', None) is None:
        ctx.topic_id = state.get('topic')
    if isinstance(getattr(ctx, 'message_id', None), int):
        state['native_message'] = ctx.message_id
    callback = _NativeCallback(ctx, nav, state)
    action = nav.arg('action')
    try:
        if action == 'native_refresh':
            state['native_dirty'] = False
            return _native_screen(ctx, state)
        if state.get('queued') and action not in ('close', 'stop'):
            raise GodChatError(_l('m377'))
        await _callback(ctx, callback, state, dict(nav.args))
    except asyncio.CancelledError:
        raise
    except Exception as exc:
        hint = _input_hint(action)
        detail = str(exc)[:60] + '\n' + hint if hint else str(exc)
        await nav.answer(detail[:180], alert=True)
    return None if callback.deleted else _native_screen(ctx, state)

@_localized
async def screen_input(ctx, nav):
    return await screen_action(ctx, nav)

def _native_refresh_data(message, label):
    def plain(value):
        if isinstance(value, str):
            return value
        if isinstance(value, list):
            return ''.join(plain(item) for item in value)
        if isinstance(value, dict):
            return plain(value.get('text', value.get('texts', '')))
        return ''
    def walk(value):
        if isinstance(value, dict):
            kind = value.get('type') or {}
            matches = _native_button_text(plain(value.get('text'))) == _native_button_text(label)
            if value.get('_') in ('pageButton', 'textButton') and kind.get('_') == 'inlineButtonTypeCallback' and matches:
                return kind.get('data')
            if value.get('_') in ('keyboardButton', 'keyboardButtonCallback') and matches:
                if value.get('_') == 'keyboardButtonCallback':
                    return value.get('data')
                if kind.get('_') == 'inlineButtonTypeCallback':
                    return kind.get('data')
            for item in value.values():
                data = walk(item)
                if data is not None:
                    return data
        elif isinstance(value, list):
            for item in value:
                data = walk(item)
                if data is not None:
                    return data
        return None
    return walk([message.get('rich_message') or message.get('richMessage') or {}, message.get('reply_markup') or {}])

async def _native_refresh(ctx, state, force=False):
    if not state.get('native_message') or not state.get('native_dirty'):
        return
    now = time.monotonic()
    if not force and now - state.get('native_refresh_at', 0) < 5:
        return
    state['native_refresh_at'] = now
    try:
        if state['actor'] != _id(await _me(ctx)):
            return
        chat, mid = state['chat'], state['native_message']
        args = {'id': [{'_': 'inputMessageID', 'id': mid}]}
        if chat < -1000000000000:
            args['channel'] = await _input(ctx, chat, 'channel')
        result = await _rpc(ctx, 'channels.getMessages' if chat < -1000000000000 else 'messages.getMessages', args, retry=False)
        message = next((message for message in _rows(result, 'messages') if message.get('id') == mid), None)
        data = _native_refresh_data(message or {}, _l('native_refresh'))
        if data is None:
            return
        await _rpc(ctx, 'messages.getBotCallbackAnswer', dict(peer=await _input(ctx, chat), msg_id=mid, data=data), retry=False)
    except Exception as exc:
        if not state.get('native_refresh_warned'):
            state['native_refresh_warned'] = True
            await ctx.cap('logs', dict(op='write', level='warning', msg='GodChat: automatic screen refresh unavailable; manual refresh remains active', detail=str(exc)[:200]))

@_localized
async def task_ui_jobs(ctx):
    with _LOCK:
        pending = next((item for item in _NATIVE_JOBS.values() if not item['running']), None)
        if pending is None:
            return
        pending['running'] = True
    state, job_ctx = pending['state'], pending['ctx']
    locale = _LOCALE.set(job_ctx)
    executing = _NATIVE_EXECUTING.set(True)
    callback = _SavedForm(job_ctx, state)
    try:
        if _SESSIONS.get(state['token']) is not state:
            return
        state['queued'] = False
        if state.get('cancelled'):
            await callback.edit(_table(job_ctx, _l('m373'), [(_l('m064'), _l('m269'))]), reply_markup=[[_button(job_ctx, _l('m081'), state, 'close', 'danger')]])
        else:
            await _run_job(job_ctx, callback, state, pending['handler'], *pending['args'])
    except asyncio.CancelledError:
        state['cancelled'] = True
        raise
    except Exception as exc:
        await callback.edit(_table(job_ctx, _l('m007'), [(_l('m053'), _esc(str(exc)[:240]))]), reply_markup=[[_button(job_ctx, _l('m081'), state, 'close', 'danger')]])
    finally:
        state['queued'] = False
        state['busy'] = False
        state['native_job_active'] = False
        state['touched'] = time.time()
        state['native_dirty'] = True
        with _LOCK:
            _NATIVE_JOBS.pop(state['token'], None)
        await _native_refresh(job_ctx, state, force=True)
        _NATIVE_EXECUTING.reset(executing)
        _LOCALE.reset(locale)

async def _fail(ctx, exc):
    detail = str(exc) if isinstance(exc, GodChatError) else f"{_l('m051')}{_wait(exc)}{_l('m052')}" if _wait(exc) else str(exc)[:240]
    await _answer(ctx, _l('m007'), [(_l('m053'), _esc(detail))])

def _command(handler):

    async def wrapped(ctx, invocation):
        try:
            return await handler(ctx, invocation)
        except asyncio.CancelledError:
            raise
        except Exception as exc:
            await _fail(ctx, exc)
    return _localized(wrapped)

@_command
async def command_id(ctx, invocation):
    reply = await ctx.reply()
    sender = _sender(reply) or (_id(await _me(ctx)) if reply.get('out') else None) if isinstance(reply, dict) else None
    entity = await _resolve(ctx, invocation.args[0] if invocation.args else sender if sender is not None else ctx.chat_id)
    rows = [(_l('m054'), _label(ctx, entity)), (_l('m055'), _l('m056') if _id(entity) > 0 else _l('m003') if entity.get('broadcast') else _l('m057')), ('Telegram ID', f'<code>{_id(entity)}</code>')]
    if _username(entity):
        rows.insert(1, ('Username', '@' + _esc(_username(entity))))
    await _emit(ctx.respond, _table(ctx, 'ID', rows), parse_mode='HTML', rich=_rich(ctx), output='reply', reply_to=reply.get('id') if isinstance(reply, dict) else None)

async def _restrict(ctx, chat, entity, rights):
    if chat >= -1000000000000:
        raise GodChatError(_l('m058'))
    await _rpc(ctx, 'channels.editBanned', {'channel': await _input(ctx, chat, 'channel'), 'participant': await _input(ctx, entity), 'banned_rights': dict(rights, _='chatBannedRights')}, retry=False)

async def _kick(ctx, chat, entity):
    if chat >= -1000000000000:
        return await _rpc(ctx, 'messages.deleteChatUser', {'chat_id': -chat, 'user_id': await _input(ctx, entity, 'user')})
    permissions = await _permissions(ctx, chat, entity)
    before = copy.deepcopy(permissions.get('participant', {}).get('banned_rights') or {'_': 'chatBannedRights', 'until_date': 0})
    key = str(chat) + ':' + str(_id(entity))
    pulse = ctx.state.get('pulses', {}).get(key)
    if pulse:
        before = pulse['before']
    previous_kick = ctx.state.get('kicks', {}).get(key)
    if previous_kick:
        before = previous_kick['before']
    applied = dict(before, view_messages=True, until_date=int(time.time()) + 60)
    pending = dict(chat=chat, entity=await _input(ctx, entity), before=before, applied=applied, restore=time.time() + 2, token=secrets.token_hex(8))
    _save(ctx, 'kicks', key, pending)
    await _restrict(ctx, chat, pending['entity'], applied)
    await _restrict(ctx, chat, pending['entity'], before)
    _save(ctx, 'kicks', key, None)

async def _delete(ctx, chat, ids):
    ids = [int(item) for item in ids]
    for start in range(0, len(ids), 100):
        args = {'id': ids[start:start + 100]}
        method = 'messages.deleteMessages'
        if chat < -1000000000000:
            method = 'channels.deleteMessages'
            args['channel'] = await _input(ctx, chat, 'channel')
        else:
            args['revoke'] = True
        await _rpc(ctx, method, args)

async def _history_pace():
    global _HISTORY_AT
    with _LOCK:
        now = time.monotonic()
        slot = max(now, _HISTORY_AT)
        _HISTORY_AT = slot + 1.0
    while True:
        job = _JOB.get()
        if job and job[2].get('cancelled') and not job[2].get('sending'):
            raise _JobStopped(_l('m032'))
        remaining = slot - time.monotonic()
        if remaining <= 0:
            return
        await asyncio.sleep(min(remaining, 0.25))

async def _history(ctx, chat, offset=0, limit=100, before=None):
    await _history_pace()
    result = await _rpc(ctx, 'messages.getHistory', {'peer': await _input(ctx, chat), 'offset_id': offset, 'offset_date': int(before) + 1 if not offset and before is not None else 0, 'add_offset': 0, 'limit': min(limit, 100), 'max_id': 0, 'min_id': 0, 'hash': 0})
    if not isinstance(result, dict) or not isinstance(result.get('messages'), list) or any((not isinstance(item, dict) for item in result['messages'])):
        raise GodChatError(_l('m059'))
    return result['messages']

def _moderation_args(action, words):
    delete_history = action == 'ban' and '-d' in words
    words = [word for word in words if word != '-d'] if delete_history else list(words)
    seconds, consumed = _duration(words) if action in ('ban', 'mute') else (0, 0)
    if seconds > 365 * 86400:
        raise GodChatError(_l('m060'))
    if action in ('unban', 'unmute') and words:
        raise GodChatError(_l('m061'))
    return (seconds, ' '.join(words[consumed:])[:500], delete_history)

async def _members(ctx, chat=None, mode='recent', state=None):
    chat = ctx.chat_id if chat is None else chat
    if chat >= -1000000000000:
        result = await _rpc(ctx, 'messages.getFullChat', {'chat_id': -chat})
        users = {_id(user): user for user in result.get('users', [])}
        participants = result.get('full_chat', {}).get('participants', {}).get('participants', [])
        return [dict(user=users.get(item['user_id'], {'_': 'userEmpty', 'id': item['user_id']}), participant=item) for item in participants if mode != 'admins' or item.get('_') in ('chatParticipantCreator', 'chatParticipantAdmin')]
    found, seen, offset = ([], set(), 0)
    while True:
        if state and state.get('cancelled'):
            break
        filters = {'recent': 'channelParticipantsRecent', 'admins': 'channelParticipantsAdmins', 'banned': 'channelParticipantsKicked'}
        filter_value = {'_': filters[mode]}
        if mode == 'banned':
            filter_value['q'] = ''
        result = await _rpc(ctx, 'channels.getParticipants', {'channel': await _input(ctx, chat, 'channel'), 'filter': filter_value, 'offset': offset, 'limit': 200, 'hash': 0})
        users = {_id(user): user for user in result.get('users', [])}
        page = result.get('participants', [])
        fresh = 0
        for item in page:
            uid = _id(item.get('peer')) or item.get('user_id')
            if uid is not None and uid not in seen:
                seen.add(uid)
                fresh += 1
                found.append(dict(user=users.get(uid, {'_': 'userEmpty', 'id': uid}), participant=item))
        if not page or not fresh:
            break
        offset += len(page)
        if offset >= int(result.get('count', offset + 1)):
            break
    return found

async def _delete_participant_history(ctx, chat, entity):
    args = {'channel': await _input(ctx, chat, 'channel'), 'participant': await _input(ctx, entity)}
    previous = None
    while True:
        result = await _rpc(ctx, 'channels.deleteParticipantHistory', args)
        offset = int(result.get('offset', 0) or 0)
        if not offset:
            return
        if previous is not None and offset >= previous:
            raise GodChatError(_l('m062'))
        previous = offset

async def _moderate(ctx, invocation, action, entity_override=None, words_override=None, quiet=False):
    await _require(ctx)
    if entity_override is None:
        entity, words, reply = await _target(ctx, invocation)
    else:
        entity, words, reply = (entity_override, list(words_override or []), None)
    seconds, reason, delete_history = _moderation_args(action, words)
    if action == 'ban' and '-d' in words:
        await _require(ctx, 'delete_messages')
    if action == 'ban' and _id(entity) != _id(await _me(ctx)):
        try:
            permissions = await _permissions(ctx, user=entity)
        except Exception as exc:
            if 'USER_NOT_PARTICIPANT' not in str(exc).upper():
                raise
            permissions = {}
        if permissions.get('admin') and (not permissions.get('creator')):
            state = _session(ctx, 'admin_ban', user=entity, words=words)
            return await _form(ctx, state, _table(ctx, _l('m071'), [(_l('m063'), _label(ctx, entity)), (_l('m078'), _l('m079'))]), [[_button(ctx, _l('m080'), state, 'admin_ban', 'danger'), _button(ctx, _l('m081'), state, 'close', 'danger')]])
    await _protect(ctx, entity)
    until = int(time.time()) + max(seconds, 30) + 1 if seconds else 0
    chat = ctx.chat_id
    if chat >= -1000000000000:
        if action not in ('ban', 'kick'):
            raise GodChatError(_l('m039'))
        await _rpc(ctx, 'messages.deleteChatUser', {'chat_id': -chat, 'user_id': await _input(ctx, entity, 'user'), 'revoke_history': action == 'ban'})
    else:
        rights = {'until_date': until}
        if action in ('ban', 'kick'):
            rights['view_messages'] = True
        elif action == 'mute':
            rights.update(send_messages=True, send_plain=True)
        if action == 'kick':
            await _kick(ctx, chat, entity)
        else:
            await _restrict(ctx, chat, entity, rights)
    _save(ctx, 'pulses', str(chat) + ':' + str(_id(entity)), None)
    rows = [(_l('m063'), _label(ctx, entity)), (_l('m064'), _ICONS['ok'] + ' ' + {'ban': _l('m072'), 'unban': _l('m073'), 'kick': _l('m074'), 'mute': _l('m075'), 'unmute': _l('m076')}[action])]
    if action in ('ban', 'mute'):
        rows.append((_l('m068'), _duration_label(max(seconds, 30)) if seconds else _l('m009')))
    if reason:
        rows.append((_l('m053'), _esc(reason)))
    if delete_history:
        try:
            if ctx.chat_id < -1000000000000:
                await _delete_participant_history(ctx, ctx.chat_id, entity)
            rows.append((_l('m069'), _l('m070')))
        except Exception:
            rows.append((_l('m069'), _l('m077')))
    title = {'ban': _l('m005'), 'unban': _l('m065'), 'kick': _l('m066'), 'mute': _l('m006'), 'unmute': _l('m067')}[action]
    if quiet:
        return (title, rows)
    await _answer(ctx, title, rows)

@_command
async def command_ban(ctx, invocation):
    await _moderate(ctx, invocation, 'ban')

@_command
async def command_mute(ctx, invocation):
    await _moderate(ctx, invocation, 'mute')

@_command
async def command_unban(ctx, invocation):
    if '-all' in invocation.args:
        await _bulk_menu(ctx, 'unban')
    else:
        await _moderate(ctx, invocation, 'unban')

@_command
async def command_kick(ctx, invocation):
    if list(invocation.args) == ['-d']:
        await _bulk_menu(ctx, 'kick', deleted=True)
    elif '-all' in invocation.args:
        await _bulk_menu(ctx, 'kick')
    else:
        await _moderate(ctx, invocation, 'kick')

@_command
async def command_unmute(ctx, invocation):
    if ctx.chat_id > 0:
        entity = await _resolve(ctx, ctx.chat_id)
        if invocation.args:
            raise GodChatError(_l('m082'))
        _save(ctx, 'delete_mutes', str(ctx.chat_id) + ':' + str(_id(entity)), None)
        await _answer(ctx, _l('m067'), [(_l('m063'), _label(ctx, entity)), (_l('m064'), _l('m084'))])
    else:
        entity, words, _ = await _target(ctx, invocation)
        if words:
            raise GodChatError(_l('m083'))
        key = str(ctx.chat_id) + ':' + str(_id(entity))
        removed = bool(ctx.state.get('delete_mutes', {}).get(key))
        permissions = await _permissions(ctx)
        if removed:
            _save(ctx, 'delete_mutes', key, None)
        if removed and (not permissions.get('ban_users') or ctx.chat_id >= -1000000000000):
            return await _answer(ctx, _l('m067'), [(_l('m063'), _label(ctx, entity)), (_l('m064'), _l('m084'))])
        await _moderate(ctx, invocation, 'unmute')

@_command
async def command_dmute(ctx, invocation):
    if ctx.chat_id < 0:
        await _require(ctx, 'delete_messages')
    if ctx.chat_id > 0:
        entity, words = (await _resolve(ctx, ctx.chat_id), list(invocation.args))
    else:
        entity, words, _ = await _target(ctx, invocation)
    await _protect(ctx, entity)
    key = str(ctx.chat_id) + ':' + str(_id(entity))
    previous = ctx.state.get('delete_mutes', {}).get(key)
    seconds, consumed = _duration(words)
    if len(words) != consumed:
        raise GodChatError(_l('m085'))
    _save(ctx, 'delete_mutes', key, None if previous else {'chat': ctx.chat_id, 'user': _id(entity), 'until': time.time() + seconds if seconds else 0})
    await _answer(ctx, _l('m086'), [(_l('m063'), _label(ctx, entity)), (_l('m064'), _l('m087') if previous else _l('m088')), (_l('m068'), '—' if previous else str(seconds) + _l('m089') if seconds else _l('m009'))])

@_command
async def command_del(ctx, invocation):
    if invocation.args:
        entity, words, _ = await _target(ctx, invocation)
        if len(words) != 1 or (words[0] != '-all' and (not words[0].isdigit() or int(words[0]) <= 0)):
            raise GodChatError(_l('m091'))
        if ctx.chat_id < 0:
            await _require(ctx, 'delete_messages')
        maximum = None if words[0] == '-all' else int(words[0])
        found, offset = ([], ctx.message_id)
        while maximum is None or len(found) < maximum:
            page = await _history(ctx, ctx.chat_id, offset)
            valid = [int(item['id']) for item in page if item.get('id') and item['id'] < offset]
            if not valid:
                break
            for item in page:
                sender = _sender(item)
                if sender is None and item.get('out'):
                    sender = _id(await _me(ctx))
                if sender == _id(entity) and item.get('id') in valid:
                    if _in_topic(item, getattr(ctx, 'topic_id', None)):
                        found.append(item['id'])
                        if maximum is not None and len(found) >= maximum:
                            break
            offset = min(valid)
        await _delete(ctx, ctx.chat_id, found)
        return await _answer(ctx, _l('m092'), [(_l('m063'), _label(ctx, entity)), (_l('m093'), str(len(found)))])
    reply = await ctx.reply()
    if not isinstance(reply, dict):
        raise GodChatError(_l('m090'))
    if ctx.chat_id < 0:
        await _require(ctx, 'delete_messages')
    await _delete(ctx, ctx.chat_id, [reply['id'], ctx.message_id])

@_command
async def command_purge(ctx, invocation):
    reply = await ctx.reply()
    if not isinstance(reply, dict):
        raise GodChatError(_l('m094'))
    if ctx.chat_id < 0:
        await _require(ctx, 'delete_messages')
    state = _session(ctx, 'purge', first=int(reply['id']), last=int(ctx.message_id))
    if state['first'] > state['last']:
        raise GodChatError(_l('m095'))
    await _form(ctx, state, _table(ctx, _l('m096'), [(_l('m097'), f"{state['first']}–{state['last']}")]), [[_button(ctx, _l('m098'), state, 'purge_run', 'danger'), _button(ctx, _l('m081'), state, 'close', 'danger')]])

async def _send(ctx, chat, text, rich=None):
    args = {'peer': await _input(ctx, chat), 'random_id': secrets.randbits(63)}
    if _rich(ctx) if rich is None else rich:
        args.update(message='', rich_message={'_': 'inputRichMessageHTML', 'html': text})
    else:
        prepared = await ctx._ctx_prepare(text, 'HTML', None)
        args.update(prepared)
    return await _rpc(ctx, 'messages.sendMessage', args)


async def _download(ctx, message, limit=24 * 1024 * 1024):
    media = message.get('media') or {}
    document = media.get('document')
    photo = media.get('photo')
    if document:
        if int(document.get('size', 0)) > limit:
            raise GodChatError(_l('m099'))
        location = {'_': 'inputDocumentFileLocation', **{key: document[key] for key in ('id', 'access_hash', 'file_reference')}, 'thumb_size': ''}
    elif photo:
        sizes = [item for item in photo.get('sizes', []) if item.get('type')]
        if not sizes:
            raise GodChatError(_l('m102'))
        largest = max(sizes, key=lambda item: item.get('w', 0) * item.get('h', 0))
        location = {'_': 'inputPhotoFileLocation', **{key: photo[key] for key in ('id', 'access_hash', 'file_reference')}, 'thumb_size': largest['type']}
    else:
        raise GodChatError(_l('m100'))
    data = bytearray()
    while len(data) <= limit:
        result = await _rpc(ctx, 'upload.getFile', {'location': location, 'offset': len(data), 'limit': 512 * 1024})
        chunk = result.get('bytes') if isinstance(result, dict) else None
        if not isinstance(chunk, bytes):
            raise GodChatError(_l('m101'))
        data.extend(chunk)
        if len(data) > limit:
            raise GodChatError(_l('m099'))
        if len(chunk) < 512 * 1024:
            if not data:
                raise GodChatError(_l('m103'))
            return bytes(data)
    raise GodChatError(_l('m099'))

async def _chat_settings(ctx, chat=None):
    chat = ctx.chat_id if chat is None else chat
    if chat < -1000000000000:
        result = await _rpc(ctx, 'channels.getFullChannel', {'channel': await _input(ctx, chat, 'channel')})
        entity = next((item for item in result.get('chats', []) if _id(item) == chat), await _resolve(ctx, chat))
        full = result.get('full_chat', {})
    else:
        result = await _rpc(ctx, 'messages.getFullChat', {'chat_id': -chat})
        entity = next((item for item in result.get('chats', []) if _id(item) == chat), await _resolve(ctx, chat))
        full = result.get('full_chat', {})
    rights = dict(entity.get('default_banned_rights') or {'_': 'chatBannedRights', 'until_date': 0})
    return dict(rights=rights, slow=int(full.get('slowmode_seconds') or 0), requests=bool(entity.get('join_request')), full=full, entity=entity)

async def _not_modified(ctx, method, args):
    try:
        return await _rpc(ctx, method, args)
    except Exception as exc:
        if 'NOT_MODIFIED' not in str(exc).upper() and "WASN'T MODIFIED" not in str(exc).upper():
            raise

async def _defaults(ctx, chat, rights):
    await _not_modified(ctx, 'messages.editChatDefaultBannedRights', {'peer': await _input(ctx, chat), 'banned_rights': dict(rights, _='chatBannedRights')})

def _serialize_chat(handler):

    async def wrapped(ctx, chat, *args, **kwargs):
        with _LOCK:
            lock = _CHAT_LOCKS.setdefault(chat, threading.Lock())
        if not lock.acquire(blocking=False):
            raise GodChatError(_l('m104'))
        try:
            return await handler(ctx, chat, *args, **kwargs)
        finally:
            lock.release()
    return wrapped

@_serialize_chat
async def _toggle_control(ctx, chat, kind, seconds=0, callback=None):
    await _require(ctx, 'ban_users', chat)
    saved = _setting(ctx, 'controls', chat)
    if saved and saved.get('pending'):
        if saved['pending'] != kind:
            raise GodChatError(_l('m105'))
        state = saved
    else:
        fresh = await _chat_settings(ctx, chat) if not saved else None
        state = copy.deepcopy(saved) if saved else {'base': {key: fresh[key] for key in ('rights', 'slow', 'requests')}, 'banchat': False, 'panic': False}
        state['target'] = {'banchat': state.get('banchat', False), 'panic': state.get('panic', False)}
        state['target'][kind] = not state.get(kind, False)
        state['pending'] = kind
        if kind == 'panic' and state['target'][kind]:
            state['panic_options'] = copy.deepcopy(_setting(ctx, 'panic_settings', chat) or {'close': True, 'slow': 3600, 'requests': True})
        if kind == 'banchat':
            state['until'] = time.time() + seconds if state['target'][kind] and seconds else 0
        _save(ctx, 'controls', chat, state)
    target = state['target']
    options = state.get('panic_options') or _setting(ctx, 'panic_settings', chat) or {'close': True, 'slow': 3600, 'requests': True, 'auto': False, 'joins': 5, 'window': 10}
    rights = copy.deepcopy(state['base']['rights'])
    if target['banchat'] or (target['panic'] and options.get('close', True)):
        rights.update(send_messages=True, send_plain=True)
    await _defaults(ctx, chat, rights)
    if chat < -1000000000000 and kind == 'panic':
        current = await _chat_settings(ctx, chat)
        slow = int(options['slow']) if target['panic'] and options.get('slow') else state['base']['slow']
        requests = True if target['panic'] and options.get('requests', True) else state['base']['requests']
        if slow != current['slow']:
            await _not_modified(ctx, 'channels.toggleSlowMode', {'channel': await _input(ctx, chat, 'channel'), 'seconds': slow})
        if requests != current['requests']:
            await _not_modified(ctx, 'channels.toggleJoinRequest', {'channel': await _input(ctx, chat, 'channel'), 'enabled': requests})
    state.update(target)
    state.pop('pending', None)
    state.pop('target', None)
    _save(ctx, 'controls', chat, state if state['banchat'] or state['panic'] else None)
    enabled = state[kind]
    return enabled

@_command
async def command_banchat(ctx, invocation):
    seconds, consumed = _duration(list(invocation.args))
    if consumed != len(invocation.args):
        raise GodChatError(_l('m106'))
    enabled = await _toggle_control(ctx, ctx.chat_id, 'banchat', seconds)
    await _answer(ctx, _l('m057'), [(_l('m064'), _l('m107') if enabled else _l('m108')), (_l('m068'), str(seconds) + _l('m089') if enabled and seconds else _l('m109') if enabled else '—')])

@_command
async def command_panic(ctx, invocation):
    if invocation.args:
        raise GodChatError(_l('m110'))
    enabled = await _toggle_control(ctx, ctx.chat_id, 'panic')
    settings = await _chat_settings(ctx)
    await _answer(ctx, _l('m111'), [(_l('m064'), _ICONS['error' if enabled else 'ok'] + (_l('m116') if enabled else _l('m117'))), (_l('m057'), _l('m107') if settings['rights'].get('send_messages') else _l('m108')), (_l('m112'), str(settings['slow']) + _l('m089')), (_l('m113'), _l('m114') if settings['requests'] else _l('m115'))])

@_command
async def command_nochan(ctx, invocation):
    if invocation.args:
        raise GodChatError(_l('m118'))
    await _require(ctx, 'delete_messages')
    value = not bool(_setting(ctx, 'channel_blocks'))
    _save(ctx, 'channel_blocks', ctx.chat_id, True if value else None)
    await _answer(ctx, _l('m119'), [(_l('m064'), _l('m120') if value else _l('m121'))])

@_command
async def command_guest(ctx, invocation):
    if invocation.args:
        raise GodChatError(_l('m118'))
    if ctx.chat_id < 0:
        await _require(ctx, 'delete_messages')
    value = not bool(_setting(ctx, 'guest_blocks'))
    _save(ctx, 'guest_blocks', ctx.chat_id, True if value else None)
    await _answer(ctx, _l('m122'), [(_l('m064'), _l('m120') if value else _l('m121'))])

async def _member_inline(ctx, entity, value=None):
    await _require(ctx, 'ban_users')
    if ctx.chat_id >= -1000000000000:
        raise GodChatError(_l('m123'))
    await _protect(ctx, entity)
    permissions = await _permissions(ctx, user=entity)
    rights = dict(permissions.get('participant', {}).get('banned_rights') or {})
    current = bool(rights.get('send_inline'))
    if value is None:
        value = not current
    if not value and (await _chat_settings(ctx))['rights'].get('send_inline'):
        raise GodChatError(_l('m124'))
    rights.update(send_inline=value)
    rights.setdefault('until_date', 0)
    await _not_modified(ctx, 'channels.editBanned', {'channel': await _input(ctx, ctx.chat_id, 'channel'), 'participant': await _input(ctx, entity), 'banned_rights': {'_': 'chatBannedRights', **rights}})
    _save(ctx, 'inline_blocks', str(ctx.chat_id) + ':' + str(_id(entity)), None)
    return value

@_command
async def command_inline(ctx, invocation):
    words = list(invocation.args)
    if '-all' in words:
        if words != ['-all']:
            raise GodChatError(_l('m126'))
        await _require(ctx, 'ban_users')
        target_value = None
        while True:
            try:
                settings = await _chat_settings(ctx)
                if target_value is None:
                    target_value = not bool(settings['rights'].get('send_inline'))
                rights = dict(settings['rights'], send_inline=target_value)
                await _defaults(ctx, ctx.chat_id, rights)
                value = target_value
                break
            except Exception as exc:
                seconds = _wait(exc)
                if not seconds:
                    raise
                await _answer(ctx, _l('m125'), [(_l('m031'), f"{seconds}{_l('m089')}")])
                await asyncio.sleep(seconds + 1)
    else:
        if ctx.chat_id < 0:
            entity, rest, _ = await _target(ctx, invocation)
            if rest:
                raise GodChatError(_l('m083'))
            value = await _member_inline(ctx, entity)
            return await _answer(ctx, _l('m125'), [(_l('m128'), _l('m120') if value else _l('m121'))])
        else:
            if words:
                raise GodChatError(_l('m127'))
            uid = ctx.chat_id
        key = str(ctx.chat_id) + ':' + str(uid)
        value = not bool(ctx.state.get('inline_blocks', {}).get(key))
        _save(ctx, 'inline_blocks', key, True if value else None)
    await _answer(ctx, _l('m125'), [(_l('m128'), _l('m120') if value else _l('m121'))])

@_command
async def command_pref(ctx, invocation):
    entity, words, _ = await _target(ctx, invocation)
    await _set_prefix(ctx, entity, words)

async def _set_prefix(ctx, entity, words, quiet=False):
    await _require(ctx, 'admin')
    admin = '-a' in words
    if words.count('-a') > 1:
        raise GodChatError(_l('m129'))
    if admin:
        await _require(ctx, 'add_admins')
    rank = ' '.join((word for word in words if word != '-a')).strip()
    if rank in ('-', 'clear', 'снять'):
        rank = ''
    if len(rank) > 16 or any((ord(char) < 32 for char in rank)):
        raise GodChatError(_l('m131'))
    current = await _permissions(ctx, user=entity)
    if not admin and current.get('admin'):
        await _require(ctx, 'add_admins')
    if admin:
        if ctx.chat_id >= -1000000000000:
            raise GodChatError(_l('m132'))
        rights = current.get('participant', {}).get('admin_rights')
        if current.get('creator'):
            await _rpc(ctx, 'messages.editChatParticipantRank', {'peer': await _input(ctx, ctx.chat_id), 'participant': await _input(ctx, entity), 'rank': rank})
        else:
            await _rpc(ctx, 'channels.editAdmin', {'channel': await _input(ctx, ctx.chat_id, 'channel'), 'user_id': await _input(ctx, entity, 'user'), 'admin_rights': rights or {'_': 'chatAdminRights', 'other': True}, 'rank': rank})
    else:
        if current.get('creator'):
            raise GodChatError(_l('m133'))
        await _rpc(ctx, 'messages.editChatParticipantRank', {'peer': await _input(ctx, ctx.chat_id), 'participant': await _input(ctx, entity), 'rank': rank})
        if current.get('admin'):
            await _demote(ctx, entity, rank)
    if not quiet:
        await _answer(ctx, _l('m134') if admin else _l('m135'), [(_l('m063'), _label(ctx, entity)), (_l('m135'), _esc(rank) or _l('m136')), (_l('m064'), _ICONS['ok'] + _l('m137'))])

async def _demote(ctx, entity, rank=''):
    if ctx.chat_id < -1000000000000:
        await _rpc(ctx, 'channels.editAdmin', {'channel': await _input(ctx, ctx.chat_id, 'channel'), 'user_id': await _input(ctx, entity, 'user'), 'admin_rights': {'_': 'chatAdminRights'}, 'rank': rank})
    else:
        await _rpc(ctx, 'messages.editChatAdmin', {'chat_id': -ctx.chat_id, 'user_id': await _input(ctx, entity, 'user'), 'is_admin': False})

@_command
async def command_aclear(ctx, invocation):
    await _require(ctx, 'add_admins')
    if invocation.args:
        raise GodChatError(_l('m118'))
    state = _session(ctx, 'aclear')
    await _form(ctx, state, _table(ctx, _l('m138'), [(_l('m078'), _l('m139'))]), [[_button(ctx, _l('m140'), state, 'aclear_run', 'danger'), _button(ctx, _l('m081'), state, 'close', 'danger')]])

def _media_keys(message):
    media = message.get('media') or {}
    document = media.get('document') or {}
    photo = media.get('photo') or {}
    keys = []
    if document.get('id'):
        keys.append('document:' + str(document['id']))
    if photo.get('id'):
        keys.append('photo:' + str(photo['id']))
    for attr in document.get('attributes', []):
        if attr.get('_') in ('documentAttributeSticker', 'documentAttributeCustomEmoji'):
            pack = attr.get('stickerset') or {}
            if pack.get('id'):
                keys.append('pack:' + str(pack['id']))
    return keys

async def _media_checkpoint(ctx, op, stage, **detail):
    await ctx.cap('logs', {'op': 'write', 'level': 'info', 'msg': f'GodChat banmedia op={op} stage={stage}', 'detail': json.dumps(detail, ensure_ascii=False)[:500]})

async def _banmedia(ctx, invocation, remove):
    op = secrets.token_hex(4)
    if ctx.chat_id < 0:
        await _require(ctx, 'delete_messages')
    flags = list(invocation.args)
    if any((item not in ('-p', '-g', '-all') for item in flags)) or len(set(flags)) != len(flags):
        raise GodChatError(_l('m143'))
    scope = 'global' if '-g' in flags else str(ctx.chat_id)
    rules = list(_setting(ctx, 'media_bans', scope) or [])
    entries = list(_setting(ctx, 'media_entries', scope) or [])
    if '-all' in flags:
        if not remove:
            raise GodChatError(_l('m146'))
        _save(ctx, 'media_bans', scope, None)
        _save(ctx, 'media_visual', scope, None)
        _save(ctx, 'media_entries', scope, None)
        return await _answer(ctx, _l('m145'), [(_l('m064'), _l('m149'))])
    reply = await ctx.reply()
    if not isinstance(reply, dict) or not reply.get('media'):
        raise GodChatError(_l('m144'))
    keys = _media_keys(reply)
    sticker = any((attr.get('_') == 'documentAttributeSticker' for attr in ((reply.get('media') or {}).get('document') or {}).get('attributes', [])))
    primary = [key for key in keys if key.startswith('pack:')] if '-p' in flags else [key for key in keys if not key.startswith('pack:')]
    if sticker and primary and all((key in rules for key in primary)) and (not remove):
        remove = True
    if '-p' in flags:
        keys = [key for key in keys if key.startswith('pack:')]
        if not keys:
            raise GodChatError(_l('m147'))
    else:
        keys = [key for key in keys if not key.startswith('pack:')]
        await _media_checkpoint(ctx, op, 'download', remove=remove, media_type=(reply.get('media') or {}).get('_'))
        data = await _download(ctx, reply)
        await _media_checkpoint(ctx, op, 'downloaded', size=len(data))
        digest = hashlib.sha256(data).hexdigest()
        keys.append('sha256:' + digest)
        records = list(_setting(ctx, 'media_visual', scope) or [])
        if remove:
            removed = {digest}
            for entry in entries:
                if entry['sha256'] in removed:
                    keys.extend(entry['keys'])
            entries = [entry for entry in entries if entry['sha256'] not in removed]
            records = [record for record in records if record['sha256'] not in removed]
        if not remove:
            existing = next((entry for entry in entries if entry['sha256'] == digest), None)
            if existing:
                existing['keys'] = list(dict.fromkeys(existing['keys'] + keys))
            else:
                entries.append(dict(sha256=digest, keys=list(keys)))
        _save(ctx, 'media_entries', scope, entries or None)
        _save(ctx, 'media_visual', scope, records or None)
    if remove:
        rules = [rule for rule in rules if rule not in keys]
    else:
        rules = list(dict.fromkeys(rules + keys))
    _save(ctx, 'media_bans', scope, rules or None)
    await _media_checkpoint(ctx, op, 'saved', rules=len(rules))
    await _answer(ctx, _l('m145'), [(_l('m064'), _l('m150') if remove else _l('m151')), (_l('m148'), _l('m152') if scope == 'global' else _l('m153'))])

@_command
async def command_banmedia(ctx, invocation):
    await _banmedia(ctx, invocation, False)

@_command
async def command_unbanmedia(ctx, invocation):
    await _banmedia(ctx, invocation, True)


def _range_text(ctx, state):
    fmt = lambda value, default: datetime.fromtimestamp(value, _tz(ctx)).strftime('%d.%m.%y %H:%M') if value is not None else default
    return f"{_l('m156')}{fmt(state.get('since'), _l('m158'))}{_l('m157')}{fmt(state.get('until'), _l('m159'))}"


def _text(ctx, message):
    if message.get('_') == 'messageService':
        return ''
    if message.get('rich_message') or message.get('richMessage'):
        converter = getattr(ctx.tools, 'message_text', None)
        if converter is None:
            raise GodChatError(_l('m190'))
        return str(converter(message) or '')
    return str(message.get('message') or message.get('text') or '')


@_command
async def command_member(ctx, invocation):
    if len(invocation.args) > 1:
        raise GodChatError(_l('m215'))
    try:
        entity = await _resolve(ctx, invocation.args[0]) if invocation.args else (await _target(ctx, invocation, True))[0]
    except Exception:
        if len(invocation.args) != 1 or not invocation.args[0].isdigit() or int(invocation.args[0]) <= 0:
            raise
        uid = int(invocation.args[0])
        entity = None
        try:
            result = await _rpc(ctx, 'users.getUsers', {'id': [{'_': 'inputUser', 'user_id': uid, 'access_hash': 0}]}, retry=False)
            entity = next((user for user in _rows(result, 'users') if user.get('_') == 'user' and _id(user) == uid), None)
        except Exception:
            pass
        entity = entity or {'_': 'userEmpty', 'id': uid}
    state = _session(ctx, 'member', user=entity, activity=None)
    await _member_menu(ctx, state)

@_command
async def command_rmember(ctx, invocation):
    if invocation.args or ctx.chat_id >= 0:
        raise GodChatError(_l('m216'))
    people = await _members(ctx)
    admin_rows = await _members(ctx, mode='admins')
    admin_types = ('channelParticipantAdmin', 'channelParticipantCreator', 'chatParticipantAdmin', 'chatParticipantCreator')
    excluded = {_id(await _me(ctx))} | {_id(item['user']) for item in admin_rows if item['participant'].get('_') in admin_types}
    people = [item for item in people if _id(item['user']) not in excluded and not item['user'].get('bot') and not item['user'].get('deleted') and item['participant'].get('_') not in admin_types]
    if not people:
        raise GodChatError(_l('m217'))
    user = secrets.choice(people)['user']
    state = _session(ctx, 'member', user=user, people=people, seen={_id(user)}, history=[dict(user=user, activity=None)], index=0, activity=None)
    await _member_menu(ctx, state)

def _member_status(permissions):
    participant = permissions.get('participant') or {}
    if (participant.get('banned_rights') or {}).get('view_messages'):
        return 'banned'
    if participant.get('left') or participant.get('_') == 'channelParticipantLeft' or (not participant):
        return 'left'
    return 'member'

def _message_link(ctx, message):
    chat = ctx.chat_id
    if chat < -1000000000000:
        return f"https://t.me/c/{-chat - 1000000000000}/{message['id']}"
    return f"tg://openmessage?user_id={chat}&message_id={message['id']}" if chat > 0 else None

async def _latest_message(ctx, state):
    uid = _id(state['user'])
    cached = state.setdefault('latest', {}).get(str(uid))
    if cached and time.time() - cached['time'] < 60:
        return cached['message']
    args = dict(peer=await _input(ctx, state['chat']), from_id=await _input(ctx, state['user']), q='', filter={'_': 'inputMessagesFilterEmpty'}, min_date=0, max_date=0, offset_id=0, add_offset=0, limit=1, max_id=0, min_id=0, hash=0)
    if getattr(ctx, 'topic_id', None):
        args['top_msg_id'] = ctx.topic_id
    result = await _rpc(ctx, 'messages.search', args, retry=False)
    messages = _rows(result, 'messages')
    message = next((item for item in messages if item.get('_') not in ('messageEmpty', 'messageService')), None)
    state['latest'][str(uid)] = dict(time=time.time(), message=message)
    return message

async def _member_menu(ctx, state, callback=None):
    user = state['user']
    uid = _id(user)
    is_channel = uid < 0
    known = user.get('_') not in ('userEmpty', 'channelForbidden', 'chatForbidden')
    rows = [(_l('m003') if is_channel else _l('m063'), _label(ctx, user))]
    note = ''
    participant = None
    permissions, capabilities, status = ({}, {}, 'unknown')
    usernames = list(dict.fromkeys(filter(None, [_username(user)] + [item.get('username') for item in user.get('usernames', []) if isinstance(item, dict) and item.get('active')])))
    if usernames:
        rows.append(('Username', ', '.join((f'<a href="https://t.me/{_esc(value)}">@{_esc(value)}</a>' for value in usernames))))
    if known and ctx.chat_id < 0 and (not is_channel):
        try:
            permissions = await _permissions(ctx, user=user)
            participant = permissions.get('participant')
            status = _member_status(permissions)
            status = state.get('local_status', {}).get(str(uid), status) if status != 'member' else status
            rows.append((_l('m064'), _l('m234') if status == 'banned' else _l('m243') if status in ('left', 'kicked') else _l('m054') if permissions.get('creator') else _l('m249') if permissions.get('admin') else _l('m063')))
        except Exception as exc:
            if 'USER_NOT_PARTICIPANT' in str(exc).upper():
                status = 'left'
                rows.append((_l('m064'), _l('m243')))
            else:
                note = _l('m222')
    if not is_channel:
        common = None
        cached = state.setdefault('common_counts', {}).get(str(uid))
        if known and cached and (time.time() - cached['time'] < 60):
            common = cached['count']
        elif known:
            try:
                result = await _rpc(ctx, 'messages.getCommonChats', {'user_id': await _input(ctx, user, 'user'), 'max_id': 0, 'limit': 1}, retry=False)
                value = result.get('count')
                if value is None and result.get('_') == 'messages.chats' and isinstance(result.get('chats'), list):
                    value = len(result['chats'])
                if isinstance(value, int) and (not isinstance(value, bool)) and (value >= 0):
                    common = value
                    state['common_counts'][str(uid)] = dict(time=time.time(), count=common)
            except Exception:
                pass
        rows.append((_l('m166'), str(common) if common is not None else _l('m223')))
    if known and is_channel:
        rows.append((_l('m055'), _l('m003') if user.get('broadcast') else _l('m224')))
        try:
            full = await _rpc(ctx, 'channels.getFullChannel', {'channel': await _input(ctx, user, 'channel')})
            rows.append((_l('m225'), str(full.get('full_chat', {}).get('participants_count', _l('m223')))))
            about = full.get('full_chat', {}).get('about')
            if about:
                note = '<blockquote>' + _esc(about[:1000]) + '</blockquote>'
        except Exception:
            pass
    if known and ctx.chat_id < 0:
        try:
            capabilities = await _permissions(ctx)
        except Exception:
            capabilities = {}
    state['member_status'] = status
    if participant and status == 'member':
        joined = _date(participant.get('date'))
        if joined:
            rows.append((_l('m226'), datetime.fromtimestamp(joined, _tz(ctx)).strftime('%d.%m.%y %H:%M')))
    activity = state.get('activity')
    latest = None
    if known and (not is_channel) and (status != 'unknown'):
        try:
            latest = await _latest_message(ctx, state)
        except Exception:
            pass
    if latest:
        text = _text(ctx, latest) or _l('m218')
        date = datetime.fromtimestamp(_date(latest.get('date')), _tz(ctx)).strftime('%d.%m.%y %H:%M')
        url = _message_link(ctx, latest)
        label = f'<a href="{_esc(url)}">{date}</a>' if url else date
        note += _l('m235') + label + ' · ' + _esc(text[:700]) + '</blockquote>'
    if known and activity:
        rows.append((_l('m219'), f"{activity['count']}{_l('m236')}{activity['months']}{_l('m237')}" + (_l('m238') if not activity.get('complete', True) else '')))
        if activity.get('last') and (not latest):
            note += '<blockquote>' + _esc(activity['last'][:700]) + '</blockquote>'
    elif known and status != 'unknown' and (not is_channel):
        rows.append((_l('m219'), _l('m227')))
    elif not known:
        note = _l('m220')
    b = lambda label, action, style=None, **kw: _button(ctx, label, state, action, style, **kw)
    buttons = []
    username = _username(user)
    if username:
        buttons.append([ctx.ui.url(_l('m228'), 'https://t.me/' + username)])
    elif known and uid > 0:
        buttons.append([ctx.ui.url(_l('m228'), f'tg://openmessage?user_id={uid}')])
    if known and (not is_channel) and (ctx.chat_id < 0) and (status != 'unknown'):
        own = uid == _id(await _me(ctx))
        moderation = []
        if capabilities.get('ban_users') and (not own) and (not permissions.get('admin')):
            if status == 'banned':
                moderation.append(b(_l('m239'), 'member_unban', 'success'))
            else:
                if status == 'member':
                    moderation.append(b(_l('m244'), 'member_kick', 'danger'))
                moderation.append(b(_l('m240'), 'member_ban', 'danger'))
        if moderation:
            buttons.append(moderation)
        buttons.append([b(_l('m229'), 'activity', 'primary', months=1), b(_l('m230'), 'activity', 'primary', months=3)])
        if status == 'member' and (not own) and (not permissions.get('admin')) and capabilities.get('ban_users') and (ctx.chat_id < -1000000000000):
            blocked = bool((participant.get('banned_rights') or {}).get('send_inline'))
            try:
                blocked = blocked or bool((await _chat_settings(ctx))['rights'].get('send_inline'))
            except Exception:
                pass
            buttons.append([b('🧩 ' + (_l('m245') if blocked else _l('m246')), 'member_inline', 'success' if blocked else 'danger', value=not blocked)])
        if capabilities.get('delete_messages'):
            key = str(state['chat']) + ':' + str(uid)
            blocked = bool(ctx.state.get('guest_member_blocks', {}).get(key))
            buttons.append([b('🤖 ' + (_l('m247') if blocked else _l('m248')), 'member_guest', 'success' if blocked else 'danger')])
        if status == 'member' and capabilities.get('admin'):
            ranks = []
            if not permissions.get('creator') and (not permissions.get('admin') or capabilities.get('add_admins')):
                ranks.append(b(_l('m241'), 'member_prefix', admin=False))
            if ctx.chat_id < -1000000000000 and capabilities.get('add_admins') and (not permissions.get('creator') or own):
                ranks.append(b(_l('m242'), 'member_prefix', 'success', admin=True))
            if ranks:
                buttons.append(ranks)
    if known and is_channel and (ctx.chat_id < 0):
        buttons.append([b(_l('m231'), 'member_nochan', 'danger')])
    if state.get('people'):
        buttons.append([b(_l('m232'), 'member_prev'), b(_l('m233'), 'member_next', 'primary')])
    buttons += [[{'text': _l('m221'), 'copy_text': {'text': str(uid)}}], [b(_l('m081'), 'close', 'danger')]]
    if state.get('history'):
        state['history'][state['index']] = dict(user=user, activity=copy.deepcopy(activity))
    await _form(ctx, state, _table(ctx, _l('m003') if is_channel else _l('m002'), rows, note), buttons, callback)

async def _activity(ctx, state, months, callback):
    with _LOCK:
        if state['busy']:
            raise GodChatError(_l('m250'))
        state.update(busy=True, cancelled=False, activity=None)
    count, last, offset, seen = (0, None, 0, set())
    cutoff = time.time() - months * 30 * 86400
    try:
        await _emit(callback.edit, _table(ctx, _l('m251'), [(_l('m063'), _label(ctx, state['user']))]), reply_markup=[[_button(ctx, _l('m033'), state, 'stop', 'danger')]], rich=_rich(ctx))
        while not state['cancelled']:
            page = await _history(ctx, state['chat'], offset)
            if not page:
                break
            ids = [int(item['id']) for item in page if item.get('id') and (not offset or item['id'] < offset)]
            if not ids:
                raise GodChatError(_l('m252'))
            for message in page:
                mid = message.get('id')
                if mid not in ids or mid in seen:
                    continue
                seen.add(mid)
                sender = _sender(message)
                if sender is None and message.get('out'):
                    sender = _id(await _me(ctx))
                if _date(message.get('date')) >= cutoff and sender == _id(state['user']) and (message.get('_') != 'messageService'):
                    count += 1
                    if last is None:
                        last = _text(ctx, message) or _l('m218')
            offset = min(ids)
            if all((_date(item.get('date')) < cutoff for item in page)):
                break
        state['activity'] = dict(count=count, last=last, months=months, complete=not state['cancelled'])
        await _member_menu(ctx, state, callback)
    except _JobStopped:
        state['activity'] = dict(count=count, last=last, months=months, complete=False)
        await _member_menu(ctx, state, callback)
    finally:
        state['busy'] = False

async def _activity_job(ctx, state, callback, months):
    return await _activity(ctx, state, months, callback)

async def _bulk_menu(ctx, action, tkick=False, deleted=False):
    await _require(ctx, 'ban_users')
    if action == 'unban' and ctx.chat_id >= -1000000000000:
        raise GodChatError(_l('m253'))
    state = _session(ctx, 'tkick' if tkick else 'bulk', action=action, since=None, until=None, people=[], selected=[], page=0, configure=False, deleted=deleted)
    if not tkick:
        await _bulk_load(ctx, state)
    await _bulk_render(ctx, state)
    return state

async def _bulk_load(ctx, state):
    people = await _members(ctx, mode='banned' if state['action'] == 'unban' else 'recent', state=state)
    owner = _id(await _me(ctx))
    low, high = (state.get('since'), state.get('until'))
    high = time.time() if high is None else high
    state['people'] = [item for item in people if (not state.get('deleted') or item['user'].get('deleted')) and _id(item['user']) != owner and (item['participant'].get('_') not in ('channelParticipantCreator', 'channelParticipantAdmin', 'chatParticipantCreator', 'chatParticipantAdmin')) and (state['kind'] != 'tkick' or (low is not None and low <= _date(item['participant'].get('date')) <= high))]
    state['selected'] = [_id(item['user']) for item in state['people']]
    state['page'] = 0

@_command
async def command_tkick(ctx, invocation):
    if invocation.args:
        raise GodChatError(_l('m254'))
    await _bulk_menu(ctx, 'kick', True)

async def _bulk_render(ctx, state, callback=None):
    selected = set(state['selected'])
    page = max(0, min(state.get('page', 0), max(0, (len(state['people']) - 1) // 7)))
    state['page'] = page
    title = _l('m255') if state['kind'] == 'tkick' else _l('m256') if state['action'] == 'unban' else _l('m257')
    text = _table(ctx, title, [(_l('m162'), _esc(_range_text(ctx, state))), (_l('m259'), str(len(state['people']))), (_l('m189'), str(len(selected)))])
    b = lambda label, action, style=None, **kw: _button(ctx, label, state, action, style, **kw)
    rows = []
    for item in state['people'][page * 7:page * 7 + 7]:
        user, participant = (item['user'], item['participant'])
        uid = _id(user)
        stamp = _date(participant.get('date'))
        when = datetime.fromtimestamp(stamp, _tz(ctx)).strftime('%d.%m.%y %H:%M') if stamp else _l('m258')
        text += f"<blockquote>{('✓' if uid in selected else '✗')} {_label(ctx, user)} · {when}</blockquote>" if _rich(ctx) else f"\n{('✓' if uid in selected else '✗')} {_label(ctx, user)} · {when}"
        if state['configure']:
            rows.append([b(('✓ ' if uid in selected else '✗ ') + _name(ctx, user)[:40], 'bulk_toggle', 'success' if uid in selected else 'danger', user=uid)])
    if state['kind'] == 'tkick':
        rows += [[b(_l('m156') + (datetime.fromtimestamp(state['since'], _tz(ctx)).strftime('%d.%m.%y %H:%M') if state['since'] is not None else _l('m158')), 'date', 'primary', field='since')], [b(_l('m264') + (datetime.fromtimestamp(state['until'], _tz(ctx)).strftime('%d.%m.%y %H:%M') if state['until'] is not None else _l('m159')), 'date', 'primary', field='until')]]
    if len(state['people']) > 7:
        rows += [[b('‹', 'bulk_page', page=max(0, page - 1)), b(f"{page + 1}/{(len(state['people']) + 6) // 7}", 'noop'), b('›', 'bulk_page', page=min((len(state['people']) - 1) // 7, page + 1))]]
    rows += [[b(_l('m260') if state['action'] == 'unban' else _l('m261'), 'bulk_confirm', 'danger'), b(_l('m262') if state['configure'] else _l('m263'), 'bulk_config'), b(_l('m081'), 'close', 'danger')]]
    await _form(ctx, state, text, rows, callback)

async def _bulk_run(ctx, state, callback):
    await _require(ctx)
    if state['kind'] == 'tkick' and (state.get('since') is None or state['since'] > (state.get('until') if state.get('until') is not None else time.time())):
        raise GodChatError(_l('m265'))
    with _LOCK:
        if state['busy'] or state.get('done'):
            raise GodChatError(_l('m266'))
        state.update(busy=True, cancelled=False)
    success, errors = (0, 0)
    try:
        await _emit(callback.edit, _table(ctx, _l('m267'), [(_l('m262'), '0')]), reply_markup=[[_button(ctx, _l('m033'), state, 'stop', 'danger')]], rich=_rich(ctx))
        for item in list(state['people']):
            if state['cancelled']:
                break
            entity = item['user']
            if _id(entity) not in state['selected']:
                continue
            try:
                await _protect(ctx, entity)
                if state['kind'] == 'tkick':
                    current = await _permissions(ctx, state['chat'], entity)
                    joined = _date(current.get('participant', {}).get('date'))
                    high = state.get('until') if state.get('until') is not None else time.time()
                    if current.get('admin') or not joined or (not state['since'] <= joined <= high):
                        continue
                if state['action'] == 'kick':
                    await _retry_action(lambda: _kick(ctx, ctx.chat_id, entity))
                else:
                    await _retry_action(lambda: _restrict(ctx, ctx.chat_id, entity, {'until_date': 0}))
                success += 1
            except _JobStopped:
                break
            except Exception:
                errors += 1
            if (success + errors) % 5 == 0:
                await _emit(callback.edit, _table(ctx, _l('m267'), [(_l('m262'), str(success)), (_l('m268'), str(errors))]), reply_markup=[[_button(ctx, _l('m033'), state, 'stop', 'danger')]], rich=_rich(ctx))
        state['done'] = True
        await _emit(callback.edit, _table(ctx, _l('m004'), [(_l('m064'), _l('m269') if state['cancelled'] else _l('m270')), (_l('m271') if state['action'] == 'unban' else _l('m272'), str(success)), (_l('m268'), str(errors))]), reply_markup=[[_button(ctx, _l('m081'), state, 'close', 'danger')]], rich=_rich(ctx))
    finally:
        state['busy'] = False

async def _calendar(ctx, state, field, callback, year=None, month=None):
    current = datetime.fromtimestamp(state.get(field) if state.get(field) is not None else time.time(), _tz(ctx))
    state['date_field'] = field
    state['calendar'] = [current.year, current.month]
    picker = state.get('picker')
    if not picker or picker['field'] != field:
        picker = dict(token=secrets.token_hex(4), field=field, view='days', anchor=current.date(), day=current.date(), hour=current.hour if state.get(field) is not None or field == 'until' else 0, minute=current.minute if state.get(field) is not None or field == 'until' else 0)
        state['picker'] = picker
    b = lambda label, action, style=None, **kw: _button(ctx, label, state, action, style, **kw)
    clear = b(_l('m286') if field == 'since' else _l('m159'), 'date_clear', 'danger' if field == 'since' else None)
    if picker['view'] == 'time':
        rows = [[b(f"{_l('m294')}{picker['hour']:02}", 'hours', 'primary'), b(f"{_l('m295')}{picker['minute']:02}", 'minutes', 'primary')], [b(_l('picker_save'), 'picker_save', 'success'), b(_l('m187'), 'picker_back'), clear]]
    else:
        today = datetime.now(_tz(ctx)).date()
        earliest = datetime(2003, 1, 1).date()
        picker['anchor'] = max(earliest, min(today, picker['anchor']))
        dates = [picker['anchor'] - timedelta(days=offset) for offset in range(7) if picker['anchor'] - timedelta(days=offset) >= earliest]
        weekdays = [_l(key) for key in ('m287', 'm288', 'm289', 'm290', 'm291', 'm292', 'm293')]
        buttons = [b(f'{weekdays[day.weekday()]} · {day:%d.%m.%y}', 'picker_day', 'success' if day == picker['day'] else 'primary', day=day.isoformat()) for day in dates]
        rows = [buttons[index:index + 2] for index in range(0, len(buttons), 2)]
        rows += [[b('← 7', 'picker_shift', days=-7), b(_l('picker_today'), 'picker_shift', days=0), b('7 →', 'picker_shift', days=7)], [b('← 30', 'picker_shift', days=-30), b('30 →', 'picker_shift', days=30)], [b('← 365', 'picker_shift', days=-365), b('365 →', 'picker_shift', days=365)], [clear, b(_l('m187'), 'back'), b(_l('m081'), 'close', 'danger')]]
    selected = f"{picker['day']:%d.%m.%y} {picker['hour']:02}:{picker['minute']:02}"
    await _form(ctx, state, _table(ctx, _l('m296') if field == 'since' else _l('m297'), [(_l('m162'), _esc(_range_text(ctx, state))), (_l('m189'), selected), (_l('m163'), _esc(str(_tz(ctx))))]), rows, callback)

async def _dialogs(ctx):
    offset_id, offset_date, offset_peer = (0, 0, {'_': 'inputPeerEmpty'})
    chats, seen = ([], set())
    while True:
        result = await _rpc(ctx, 'messages.getDialogs', {'offset_date': offset_date, 'offset_id': offset_id, 'offset_peer': offset_peer, 'limit': 100, 'hash': 0, 'exclude_pinned': bool(offset_id or offset_date)})
        page = result.get('dialogs', [])
        if not page:
            break
        fresh = 0
        for entity in result.get('chats', []):
            uid = _id(entity)
            if uid not in seen and entity.get('_') in ('channel', 'chat') and (not entity.get('left')):
                seen.add(uid)
                chats.append(entity)
                fresh += 1
        last = page[-1]
        peer = last.get('peer')
        mid = int(last.get('top_message', 0))
        last_message = next((item for item in result.get('messages', []) if item.get('id') == mid and _id(item.get('peer_id')) == _id(peer)), {})
        stamp = int(_date(last_message.get('date')))
        if (mid, stamp, _id(peer)) == (offset_id, offset_date, _id(offset_peer)):
            raise GodChatError(_l('m298'))
        offset_id, offset_date = (mid, stamp)
        offset_peer = await _input(ctx, peer)
    return chats

async def _global_menu(ctx, invocation, action):
    entity, words, _ = await _target(ctx, invocation)
    if _id(entity) == _id(await _me(ctx)):
        raise GodChatError(_l('m299'))
    if words.count('-f') > 1 or any((word.startswith('-') and word != '-f' for word in words)) or (action == 'unban' and any((word != '-f' for word in words))):
        raise GodChatError(_l('m300'))
    reason = ' '.join((word for word in words if word != '-f'))[:500]
    chats = await _dialogs(ctx)
    state = _session(ctx, 'global', user=entity, action=action, reason=reason, show_chats='-f' in words, chats=chats, selected=[_id(chat) for chat in chats], page=0)
    await _global_render(ctx, state)
    await _run_job(ctx, _SavedForm(ctx, state), state, _global_run)

@_command
async def command_gban(ctx, invocation):
    await _global_menu(ctx, invocation, 'ban')

@_command
async def command_gunban(ctx, invocation):
    await _global_menu(ctx, invocation, 'unban')

async def _global_render(ctx, state, callback=None):
    page = max(0, min(state['page'], max(0, (len(state['chats']) - 1) // 7)))
    state['page'] = page
    b = lambda label, action, style=None, **kw: _button(ctx, label, state, action, style, **kw)
    selected = set(state['selected'])
    buttons = [[b(('✓ ' if _id(chat) in selected else '✗ ') + _name(ctx, chat)[:40], 'global_toggle', 'success' if _id(chat) in selected else 'danger', chat=_id(chat))] for chat in state['chats'][page * 7:page * 7 + 7]]
    if len(state['chats']) > 7:
        buttons += [[b('‹', 'global_page', page=max(0, page - 1)), b(f"{page + 1}/{(len(state['chats']) + 6) // 7}", 'noop'), b('›', 'global_page', page=min((len(state['chats']) - 1) // 7, page + 1))]]
    buttons += [[b(_l('m260') if state['action'] == 'unban' else _l('m301'), 'global_run', 'danger'), b(_l('m081'), 'close', 'danger')]]
    await _form(ctx, state, _table(ctx, _l('m302') if state['action'] == 'unban' else _l('m303'), [(_l('m063'), _label(ctx, state['user'])), (_l('m304'), str(len(selected)))]), buttons, callback)

async def _global_run(ctx, state, callback):
    with _LOCK:
        if state['busy'] or state.get('done'):
            raise GodChatError(_l('m266'))
        if not _GLOBAL_LOCK.acquire(blocking=False):
            raise GodChatError(_l('m305'))
        state.update(busy=True, cancelled=False)
    count = 0
    failures = []
    changed = []
    try:
        await _emit(callback.edit, _table(ctx, _l('m306'), [(_l('m063'), _label(ctx, state['user'])), (_l('m310'), '0')]), reply_markup=[[_button(ctx, _l('m033'), state, 'stop', 'danger')]], rich=_rich(ctx))
        for chat in state['chats']:
            if state['cancelled']:
                break
            cid = _id(chat)
            if cid not in state['selected']:
                continue
            try:
                capabilities = await _permissions(ctx, cid)
                if not capabilities.get('ban_users'):
                    continue
                if cid < -1000000000000:
                    try:
                        permissions = await _permissions(ctx, cid, state['user'])
                    except Exception as exc:
                        if 'USER_NOT_PARTICIPANT' not in str(exc).upper():
                            raise
                        permissions = {}
                    if permissions.get('admin'):
                        continue
                    banned = bool((permissions.get('participant', {}).get('banned_rights') or {}).get('view_messages'))
                    if banned == (state['action'] == 'ban'):
                        continue
                    await _retry_action(lambda: _restrict(ctx, cid, state['user'], {'until_date': 0, **({'view_messages': True} if state['action'] == 'ban' else {})}))
                elif state['action'] == 'ban':
                    await _rpc(ctx, 'messages.deleteChatUser', {'chat_id': -cid, 'user_id': await _input(ctx, state['user'], 'user')})
                else:
                    continue
                count += 1
                changed.append(chat)
            except _JobStopped:
                break
            except Exception as exc:
                failures.append(dict(chat=cid, error=str(exc)[:240]))
            if count % 5 == 0:
                await _emit(callback.edit, _table(ctx, _l('m306'), [(_l('m063'), _label(ctx, state['user'])), (_l('m310'), str(count))]), reply_markup=[[_button(ctx, _l('m033'), state, 'stop', 'danger')]], rich=_rich(ctx))
        _save(ctx, 'global_reports', state['token'], dict(time=time.time(), failures=failures, count=count, changed=[_id(chat) for chat in changed]))
        state['done'] = True
        rows = [(_l('m063'), _label(ctx, state['user'])), (_l('m064'), _l('m269') if state['cancelled'] else _l('m309') if failures else _l('m270')), (_l('m164'), f"{(_l('m311') if state['action'] == 'unban' else _l('m234'))}{_l('m307')}{count}{_l('m308')}")]
        if state.get('reason'):
            rows.append((_l('m053'), _esc(state['reason'])))
        if state.get('show_chats'):
            for start in range(0, max(0, len(changed) - 30), 30):
                await _send(ctx, state['chat'], _table(ctx, _l('m312'), [(_l('m057'), _label(ctx, chat)) for chat in changed[start:min(start + 30, len(changed) - 30)]]))
            rows.extend(((_l('m057'), _label(ctx, chat)) for chat in changed[-30:]))
        await _emit(callback.edit, _table(ctx, _l('m302') if state['action'] == 'unban' else _l('m303'), rows), reply_markup=[[_button(ctx, _l('m081'), state, 'close', 'danger')]], rich=_rich(ctx))
    finally:
        state['busy'] = False
        _GLOBAL_LOCK.release()

async def _requests(ctx, limit=100):
    return await _rpc(ctx, 'messages.getChatInviteImporters', {'peer': await _input(ctx, ctx.chat_id), 'requested': True, 'offset_date': 0, 'offset_user': {'_': 'inputUserEmpty'}, 'limit': limit})

@_command
async def command_req(ctx, invocation):
    await _require(ctx, 'invite_users')
    if invocation.args:
        raise GodChatError(_l('m313'))
    state = _session(ctx, 'req', amount=5)
    await _req_menu(ctx, state)

async def _req_menu(ctx, state, callback=None):
    result = await _requests(ctx, 1)
    count = int(result.get('count', len(result.get('importers', []))))
    b = lambda label, action, style=None, **kw: _button(ctx, label, state, action, style, **kw)
    amount = state['amount']
    rows = [[b(f"{_l('m318')}{amount}", 'req_run', 'success', approve=True, all=False), b(f"{_l('m319')}{amount}", 'req_run', 'danger', approve=False, all=False)], [b(_l('m314'), 'req_amount', 'primary')], [b(_l('m315'), 'req_confirm', 'success', approve=True), b(_l('m316'), 'req_confirm', 'danger', approve=False)], [b(_l('m081'), 'close', 'danger')]]
    await _form(ctx, state, _table(ctx, _l('m317'), [(_l('m320'), str(count)), (_l('m321'), str(amount))]), rows, callback)

async def _req_run(ctx, state, callback, approve, all_items=False):
    await _require(ctx, 'invite_users')
    with _LOCK:
        if state['busy']:
            raise GodChatError(_l('m322'))
        state.update(busy=True, cancelled=False)
    try:
        await _emit(callback.edit, _table(ctx, _l('m317'), [(_l('m064'), _l('m323'))]), reply_markup=[[_button(ctx, _l('m033'), state, 'stop', 'danger')]], rich=_rich(ctx))
        if all_items:
            await _rpc(ctx, 'messages.hideAllChatJoinRequests', {'peer': await _input(ctx, state['chat']), 'approved': approve})
        else:
            result = await _requests(ctx, min(100, state['amount']))
            users = {_id(user): user for user in result.get('users', [])}
            for item in result.get('importers', [])[:state['amount']]:
                if state['cancelled']:
                    break
                entity = users.get(item['user_id']) or await _resolve(ctx, item['user_id'])
                await _rpc(ctx, 'messages.hideChatJoinRequest', {'peer': await _input(ctx, state['chat']), 'user_id': await _input(ctx, entity, 'user'), 'approved': approve})
    except _JobStopped:
        pass
    finally:
        state['busy'] = False
    await _req_menu(ctx, state, callback)

@_command
async def command_gcfg(ctx, invocation):
    if invocation.args:
        raise GodChatError(_l('m118'))
    state = _session(ctx, 'gcfg', view='main')
    source = await ctx.reply()
    if isinstance(source, dict) and source.get('id') and not source.get('noforwards'):
        state['quote_source'] = source
    await _config_menu(ctx, state)

async def _config_menu(ctx, state, callback=None):
    b = lambda label, action, style=None, **kw: _button(ctx, label, state, action, style, **kw)
    view = state.get('view', 'main')
    if view == 'quotes':
        return await _quote_menu(ctx, state, callback)
    if view == 'chat':
        settings = await _chat_settings(ctx)
        rights = await _permissions(ctx)
        entity = settings['entity']
        rows = [(_l('m324'), _esc(_name(ctx, entity))), ('ID', f'<code>{_id(entity)}</code>'), (_l('m317'), _l('m114') if settings['requests'] else _l('m115')), (_l('m112'), str(settings['slow']) + _l('m035'))]
        for key, label in (('send_plain', _l('m325')), ('send_photos', _l('m326')), ('send_videos', _l('m327')), ('send_stickers', _l('m328')), ('send_gifs', 'GIF'), ('send_polls', _l('m329')), ('invite_users', _l('m330')), ('pin_messages', _l('m331'))):
            denied = settings['rights'].get(key) or settings['rights'].get('view_messages') or (key.startswith('send_') and settings['rights'].get('send_messages'))
            rows.append((label, _l('m151') if denied else _l('m348')))
        for key, label in (('ban_users', _l('m332')), ('delete_messages', _l('m333')), ('invite_users', _l('m334')), ('add_admins', _l('m335'))):
            rows.append((label, _l('m349') if rights.get(key) else _l('m350')))
        return await _form(ctx, state, _table(ctx, _l('m339'), rows), [[b(_l('m358'), 'config', view='chat')], [b(_l('m187'), 'config', view='main'), b(_l('m081'), 'close', 'danger')]], callback)
    if view == 'names':
        rows = [[b(_l('names_select'), 'name_input', 'primary')], [b(_l('names_saved'), 'config', view='names_saved')], [b(_l('m187'), 'config', view='main', style='danger'), b(_l('m081'), 'close', 'danger')]]
        return await _form(ctx, state, _table(ctx, _l('m336'), [], _l('names_help')), rows, callback)
    if view == 'names_saved':
        names = ctx.state.get('name_overrides', {})
        records = sorted(names.items(), key=lambda item: str(item[1].get('name', '')).casefold())
        page = max(0, min(state.get('names_page', 0), max(0, (len(records) - 1) // 6)))
        state['names_page'] = page
        rows = [[b(str(record.get('name', uid))[:40], 'name_open', user=uid)] for uid, record in records[page * 6:page * 6 + 6]]
        if len(records) > 6:
            rows += [[b('‹', 'names_page', page=max(0, page - 1)), b(f'{page + 1}/{(len(records) + 5) // 6}', 'config', view='names_saved'), b('›', 'names_page', page=min((len(records) - 1) // 6, page + 1))]]
        rows += [[b(_l('m187'), 'config', view='names', style='danger'), b(_l('m081'), 'close', 'danger')]]
        return await _form(ctx, state, _table(ctx, _l('m336'), [(_l('m359'), str(len(names)))]), rows, callback)
    if view == 'name_detail':
        user = state['names_user']
        custom = ctx.state.get('name_overrides', {}).get(str(_id(user)), {}).get('name')
        rows = [[b(_l('names_set'), 'name_value', 'primary', user=_id(user))]]
        if custom:
            rows.append([b(_l('names_remove'), 'name_delete', 'danger', user=str(_id(user)))])
        rows += [[b(_l('names_saved'), 'config', view='names_saved')], [b(_l('m187'), 'config', view='names', style='danger'), b(_l('m081'), 'close', 'danger')]]
        values = [(_l('names_original'), _esc(_original_name(user))), ('ID', f'<code>{_id(user)}</code>'), (_l('names_custom'), _esc(custom or _l('m368')))]
        if _username(user):
            values.insert(1, ('Username', '@' + _esc(_username(user))))
        return await _form(ctx, state, _table(ctx, _l('m336'), values), rows, callback)
    if view == 'timezone':
        minutes = int(ctx.state.get('timezone_minutes', 180))
        rows = [[b(_l('m344'), 'timezone', delta=-60), b(_l('m345'), 'timezone', delta=60)], [b(_l('m346'), 'timezone_input', 'primary')], [b(_l('m187'), 'config', view='main'), b(_l('m081'), 'close', 'danger')]]
        return await _form(ctx, state, _table(ctx, _l('m163'), [(_l('m361'), _esc(str(_tz(ctx)))), (_l('m362'), datetime.now(_tz(ctx)).strftime('%d.%m.%y %H:%M'))]), rows, callback)
    if view == 'panic':
        options = _setting(ctx, 'panic_settings') or {'close': True, 'slow': 3600, 'requests': True, 'auto': False, 'joins': 5, 'window': 10}
        rows = [[b(_l('m351') + (_l('m183') if options['close'] else _l('m184')), 'panic_option', 'success' if options['close'] else 'danger', key='close')], [b(_l('m352') + (_l('m356') if options['requests'] else _l('m357')), 'panic_option', 'success' if options['requests'] else 'danger', key='requests')], [b(_l('m363') + str(options['slow']) + _l('m353'), 'panic_slow')], [b(_l('m354') + (_l('m356') if options['auto'] else _l('m357')), 'panic_option', 'success' if options['auto'] else 'danger', key='auto')], [b(_l('m355') + str(options['joins']), 'panic_joins'), b(_l('m364') + str(options['window']) + _l('m353'), 'panic_window')], [b(_l('m187'), 'config', view='main'), b(_l('m081'), 'close', 'danger')]]
        return await _form(ctx, state, _table(ctx, _l('m347'), [(_l('m365'), _l('m366') if options['auto'] else _l('m367'))]), rows, callback)
    rows = [[b(_l('m336'), 'config', view='names'), b(_l('m163'), 'config', view='timezone')], [b(_l('m111'), 'config', view='panic')], [b('Rich mode: ' + (_l('m356') if _rich(ctx) else _l('m357')), 'rich_toggle', 'success' if _rich(ctx) else 'danger')], [b(_l('m081'), 'close', 'danger')]]
    if state['chat'] < 0:
        rows.insert(0, [b(_l('m339'), 'config', view='chat')])
    rows.insert(0, [b('Цитаты', 'config', view='quotes')])
    await _form(ctx, state, _l('m337') if _rich(ctx) else _l('m338'), rows, callback)

async def _prompt(ctx, callback, state, field, message):
    if isinstance(callback, _NativeCallback):
        if callback.value is None:
            raise GodChatError(_l('m418'))
        return await _apply_value(ctx, state, field, str(callback.value).strip(), callback)
    _INPUTS[state['chat'], callback.from_id] = dict(token=state['token'], field=field, expires=time.time() + 600)
    if field.startswith('quote_') and state.get('quote_messages'):
        _INPUTS[state['chat'], callback.from_id]['quote_entry'] = _quote_entry(state)['quote_entry']
    if field in ('hours', 'minutes') and state.get('picker'):
        _INPUTS[state['chat'], callback.from_id]['picker_token'] = state['picker']['token']
    if field == 'new_name':
        _INPUTS[state['chat'], callback.from_id]['user'] = _id(state['names_user'])
    await callback.respond(message + _l('m369'), alert=True)

async def _back(ctx, state, callback):
    if state['kind'] == 'quote':
        return await _quote_menu(ctx, state, callback)
    if state['kind'] in ('bulk', 'tkick'):
        await _bulk_render(ctx, state, callback)
    elif state['kind'] == 'gcfg':
        await _config_menu(ctx, state, callback)
    elif state['kind'] == 'req':
        await _req_menu(ctx, state, callback)
    elif state['kind'] == 'member':
        await _member_menu(ctx, state, callback)

def _exclusive_action(handler):

    async def wrapped(ctx, state, callback):
        with _LOCK:
            if state['busy'] or state.get('done'):
                raise GodChatError(_l('m370'))
            state.update(busy=True, cancelled=False)
        try:
            return await handler(ctx, state, callback)
        finally:
            state['busy'] = False
    return wrapped

@_exclusive_action
async def _purge_job(ctx, state, callback):
    if state['chat'] < 0:
        await _require(ctx, 'delete_messages')
    ids, offset, count = ([], state['last'] + 1, 0)
    await _emit(callback.edit, _table(ctx, _l('m092'), [(_l('m064'), _l('m371'))]), reply_markup=[[_button(ctx, _l('m033'), state, 'stop', 'danger')]], rich=_rich(ctx))
    try:
        while not state['cancelled']:
            page = await _history(ctx, state['chat'], offset)
            valid = [int(item['id']) for item in page if item.get('id') and item['id'] < offset]
            if not valid:
                break
            ids.extend((item['id'] for item in page if item.get('id') in valid and state['first'] <= item['id'] <= state['last'] and _in_topic(item, getattr(ctx, 'topic_id', None))))
            offset = min(valid)
            if offset <= state['first']:
                break
        for index in range(0, len(ids), 100):
            if state['cancelled']:
                break
            batch = ids[index:index + 100]
            await _delete(ctx, state['chat'], batch)
            count += len(batch)
    except _JobStopped:
        pass
    state['done'] = True
    await _emit(callback.edit, _table(ctx, _l('m092'), [(_l('m064'), _l('m269') if state['cancelled'] else _l('m270')), (_l('m093'), str(count))]), reply_markup=[[_button(ctx, _l('m081'), state, 'close', 'danger')]], rich=_rich(ctx))

@_exclusive_action
async def _aclear_job(ctx, state, callback):
    await _require(ctx, 'add_admins')
    count, failed, tag_failed = (0, 0, 0)
    await _emit(callback.edit, _table(ctx, _l('m372'), [(_l('m064'), _l('m373'))]), reply_markup=[[_button(ctx, _l('m033'), state, 'stop', 'danger')]], rich=_rich(ctx))
    try:
        people = await _members(ctx, mode='admins', state=state)
        for item in people:
            if state['cancelled']:
                break
            user, part = (item['user'], item['participant'])
            if part.get('_') in ('channelParticipantCreator', 'chatParticipantCreator') or _id(user) == _id(await _me(ctx)):
                continue
            rank = part.get('rank', '')
            try:
                await _demote(ctx, user, rank)
                count += 1
            except _JobStopped:
                raise
            except Exception:
                failed += 1
                continue
            if rank:
                try:
                    await _rpc(ctx, 'messages.editChatParticipantRank', {'peer': await _input(ctx, state['chat']), 'participant': await _input(ctx, user), 'rank': rank})
                except _JobStopped:
                    raise
                except Exception:
                    tag_failed += 1
    except _JobStopped:
        pass
    state['done'] = True
    await _emit(callback.edit, _table(ctx, _l('m372'), [(_l('m064'), _l('m269') if state['cancelled'] else _l('m270')), (_l('m374'), str(count)), (_l('m268'), str(failed)), (_l('m375'), str(tag_failed))]), reply_markup=[[_button(ctx, _l('m081'), state, 'close', 'danger')]], rich=_rich(ctx))

@_localized
async def _callback(ctx, callback, state, payload):
    action = payload['action']
    if action == 'close':
        if state['busy']:
            state['cancelled'] = True
            return await callback.respond(_l('m400'))
        for key, value in list(_INPUTS.items()):
            if value['token'] == state['token']:
                _INPUTS.pop(key, None)
        _SESSIONS.pop(state['token'], None)
        return await callback.delete()
    if action == 'stop':
        state['cancelled'] = True
        return await callback.respond(_l('m389'))
    if state['busy']:
        raise GodChatError(_l('m377'))
    if state.get('done') and action not in ('noop',):
        raise GodChatError(_l('m378'))
    if action.startswith('quote_'):
        return await _quote_callback(ctx, callback, state, payload)
    if action.startswith('picker_') or (state['kind'] == 'tkick' and action in ('hours', 'minutes', 'date_clear')):
        picker = state.get('picker')
        if not picker or (payload.get('picker_token') is not None and payload['picker_token'] != picker.get('token')):
            await callback.respond(_l('picker_stale'), alert=True)
            return await _back(ctx, state, callback)
    if action == 'config' and payload['view'] in ('panic', 'chat') and (state['chat'] >= 0):
        return await callback.respond(_l('m390'))
    prompts = {'req_amount': ('amount', _l('m380')), 'name_input': ('name_user', _l('m381')), 'timezone_input': ('timezone', _l('m382')), 'panic_slow': ('slow', _l('m383')), 'panic_joins': ('joins', _l('m384')), 'panic_window': ('window', _l('m385')), 'hours': ('hours', _l('m386')), 'minutes': ('minutes', _l('m387')), 'date_input': ('date', _l('m388'))}
    prompts.update(name_value=('new_name', _l('m391')), panic_joins=('joins', _l('m392')), panic_window=('window', _l('m393')))
    if action in prompts:
        if action == 'name_value' and payload.get('user') != _id(state.get('names_user')):
            raise GodChatError(_l('names_stale'))
        field, message = prompts[action]
        if action.startswith('panic_'):
            await _require(ctx, 'ban_users')
        return await _prompt(ctx, callback, state, field, message)
    try:
        await callback.respond()
    except Exception:
        pass
    if action == 'noop':
        return
    if action == 'back':
        return await _back(ctx, state, callback)
    if action == 'config':
        if payload['view'] == 'quotes':
            state['quote_view'] = 'main'
        state['view'] = payload['view']
        return await _config_menu(ctx, state, callback)
    if action == 'rich_toggle':
        if callback.from_id != _id(await _me(ctx)):
            raise GodChatError(_l('m394'))
        ctx.state.set('rich_mode', not _rich(ctx))
        return await _config_menu(ctx, state, callback)
    if action == 'timezone':
        value = int(ctx.state.get('timezone_minutes', 180)) + payload['delta']
        if not -720 <= value <= 840:
            raise GodChatError(_l('m395'))
        ctx.state.set('timezone_minutes', value)
        return await _config_menu(ctx, state, callback)
    if action == 'name_delete':
        if str(payload['user']) != str(_id(state.get('names_user'))):
            raise GodChatError(_l('names_stale'))
        _save(ctx, 'name_overrides', payload['user'], None)
        state['view'] = 'name_detail'
        return await _config_menu(ctx, state, callback)
    if action == 'names_page':
        state['names_page'] = payload['page']
        state['view'] = 'names_saved'
        return await _config_menu(ctx, state, callback)
    if action == 'name_open':
        record = ctx.state.get('name_overrides', {}).get(str(payload['user']))
        if not record:
            state['view'] = 'names_saved'
            return await _config_menu(ctx, state, callback)
        user = {'_': 'user', 'id': int(payload['user']), 'first_name': record.get('original', ''), 'username': record.get('username')}
        if not record.get('original'):
            try:
                user = await _resolve(ctx, int(payload['user']))
            except Exception:
                pass
        state.update(names_user=user, view='name_detail')
        return await _config_menu(ctx, state, callback)
    if action == 'panic_option':
        await _require(ctx, 'ban_users')
        options = _setting(ctx, 'panic_settings') or {'close': True, 'slow': 3600, 'requests': True, 'auto': False, 'joins': 5, 'window': 10}
        options[payload['key']] = not options[payload['key']]
        if options.get('auto') and (not any((options.get(key) for key in ('close', 'slow', 'requests')))):
            raise GodChatError(_l('m396'))
        _save(ctx, 'panic_settings', state['chat'], options)
        return await _config_menu(ctx, state, callback)
    if action == 'date':
        state.pop('picker', None)
        return await _calendar(ctx, state, payload['field'], callback)
    if action == 'picker_shift':
        picker = state['picker']
        today = datetime.now(_tz(ctx)).date()
        earliest = datetime(2003, 1, 1).date()
        picker['anchor'] = today if not payload['days'] else max(earliest, min(today, picker['anchor'] + timedelta(days=payload['days'])))
        return await _calendar(ctx, state, picker['field'], callback)
    if action == 'picker_day':
        picker = state['picker']
        try:
            day = datetime.fromisoformat(payload['day']).date()
        except (ValueError, TypeError):
            raise GodChatError(_l('m285')) from None
        if not picker['anchor'] - timedelta(days=6) <= day <= picker['anchor']:
            raise GodChatError(_l('m285'))
        picker.update(day=day, view='time')
        if picker['field'] == 'until' and state.get('until') is None:
            now = datetime.now(_tz(ctx))
            picker['hour'], picker['minute'] = (now.hour, now.minute) if day == now.date() else (23, 59)
        return await _calendar(ctx, state, picker['field'], callback)
    if action == 'picker_back':
        state['picker']['view'] = 'days'
        return await _calendar(ctx, state, state['picker']['field'], callback)
    if action == 'picker_save':
        picker = state['picker']
        field = picker['field']
        stamp = datetime.combine(picker['day'], datetime.min.time(), tzinfo=_tz(ctx)).replace(hour=picker['hour'], minute=picker['minute'], second=59 if field == 'until' else 0).timestamp()
        other = state.get('until' if field == 'since' else 'since')
        if other is not None and (stamp > other if field == 'since' else stamp < other):
            raise GodChatError(_l('m208'))
        state[field] = stamp
        state.pop('picker', None)
        await _bulk_load(ctx, state)
        return await _back(ctx, state, callback)
    if action == 'calendar':
        return await _calendar(ctx, state, state['date_field'], callback, payload['year'], payload['month'])
    if action == 'day':
        field = state['date_field']
        previous = datetime.fromtimestamp(state[field], _tz(ctx)) if state[field] is not None else None
        hour, minute = (previous.hour, previous.minute) if previous else (0, 0) if field == 'since' else (23, 59)
        year, month = state['calendar']
        state[field] = datetime(year, month, payload['day'], hour, minute, 59 if field == 'until' else 0, tzinfo=_tz(ctx)).timestamp()
        return await _calendar(ctx, state, field, callback, year, month)
    if action in ('date_done', 'date_clear'):
        if action == 'date_clear':
            state[state['date_field']] = None
        if state.get('since') is not None and state.get('until') is not None and (state['since'] > state['until']):
            raise GodChatError(_l('m208'))
        if state['kind'] == 'tkick':
            await _bulk_load(ctx, state)
        return await _back(ctx, state, callback)
    if action == 'bulk_toggle':
        uid = payload['user']
        if uid in state['selected']:
            state['selected'].remove(uid)
        else:
            state['selected'].append(uid)
        return await _bulk_render(ctx, state, callback)
    if action in ('bulk_config', 'bulk_page'):
        if action == 'bulk_config':
            state['configure'] = not state['configure']
        else:
            state['page'] = payload['page']
        return await _bulk_render(ctx, state, callback)
    if action == 'bulk_confirm':
        if not state['selected']:
            raise GodChatError(_l('m397'))
        return await _emit(callback.edit, _table(ctx, _l('m071'), [(_l('m225'), str(len(state['selected'])))]), reply_markup=[[_button(ctx, _l('m402'), state, 'bulk_run', 'danger'), _button(ctx, _l('m187'), state, 'back')]], rich=_rich(ctx))
    if action == 'bulk_run':
        return await _run_job(ctx, callback, state, _bulk_run)
    if action in ('member_prev', 'member_next'):
        history = state['history']
        history[state['index']] = dict(user=state['user'], activity=copy.deepcopy(state.get('activity')))
        index = state['index'] + (-1 if action == 'member_prev' else 1)
        if index < 0:
            return await callback.respond(_l('m401'))
        if index >= len(history):
            choices = [row['user'] for row in state['people'] if _id(row['user']) not in state['seen']]
            if not choices:
                state['seen'] = set()
                choices = [row['user'] for row in state['people'] if _id(row['user']) != _id(state['user'])] or [state['user']]
            user = secrets.choice(choices)
            state['seen'].add(_id(user))
            history.append(dict(user=user, activity=None))
        state.update(history[index])
        state['index'] = index
        return await _member_menu(ctx, state, callback)
    if action == 'member_prefix':
        state['prefix_user'] = state['user']
        state['prefix_admin'] = payload['admin']
        return await _prompt(ctx, callback, state, 'member_rank', _l('m398'))
    if action == 'member_unban':
        await _require(ctx)
        await _protect(ctx, state['user'])
        await _restrict(ctx, state['chat'], state['user'], {'until_date': 0})
        state.setdefault('local_status', {})[str(_id(state['user']))] = 'left'
        return await _member_menu(ctx, state, callback)
    if action == 'activity':
        return await _run_job(ctx, callback, state, _activity_job, payload['months'])
    if action in ('member_ban', 'member_kick'):
        return await _emit(callback.edit, _table(ctx, _l('m071'), [(_l('m063'), _label(ctx, state['user'])), (_l('m078'), _l('m005') if action == 'member_ban' else _l('m066'))]), reply_markup=[[_button(ctx, _l('m402'), state, 'member_do', 'danger', operation=action), _button(ctx, _l('m187'), state, 'back')]], rich=_rich(ctx))
    if action == 'member_do':
        await _require(ctx)
        await _protect(ctx, state['user'])
        if payload['operation'] == 'member_kick':
            await _kick(ctx, state['chat'], state['user'])
        else:
            await _restrict(ctx, state['chat'], state['user'], {'until_date': 0, 'view_messages': True})
        state.setdefault('local_status', {})[str(_id(state['user']))] = 'kicked' if payload['operation'] == 'member_kick' else 'banned'
        return await _member_menu(ctx, state, callback)
    if action == 'admin_ban':
        await _require(ctx, 'ban_users')
        await _require(ctx, 'add_admins')
        _moderation_args('ban', state['words'])
        if '-d' in state['words']:
            await _require(ctx, 'delete_messages')
        permissions = await _permissions(ctx, user=state['user'])
        if permissions.get('creator'):
            raise GodChatError(_l('m399'))
        with _LOCK:
            if state['busy']:
                raise GodChatError(_l('m266'))
            state['busy'] = True
        try:
            if permissions.get('admin'):
                await _demote(ctx, state['user'], permissions.get('participant', {}).get('rank', ''))
            title, rows = await _moderate(ctx, None, 'ban', entity_override=state['user'], words_override=state['words'], quiet=True)
            state['done'] = True
            return await _emit(callback.edit, _table(ctx, title, rows), reply_markup=[[_button(ctx, _l('m081'), state, 'close', 'danger')]], rich=_rich(ctx))
        finally:
            state['busy'] = False
    if action in ('member_inline', 'member_guest', 'member_nochan'):
        if action == 'member_inline':
            await _member_inline(ctx, state['user'], payload.get('value'))
        else:
            await _require(ctx, 'delete_messages')
            if action == 'member_nochan':
                _save(ctx, 'channel_blocks', state['chat'], True)
            else:
                key = str(state['chat']) + ':' + str(_id(state['user']))
                blocked = bool(ctx.state.get('guest_member_blocks', {}).get(key))
                _save(ctx, 'guest_member_blocks', key, None if blocked else True)
        return await _member_menu(ctx, state, callback)
    if action in ('global_page', 'global_toggle'):
        if action == 'global_page':
            state['page'] = payload['page']
        else:
            uid = payload['chat']
            if uid in state['selected']:
                state['selected'].remove(uid)
            else:
                state['selected'].append(uid)
        return await _global_render(ctx, state, callback)
    if action == 'global_run':
        return await _run_job(ctx, callback, state, _global_run)
    if action == 'req_confirm':
        return await _emit(callback.edit, _table(ctx, _l('m071'), [(_l('m078'), _l('m403') if payload['approve'] else _l('m404'))]), reply_markup=[[_button(ctx, _l('m402'), state, 'req_run', 'danger', approve=payload['approve'], all=True), _button(ctx, _l('m187'), state, 'back')]], rich=_rich(ctx))
    if action == 'req_run':
        return await _run_job(ctx, callback, state, _req_run, payload['approve'], payload['all'])
    if action == 'purge_run':
        return await _run_job(ctx, callback, state, _purge_job)
    if action == 'aclear_run':
        return await _run_job(ctx, callback, state, _aclear_job)
    raise GodChatError(_l('m376'))

@_localized
async def watcher_inputs(ctx, invocation):
    if not any((chat == ctx.chat_id for chat, actor in _INPUTS)):
        return
    message = await ctx.msg(ctx.chat_id, ctx.message_id)
    if not isinstance(message, dict):
        return
    key = (ctx.chat_id, _sender(message) or (_id(await _me(ctx)) if message.get('out') else None))
    pending = _INPUTS.get(key)
    if not pending:
        return
    if time.time() > pending['expires']:
        _INPUTS.pop(key, None)
        return
    text = _text(ctx, message).strip()
    if text in ('/cancel', 'отмена'):
        _INPUTS.pop(key, None)
        return await _answer(ctx, _l('m406'), [(_l('m064'), _l('m409'))])
    if text.startswith(str(ctx.prefix)):
        return
    state = _get(pending['token'], key[1])
    if state['busy']:
        return
    field = pending['field']
    try:
        await _apply_value(ctx, state, field, text, _SavedForm(ctx, state), expected_user=pending.get('user'), expected_picker=pending.get('picker_token'), expected_quote=pending.get('quote_entry'))
    except Exception as exc:
        return await _fail(ctx, exc)
    _INPUTS.pop(key, None)


async def _apply_name_value(ctx, state, field, text, callback, expected_user=None):
    with _LOCK:
        if state['busy']:
            raise GodChatError(_l('m377'))
        state['busy'] = True
    try:
        if field == 'name_user':
            if not re.fullmatch(r'@[A-Za-z0-9_]+|[1-9]\d{0,18}', text):
                raise GodChatError(_l('names_bad_user'))
            user = await asyncio.wait_for(_resolve(ctx, text), 20)
            if user.get('_') not in ('user', 'userEmpty') or not _id(user) or _id(user) < 0:
                raise GodChatError(_l('names_bad_user'))
            state.update(names_user=user, view='name_detail')
        else:
            user = state.get('names_user')
            if not user or expected_user is not None and expected_user != _id(user):
                raise GodChatError(_l('names_stale'))
            if not text or len(text) > 128 or any(ord(char) < 32 for char in text):
                raise GodChatError(_l('m411'))
            with _LOCK:
                saved = ctx.state.get('name_overrides', {})
                if len(saved) >= 1000 and str(_id(user)) not in saved:
                    raise GodChatError(_l('names_limit'))
                _save(ctx, 'name_overrides', _id(user), dict(name=text, original=_original_name(user), username=_username(user)))
            state['view'] = 'name_detail'
        return await _config_menu(ctx, state, callback)
    finally:
        state['busy'] = False

async def _apply_value(ctx, state, field, text, callback, expected_user=None, expected_picker=None, expected_quote=None):
    if field.startswith('quote_'):
        await _quote_apply_input(ctx, state, field.removeprefix('quote_'), text, entry_id=expected_quote)
        return await _quote_menu(ctx, state, callback)
    if field == 'member_rank':
        await _set_prefix(ctx, state['prefix_user'], text.split() + (['-a'] if state['prefix_admin'] else []), quiet=True)
        return await _member_menu(ctx, state, callback)
    elif field in ('new_name', 'name_user'):
        return await _apply_name_value(ctx, state, field, text, callback, expected_user)
    elif field == 'timezone':
        match = re.fullmatch('(?:UTC)?([+-])(\\d{1,2}):?(\\d{2})', text, re.I)
        if not match or int(match[3]) > 59:
            raise GodChatError(_l('m413'))
        minutes = (int(match[2]) * 60 + int(match[3])) * (-1 if match[1] == '-' else 1)
        if not -720 <= minutes <= 840:
            raise GodChatError(_l('m395'))
        ctx.state.set('timezone_minutes', minutes)
    elif field == 'amount':
        if not text.isdigit() or not 1 <= int(text) <= 100:
            raise GodChatError(_l('m414'))
        state['amount'] = int(text)
    elif field in ('slow', 'joins', 'window'):
        await _require(ctx, 'ban_users')
        if not text.isdigit():
            raise GodChatError(_l('m415'))
        value = int(text)
        if field == 'slow' and value not in (0, 10, 30, 60, 300, 900, 3600) or (field == 'joins' and (not 1 <= value <= 100)) or (field == 'window' and (not 1 <= value <= 3600)):
            raise GodChatError(_l('m416'))
        options = _setting(ctx, 'panic_settings') or {'close': True, 'slow': 3600, 'requests': True, 'auto': False, 'joins': 5, 'window': 10}
        options[field] = value
        if options.get('auto') and (not any((options.get(key) for key in ('close', 'slow', 'requests')))):
            raise GodChatError(_l('m417'))
        _save(ctx, 'panic_settings', state['chat'], options)
    elif field in ('hours', 'minutes', 'date'):
        if field in ('hours', 'minutes') and state['kind'] == 'tkick':
            picker = state.get('picker')
            if not picker or (expected_picker is not None and expected_picker != picker.get('token')):
                raise GodChatError(_l('picker_stale'))
        destination = state['date_field']
        if field in ('hours', 'minutes') and state.get('picker'):
            if not text.isdigit() or not 0 <= int(text) <= (23 if field == 'hours' else 59):
                raise GodChatError(_l('m419'))
            state['picker']['hour' if field == 'hours' else 'minute'] = int(text)
            return await _calendar(ctx, state, destination, callback)
        if field == 'date':
            try:
                value = datetime.strptime(text, '%d.%m.%Y %H:%M').replace(tzinfo=_tz(ctx))
            except ValueError:
                value = datetime.strptime(text, '%d.%m.%y %H:%M').replace(tzinfo=_tz(ctx))
        else:
            if not text.isdigit() or not 0 <= int(text) <= (23 if field == 'hours' else 59):
                raise GodChatError(_l('m419'))
            value = datetime.fromtimestamp(state[destination] if state[destination] is not None else time.time(), _tz(ctx))
            value = value.replace(**{'hour': int(text)} if field == 'hours' else {'minute': int(text)})
        value = value.replace(second=59 if destination == 'until' else 0, microsecond=0)
        state[destination] = value.timestamp()
    else:
        raise GodChatError(_l('m418'))

    if field in ('hours', 'minutes', 'date'):
        return await _calendar(ctx, state, state['date_field'], callback)
    return await _back(ctx, state, callback)


async def _pulse(ctx, chat, entity):
    if chat >= -1000000000000:
        return
    rights = await _permissions(ctx, chat)
    if not rights.get('ban_users'):
        return
    result = await _permissions(ctx, chat, entity)
    participant = result.get('participant', {})
    previous = copy.deepcopy(participant.get('banned_rights') or {'_': 'chatBannedRights', 'until_date': 0})
    if result.get('admin') or previous.get('send_messages') or previous.get('send_plain'):
        return
    key = str(chat) + ':' + str(_id(entity))
    if ctx.state.get('pulses', {}).get(key):
        return
    applied = dict(previous, send_messages=True, send_plain=True, until_date=int(time.time()) + 60)
    pending = dict(chat=chat, entity=await _input(ctx, entity), before=previous, applied=applied, restore=time.time() + 8, status='applying', token=secrets.token_hex(8))
    _save(ctx, 'pulses', key, pending)
    try:
        await _restrict(ctx, chat, pending['entity'], applied)
    except Exception:
        raise
    else:
        pending['status'] = 'applied'
        _save(ctx, 'pulses', key, pending)

@_localized
async def watcher_moderation(ctx, invocation):
    try:
        chat_key = str(ctx.chat_id)
        personal = any((key.startswith(chat_key + ':') for key in ctx.state.get('delete_mutes', {}))) or any((key.startswith(chat_key + ':') for key in ctx.state.get('inline_blocks', {}))) or any((key.startswith(chat_key + ':') for key in ctx.state.get('guest_member_blocks', {})))
        policy = personal or _setting(ctx, 'guest_blocks') or _setting(ctx, 'channel_blocks') or _setting(ctx, 'media_bans') or _setting(ctx, 'media_bans', 'global') or (_setting(ctx, 'panic_settings') or {}).get('auto')
        if not policy:
            return
        message = await ctx.msg(ctx.chat_id, ctx.message_id)
        if not isinstance(message, dict) or message.get('out'):
            return
        chat, sender = (ctx.chat_id, _sender(message))
        if sender == _id(await _me(ctx)):
            return
        action = message.get('action') or {}
        panic = _setting(ctx, 'panic_settings', chat) or {}
        if panic.get('auto') and action.get('_') in ('messageActionChatAddUser', 'messageActionChatJoinedByLink', 'messageActionChatJoinedByRequest'):
            control = _setting(ctx, 'controls', chat) or {}
            if not control.get('panic') and (not control.get('pending')):
                now = time.time()
                recent = _setting(ctx, 'join_events', chat) or []
                recent = [item for item in recent if now - item[0] <= int(panic.get('window', 10)) and item[1] != ctx.message_id]
                count = len(action.get('users') or [sender])
                recent += [[now, ctx.message_id]] * min(count, 100)
                _save(ctx, 'join_events', chat, recent[-200:])
                if len(recent) >= int(panic.get('joins', 5)):
                    await _toggle_control(ctx, chat, 'panic')
                    await _send(ctx, chat, _l('m420'))
        if sender is None:
            return
        key = str(chat) + ':' + str(sender)
        rule = ctx.state.get('delete_mutes', {}).get(key)
        remove, pulse = (False, False)
        if rule:
            if rule['until'] and time.time() >= rule['until']:
                _save(ctx, 'delete_mutes', key, None)
            else:
                remove, pulse = (True, True)
        if chat > 0 and message.get('via_bot_id') and ctx.state.get('inline_blocks', {}).get(key):
            remove = True
        guest = _id(message.get('guestchat_via_from'))
        if guest is not None and (_setting(ctx, 'guest_blocks', chat) or ctx.state.get('guest_member_blocks', {}).get(str(chat) + ':' + str(guest))):
            remove = True
        if sender < -1000000000000 and sender != chat and _setting(ctx, 'channel_blocks', chat):
            forwarded = message.get('fwd_from') or {}
            automatic = False
            if _id(forwarded.get('from_id')) == sender and forwarded.get('channel_post'):
                try:
                    cached = _LINKED.get(chat)
                    if not cached or time.time() - cached[0] >= 60:
                        settings = await _chat_settings(ctx, chat)
                        cached = (time.time(), int(settings['full'].get('linked_chat_id') or 0))
                        _LINKED[chat] = cached
                    automatic = cached[1] == -sender - 1000000000000
                except Exception:
                    automatic = True
            if not automatic:
                remove, pulse = (True, True)
        rules = list(_setting(ctx, 'media_bans', chat) or []) + list(_setting(ctx, 'media_bans', 'global') or [])
        if rules and message.get('media'):
            keys = _media_keys(message)
            if any((item in rules for item in keys)):
                remove = True
            elif any((item.startswith('sha256:') for item in rules)):
                try:
                    data = await _download(ctx, message)
                    remove = remove or 'sha256:' + hashlib.sha256(data).hexdigest() in rules
                except Exception:
                    pass
        if remove:
            await _delete(ctx, chat, [ctx.message_id])
            if pulse:
                try:
                    await _pulse(ctx, chat, await _resolve(ctx, sender))
                except Exception as exc:
                    await ctx.cap('logs', {'op': 'write', 'level': 'warning', 'msg': 'GodChat: delete succeeded; short mute unavailable', 'detail': str(exc)[:200]})
    except asyncio.CancelledError:
        raise
    except Exception as exc:
        await ctx.cap('logs', {'op': 'write', 'level': 'error', 'msg': 'GodChat moderation watcher failed', 'detail': str(exc)[:240]})

def _same_rights(left, right):
    keys = (set(left) | set(right)) - {'_', 'flags', 'flags2'}
    return all((int(left.get(key) or 0) == int(right.get(key) or 0) for key in keys))

@_localized
async def task_maintenance(ctx):
    now = time.time()
    await _restore_kicks(ctx, now)
    for key, pulse in list(ctx.state.get('pulses', {}).items()):
        if now < pulse['restore']:
            continue
        try:
            result = await _permissions(ctx, pulse['chat'], pulse['entity'])
            current = result.get('participant', {}).get('banned_rights') or {'_': 'chatBannedRights', 'until_date': 0}
            latest = ctx.state.get('pulses', {}).get(key)
            if not latest or latest.get('token') != pulse.get('token'):
                continue
            if _same_rights(current, pulse['applied']):
                await _restrict(ctx, pulse['chat'], pulse['entity'], pulse['before'])
            _save(ctx, 'pulses', key, None)
        except Exception as exc:
            if 'USER_NOT_PARTICIPANT' in str(exc).upper():
                _save(ctx, 'pulses', key, None)
                continue
            pulse['restore'] = now + max(5, _wait(exc))
            _save(ctx, 'pulses', key, pulse)
    for key, state in list(ctx.state.get('controls', {}).items()):
        if state.get('banchat') and state.get('until') and (now >= state['until']):
            try:
                await _toggle_control(ctx, int(key), 'banchat')
                await _send(ctx, int(key), _l('m421'))
            except Exception as exc:
                await ctx.cap('logs', {'op': 'write', 'level': 'warning', 'msg': 'GodChat: timed chat restore failed', 'detail': str(exc)[:200]})
    for key, rule in list(ctx.state.get('delete_mutes', {}).items()):
        if rule.get('until') and now >= rule['until']:
            _save(ctx, 'delete_mutes', key, None)
    reports = ctx.state.get('global_reports', {})
    if any((now - report['time'] > 86400 for report in reports.values())):
        ctx.state.set('global_reports', {key: value for key, value in reports.items() if now - value['time'] <= 86400})

@_localized
async def on_stop(ctx):
    with _LOCK:
        for job in _NATIVE_JOBS.values():
            job['state']['cancelled'] = True
    await _restore_kicks(ctx, float('inf'))
    for key, pulse in list(ctx.state.get('pulses', {}).items()):
        try:
            result = await _permissions(ctx, pulse['chat'], pulse['entity'])
            current = result.get('participant', {}).get('banned_rights') or {'_': 'chatBannedRights', 'until_date': 0}
            if _same_rights(current, pulse['applied']):
                await _restrict(ctx, pulse['chat'], pulse['entity'], pulse['before'])
            _save(ctx, 'pulses', key, None)
        except Exception as exc:
            await ctx.cap('logs', {'op': 'write', 'level': 'error', 'msg': 'GodChat: short mute restore on unload failed', 'detail': str(exc)[:200]})

async def _restore_kicks(ctx, now):
    for key, item in list(ctx.state.get('kicks', {}).items()):
        if item['restore'] > now:
            continue
        try:
            result = await _permissions(ctx, item['chat'], item['entity'])
            current = result.get('participant', {}).get('banned_rights') or {'_': 'chatBannedRights', 'until_date': 0}
            latest = ctx.state.get('kicks', {}).get(key)
            if not latest or latest['token'] != item['token']:
                continue
            if _same_rights(current, item['applied']):
                await _restrict(ctx, item['chat'], item['entity'], item['before'])
            _save(ctx, 'kicks', key, None)
        except Exception as exc:
            if 'USER_NOT_PARTICIPANT' in str(exc).upper():
                _save(ctx, 'kicks', key, None)
                continue
            item['restore'] = time.time() + max(5, _wait(exc))
            _save(ctx, 'kicks', key, item)


class Node:

    def __init__(self, tag='root', attrs=()):
        self.tag, self.a, self.children = (tag, dict(attrs), [])

    def has(self, name):
        return name in self.a.get('class', '').split()

    def text(self):
        return ''.join((c if isinstance(c, str) else c.text() for c in self.children))

class Tree(HTMLParser):

    def __init__(self, markup):
        super().__init__(convert_charrefs=True)
        self.root = Node()
        self.stack = [self.root]
        self.count = 0
        self.feed(markup)

    def handle_starttag(self, tag, attrs):
        self.count += 1
        if self.count > 24000 or len(self.stack) > 64:
            raise ValueError('markup_limit')
        node = Node(tag, attrs)
        self.stack[-1].children.append(node)
        if tag not in ('img', 'br', 'hr', 'meta', 'input'):
            self.stack.append(node)

    def handle_endtag(self, tag):
        for i in range(len(self.stack) - 1, 0, -1):
            if self.stack[i].tag == tag:
                del self.stack[i:]
                break

    def handle_data(self, text):
        self.stack[-1].children.append(text)

class Box:

    def __init__(self, w=0, h=0, ops=None):
        self.w, self.h, self.ops = (w, h, ops or [])

    def add(self, other, x=0, y=0):
        self.ops.extend(((kind, px + x, py + y, value) for kind, px, py, value in other.ops))

class Painter:
    BLOCKS = {'div', 'p', 'pre', 'blockquote', 'details', 'ul', 'ol', 'li', 'table', 'h1', 'h2', 'h3', 'h4', 'h5', 'h6', 'hr'}

    def __init__(self, payload):
        self.p = payload
        self.options = payload['options']
        self.scale = self.options['scale']
        self.width = self.options['width']
        self.dark = self.options['theme'] == 'dark'
        self.bg = self.options.get('background_color') or ('#181b1e' if self.dark else '#dce5e9')
        self.bubble = '#33383d' if self.dark else '#ffffff'
        self.out = '#33383d' if self.dark else '#e1f5d5'
        self.fg = '#f2f4f5' if self.dark else '#19232b'
        self.muted = '#9b9fa3' if self.dark else '#607180'
        self.code = '#272b2f' if self.dark else '#f0f3f5'
        self.warnings, self.fonts, self.images, self.glyphs = ([], {}, {}, {})
        self.failed_animations = set()
        self.image_bytes = 0
        self.message_id, self.document_id = (None, None)
        self.raqm = features.check_feature('raqm')
        self.stage = 'layout'

    def warn(self, code, error=None):
        item = dict(code=code, message=self.message_id, document=self.document_id, exception=type(error).__name__ if error else None)
        if item not in self.warnings:
            self.warnings.append(item)

    @staticmethod
    def rtl(text):
        for c in text:
            kind = unicodedata.bidirectional(c)
            if kind in ('R', 'AL'):
                return True
            if kind == 'L':
                return False
        return False

    def measure(self, text, style):
        return self.font(style).getlength(text, **{'direction': 'rtl'} if self.raqm and self.rtl(text) else {}) / self.scale

    def glyph_style(self, text, style):
        if text.isascii() or text.isspace():
            return style
        key = (text, style.get('family'), bool(style.get('bold')), bool(style.get('italic')), bool(style.get('mono')))
        if key not in self.glyphs:

            def missing(st):
                font = self.font(dict(st, size=16))
                unknown = font.getmask('\U0010ffff')
                return any(((glyph := font.getmask(char)).size == unknown.size and bytes(glyph) == bytes(unknown) for char in text if unicodedata.category(char) not in ('Cf', 'Cc', 'Zl', 'Zp') and char not in ('︎', '️') and (not 917760 <= ord(char) <= 917999)))
            found = None
            if missing(style):
                families = (family for family in self.p['fonts'] if family not in ('regular', 'bold', 'italic', 'bolditalic', 'mono', 'emoji', 'symbols', 'symbols2', 'math'))
                found = next((family for family in (*families, 'math', 'symbols', 'symbols2') if self.p['fonts'].get(family) and (not missing(dict(style, family=family)))), 'missing')
            if len(self.glyphs) < 4096:
                self.glyphs[key] = found
        else:
            found = self.glyphs[key]
        if found == 'missing':
            self.warn('text_glyph_missing')
        return dict(style, family=found) if found and found != 'missing' else style

    @staticmethod
    def mono_columns(text):
        columns = 0
        for cluster in regex.findall('\\X', text):
            if cluster == '\n':
                continue
            if cluster == '\t':
                columns += 4
                continue
            base = next((char for char in cluster if not unicodedata.combining(char)), cluster[0])
            columns += 2 if unicodedata.east_asian_width(base) in ('W', 'F') or '️' in cluster or 126976 <= ord(base) <= 131071 else 1
        return columns

    def atoms(self, nodes, style):
        result = []
        for node in nodes:
            if isinstance(node, str):
                for part in regex.findall('\\X', node):
                    if part == '\n':
                        result.append(('newline', None, style))
                        continue
                    if part == '\t':
                        part = '    '
                    if style.get('mono_advance') and part in '─│┌┐└┘╭╮╰╯├┤┬┴┼━┃█▉▊▋▌▍▎▏▐':
                        result.append(('code-glyph', part, style))
                        continue
                    if part == '╰':
                        result.append(('corner', part, style))
                        continue
                    emoji = None
                    if regex.search('\\p{Extended_Pictographic}|\\p{Regional_Indicator}|\\u20e3', part):
                        emoji = self.emoji(part, style.get('size', 16))
                    if emoji is not None:
                        result.append(('image', emoji, dict(style, image_size=style.get('size', 16) * 1.3)))
                    else:
                        result.append(('text', part, self.glyph_style(part, style)))
                continue
            st = dict(style)
            css = node.a.get('style', '')
            if node.tag in ('b', 'strong', 'th'):
                st['bold'] = True
            if node.tag in ('i', 'em'):
                st['italic'] = True
            if node.tag in ('code', 'pre'):
                st['mono'] = True
            if node.tag in ('u', 'ins'):
                st['underline'] = True
            if node.tag in ('s', 'del'):
                st['strike'] = True
            if node.tag in ('sup', 'sub'):
                st['shift'] = -4 if node.tag == 'sup' else 4
                st['size'] = max(9, st.get('size', 16) * 0.75)
            if node.tag == 'mark':
                st['background'] = '#665a29' if self.dark else '#fff3a3'
            if node.has('link'):
                st['color'] = style['accent']
            if node.has('via-inline'):
                st.update(size=16, bold=False, color=style['accent'])
            if node.has('reply-media'):
                st['color'] = style['accent']
            if node.has('reply-file-icon'):
                result.append(('file-icon', None, dict(st, size=12)))
                continue
            if node.has('reply-forward-icon'):
                result.append(('forward-icon', None, dict(st, size=12)))
                continue
            if node.has('views-icon') or node.has('pin-icon'):
                kind = 'views-icon' if node.has('views-icon') else 'pin-icon'
                result.append((kind, None, dict(st, size=12, color=st['color'] if kind == 'views-icon' else style['accent'])))
                continue
            if node.has('spoiler') and (not node.has('revealed')):
                st['hidden'] = True
            if node.has('name'):
                st['color'] = style['accent']
                colors = re.findall('#[0-9a-fA-F]{6}', css)
                if 'linear-gradient' in css and len(colors) > 1:
                    st['gradient'] = colors
            if node.has('rank'):
                st.update(size=11, color=style['accent'])
                result.append(('badge', node.text(), st))
                continue
            if node.has('premium'):
                st.update(size=13, color=style['accent'])
                result.append(('text', ' ', st))
                result.append(('star', None, st))
                continue
            if node.has('language'):
                st.update(size=11, color=self.muted)
            if node.tag == 'small':
                st.update(size=12, color=self.muted)
            color = re.search('(?:^|;)\\s*color:\\s*(#[0-9a-fA-F]{3,8})(?:;|$)', css)
            if color:
                st['color'] = color[1]
            if 'font-weight: bold' in css:
                st['bold'] = True
            if 'font-style: italic' in css:
                st['italic'] = True
            if node.tag == 'br':
                result.append(('newline', None, st))
            elif node.tag in ('img', 'video') or 'data-tgs' in node.a:
                size = st.get('size', 16) * 1.3
                asset = self.asset(node, size, st['color'])
                if asset is not None:
                    result.append(('image', asset, dict(st, image_size=size)))
                else:
                    result.extend(self.atoms([node.a.get('data-alt', '◇')], st))
            else:
                result.extend(self.atoms(node.children, st))
        merged = []
        for kind, value, st in result:
            if kind == 'text' and merged and (merged[-1][0] == 'text') and (merged[-1][2] == st):
                merged[-1] = ('text', merged[-1][1] + value, st)
            else:
                merged.append((kind, value, st))
        return merged

    def atom_width(self, kind, value, style):
        advance = style.get('mono_advance')
        if advance:
            if kind == 'text':
                return advance * self.mono_columns(value)
            if kind == 'image':
                return advance * 2
            if kind == 'corner':
                return advance
            if kind == 'code-glyph':
                return advance
        if kind == 'image':
            return style['image_size']
        if kind == 'corner':
            return style.get('size', 16) * 0.75
        if kind in ('star', 'file-icon', 'forward-icon', 'views-icon', 'pin-icon'):
            return style.get('size', 16)
        return self.measure(value, style) + (14 if kind == 'badge' else 0)

    def inline(self, nodes, width, style, align='left'):
        atoms = self.atoms(nodes, style)
        tokens = []
        for kind, value, st in atoms:
            if kind == 'text':
                tokens.extend((('text', word, st) for word in regex.findall('\\s+|\\S+', value)))
            else:
                tokens.append((kind, value, st))
        lines, line, used = ([], [], 0)

        def flush():
            nonlocal line, used
            lines.append((line, used))
            line = []
            used = 0
        for kind, value, st in tokens:
            if kind == 'newline':
                flush()
                continue
            extent = self.atom_width(kind, value, st)
            if kind == 'badge' and extent > width:
                kind = 'text'
                st = dict(st, background=self.code)
            if extent > width and kind == 'text':
                fragments, fragment = ([], '')
                for cluster in regex.findall('\\X', value):
                    if fragment and self.measure(fragment + cluster, st) > width:
                        fragments.append(fragment)
                        fragment = ''
                    fragment += cluster
                if fragment:
                    fragments.append(fragment)
            else:
                fragments = [value]
            for fragment in fragments:
                extent = self.atom_width(kind, fragment, st)
                if line and used + extent > width:
                    flush()
                line.append((kind, fragment, st, extent))
                used += extent
        if line:
            flush()
        box = Box(width)
        for line, used in lines:
            text = ''.join((v for k, v, st, w in line if k == 'text'))
            rtl = self.rtl(text)
            if any((unicodedata.bidirectional(c) in ('R', 'AL') for c in text)) and (not self.raqm):
                self.warn('raqm_unavailable')
            if rtl and len({str(st) for _, _, st, _ in line}) > 1:
                self.warn('mixed_rtl_styles_approximate')
            height = max([st['image_size'] + 4 if k == 'image' else st.get('size', 16) * 1.35 for k, _, st, _ in line] + [style.get('size', 16) * 1.35])
            metrics = [self.font(st).getmetrics() for k, _, st, _ in line if k in ('text', 'badge')]
            ascent = max([a / self.scale for a, d in metrics] + [style.get('size', 16) * 0.8])
            descent = max([d / self.scale for a, d in metrics] + [style.get('size', 16) * 0.2])
            height = max(height, ascent + descent)
            baseline = box.h + (height - ascent - descent) / 2 + ascent
            x = max(0, (width - used) / 2) if align == 'center' else max(0, width - used) if align == 'right' or rtl else 0
            ordered = list(reversed(line)) if rtl else line
            runs = []
            for k, v, st, w in ordered:
                if not rtl and k == 'text' and runs and (runs[-1][0] == 'text') and (runs[-1][2] == st):
                    old = runs[-1]
                    runs[-1] = (k, old[1] + v, st, old[3] + w)
                else:
                    runs.append((k, v, st, w))
            for kind, value, st, extent in runs:
                y = box.h + (height - (st['image_size'] if kind == 'image' else st.get('size', 16))) / 2 + st.get('shift', 0)
                if st.get('hidden'):
                    box.ops.append(('rect', x, y, (extent, st.get('size', 16) + 2, self.muted, 3)))
                elif kind == 'image':
                    box.ops.append(('image', x, y, (value, extent, extent, False)))
                elif kind == 'star':
                    box.ops.append(('star', x, y, (extent, st['color'])))
                elif kind == 'corner':
                    box.ops.append(('corner', x, y, (extent, st['color'])))
                elif kind == 'code-glyph':
                    box.ops.append(('code-glyph', x, box.h, (value, extent, height, st['color'])))
                elif kind in ('file-icon', 'forward-icon', 'views-icon', 'pin-icon'):
                    box.ops.append((kind, x, y, (extent, st['color'])))
                elif kind == 'badge':
                    box.ops.append(('rect', x, y - 3, (extent, st['size'] + 6, self.code, 7)))
                    box.ops.append(('text', x + 7, y, (value, st)))
                else:
                    box.ops.append(('text', x, baseline + st.get('shift', 0), (value, dict(st, text_anchor='ls'))))
                x += extent
            box.h += height
        return box

    def flow(self, nodes, width, style):
        box = Box(width)
        pending = []
        after_block = False

        def flush(before_block=False):
            if pending and after_block and isinstance(pending[0], str) and pending[0].startswith('\n'):
                pending[0] = pending[0][1:]
            if pending and before_block and isinstance(pending[-1], str) and pending[-1].endswith('\n'):
                pending[-1] = pending[-1][:-1]
            if pending:
                item = self.inline(pending, width, style, align=style.get('align', 'left'))
                box.add(item, 0, box.h)
                box.h += item.h
                pending.clear()
        for node in nodes:
            if isinstance(node, Node) and (node.tag in self.BLOCKS or node.has('media') or node.has('sticker') or node.has('math')):
                flush(before_block=True)
                item = self.block(node, width, style)
                box.add(item, 0, box.h)
                box.h += item.h
                after_block = True
            else:
                pending.append(node)
        flush()
        return box

    def block(self, node, width, style):
        if node.tag in ('style', 'script', 'meta'):
            return Box(width)
        style = dict(style)
        if node.tag == 'details':
            return self.details_card(node, width, style)
        if node.tag.startswith('h') and node.tag[1:].isdigit():
            style.update(size={1: 26, 2: 23, 3: 20}.get(int(node.tag[1:]), 18), bold=True)
        if node.has('meta') or node.has('caption') or node.has('via') or node.has('forward') or node.has('day') or node.has('service'):
            style.update(size=12, color=self.muted)
        if node.has('service'):
            style.update(size=14, color=self.fg)
        if node.has('author'):
            style.update(bold=True, color=style['accent'])
        if node.has('forward'):
            style.update(size=14, color=style['accent'])
        if node.has('attachment-title'):
            style.update(size=16, bold=True)
        if node.has('attachment-subtitle'):
            style.update(size=14, bold=False, color=self.muted)
        if node.has('language'):
            style.update(size=11, color=self.muted)
        if node.has('pattern-overlay') or node.has('reply-gift'):
            return Box(width)
        if node.has('reply'):
            return self.reply_card(node, width, style)
        if node.has('geo-card'):
            fields = {c.a.get('class', ''): c for c in node.children if isinstance(c, Node)}
            box = Box(width, 99, [('geo-map', 0, 0, (width, 94, style['accent'], self.dark))])
            for name, size, color, bold, gap in (('geo-title', 16, style['color'], True, 1), ('geo-address', 13, style['color'], False, 2), ('geo-coords', 12, self.muted, False, 3)):
                field = fields.get(name)
                if field and field.text().strip():
                    line = self.inline(field.children, max(1, width - 8), dict(style, size=size, color=color, bold=bold))
                    box.add(line, 4, box.h + gap)
                    box.h += line.h + gap
            box.h += 4
            return box
        if node.has('todo-card'):
            fields = [c for c in node.children if isinstance(c, Node)]
            inner = max(1, width - 8)
            box = Box(width)
            for field in fields:
                if field.has('todo-title'):
                    part = self.inline(field.children, inner, dict(style, size=18, bold=True))
                    box.add(part, 4, box.h)
                    box.h += part.h + 2
                elif field.has('todo-label'):
                    part = self.inline(field.children, inner, dict(style, size=13, color=self.muted))
                    box.add(part, 4, box.h)
                    box.h += part.h + 8
                elif field.has('todo-item'):
                    done = field.a.get('data-done') == '1'
                    body = next((c for c in field.children if isinstance(c, Node) and c.has('todo-text')), None)
                    content = self.inline(body.children if body else field.children, max(1, inner - 28), dict(style, size=16))
                    box.ops.append(('todo-mark', 8, box.h + max(3, (content.h - 14) / 2), (14, style['accent'], done)))
                    box.add(content, 30, box.h)
                    box.h += content.h + 3
                    by = next((c for c in field.children if isinstance(c, Node) and c.has('todo-by')), None)
                    if by:
                        credit = self.inline(by.children, max(1, inner - 28), dict(style, size=12, color=self.muted))
                        box.add(credit, 30, box.h)
                        box.h += credit.h + 3
                elif field.has('todo-progress'):
                    box.h += 5
                    part = self.inline(field.children, inner, dict(style, size=13, color=self.muted))
                    box.add(part, 4, box.h)
                    box.h += part.h
            box.h += 3
            return box
        if node.has('giveaway'):
            fields = {c.a.get('class', ''): c for c in node.children if isinstance(c, Node)}
            inner = max(1, width - 24)
            box = Box(width)
            box.ops.append(('rect', 0, 0, (width, 1, self.tint(style.get('bubble_color', self.bubble), '#e7b72e', 0.55), 0)))
            art = min(112, max(76, width * 0.31))
            ax = (width - art) / 2
            ay = 12
            box.ops.append(('giveaway-art', ax, ay, (art,)))
            box.h = ay + art + 5
            for name, size, color, bold, gap in (('giveaway-title', 19, style['color'], True, 2), ('giveaway-prize', 16, style['color'], True, 3), ('giveaway-description', 14, style['color'], False, 4), ('giveaway-channels', 13, style['accent'], True, 4), ('giveaway-countries', 12, self.muted, False, 4), ('giveaway-date', 13, self.muted, False, 5)):
                field = fields.get(name)
                if field and field.text().strip():
                    line = self.inline(field.children, inner, dict(style, size=size, color=color, bold=bold), align='center')
                    box.add(line, 12, box.h + gap)
                    box.h += line.h + gap
            box.h += 9
            return box
        if node.has('video-card'):
            media = next((c for c in node.children if isinstance(c, Node)), None)
            image = self.asset(media, min(width, 800), style['color']) if media else None
            if image is None:
                return self.inline(['[video unavailable]'], width, style)
            ratio = image.width / max(1, image.height)
            w = min(width, 360 * ratio)
            h = w / ratio
            x = (width - w) / 2
            box = Box(width, h + 6, [('image', x, 3, (image, w, h, True if media.has('round') else 'thumb'))])
            label = node.a.get('data-label', '')
            if label:
                badge = self.inline([label], max(1, w - 16), dict(style, size=11, color='#ffffff'))
                bw = min(w - 8, self.inline_width([label], dict(style, size=11)) + 12)
                box.ops.append(('rect', x + 4, 7, (bw, badge.h + 4, '#25282c', 6)))
                box.add(badge, x + 10, 9)
            return box
        if node.has('reply-author'):
            style.update(bold=True, color=style['accent'])
        if node.has('author'):
            rank = next((c for c in node.children if isinstance(c, Node) and c.has('rank')), None)
            names = [c for c in node.children if c is not rank]
            if rank:
                rw = min(width - 60, max(45, self.inline_width(rank.children, dict(style, size=11)) + 16))
                title = self.inline(names, max(40, width - rw - 10), style)
                badge = self.inline(rank.children, max(20, rw - 14), dict(style, size=11), align='center')
                box = Box(width, max(title.h, badge.h + 8) + 6)
                box.add(title)
                box.ops.append(('rect', width - rw, 2, (rw, badge.h + 6, self.code, 8)))
                box.add(badge, width - rw + 7, 5)
                return box
            title = self.inline(names, width, style)
            title.h += 6
            return title
        if node.has('media-spoiler') and (not node.has('revealed')):
            box = Box(width, 180, [('rect', 0, 0, (width, 180, self.muted, 10))])
            box.add(self.inline(['•••'], width, style, align='center'), 0, 78)
            return box
        if node.has('math'):
            self.warn('formula_source_fallback')
            return self.inline([node.text()], width, dict(style, mono=True))
        if node.tag in ('img', 'video') or 'data-tgs' in node.a:
            size = 200 if node.has('sticker') else 40 if node.has('reply-thumb') else width
            image = self.asset(node, 800 if node.has('media') else min(size, 800), style['color'])
            if image is None:
                return self.inline([node.a.get('data-alt', '[media unavailable]')], width, style)
            w = min(size, width, image.width / self.scale if not node.has('sticker') else size)
            h = image.height * w / image.width
            if h > 650:
                w *= 650 / h
                h = 650
            return Box(width, h + 10, [('image', (width - w) / 2, 5, (image, w, h, node.has('round')))])
        if node.has('grid'):
            items = [c for c in node.children if isinstance(c, Node)]
            box = Box(width)
            cell = (width - 6) / 2
            for i in range(0, len(items), 2):
                pair = [self.block(c, cell, style) for c in items[i:i + 2]]
                height = max((b.h for b in pair))
                for j, b in enumerate(pair):
                    box.add(b, j * (cell + 6), box.h)
                box.h += height + 6
            return box
        if node.tag == 'table':
            return self.table(node, width, style)
        if node.tag in ('ul', 'ol'):
            box = Box(width)
            for i, child in enumerate((c for c in node.children if isinstance(c, Node))):
                prefix = child.a.get('value', str(i + 1)) + '.' if node.tag == 'ol' else '•'
                content = self.flow(child.children, width - 24, style)
                box.add(self.inline([prefix], 22, style), 0, box.h)
                box.add(content, 24, box.h)
                box.h += max(content.h, 24) + 3
            return box
        if node.tag == 'hr':
            return Box(width, 12, [('rect', 0, 6, (width, 1, self.muted, 0))])
        if node.has('wave'):
            values = [int(re.search('height:(\\d+)', c.a.get('style', 'height:3'))[1]) for c in node.children if isinstance(c, Node)]
            return Box(width, 32, [('rect', i * 4, (32 - v) / 2, (2, v, style['accent'], 1)) for i, v in enumerate(values[:int(width / 4)])])
        if node.has('attachment'):
            items = [c for c in node.children if isinstance(c, Node)]
            box = Box(width)
            if items:
                box.ops.append(('rect', 0, 3, (44, 44, style['accent'], 22)))
                if items[0].has('document-icon'):
                    box.ops.append(('file-icon', 11, 12, (24, style.get('bubble_color', self.bubble), style['accent'])))
                else:
                    icon = self.inline(items[0].children, 42, dict(style, size=23), align='center')
                    box.add(icon, 0, 7)
                body = self.flow(items[1:], width - 56, style)
                box.add(body, 56, 4)
                box.h = max(52, body.h + 8)
            return box
        if node.tag == 'pre':
            code_style = dict(style, mono=True, size=13)
            flat_code = node.has('rich-code') or node.has('message-code')
            if flat_code:
                code_style['mono_advance'] = self.measure('0', dict(code_style, family='mono'))
            language = next((c for c in node.children if isinstance(c, Node) and c.has('language')), None)
            source = [c for c in node.children if c is not language]
            show_language = bool(language and language.text() and (not flat_code))
            content_width = min(width, max(80, self.inline_width(source, code_style) + 16))
            if show_language:
                content_width = min(width, max(content_width, self.inline_width(language.children, dict(code_style, size=11)) + 16))
            if flat_code:
                content_width = width
            body = self.inline(source, max(24, content_width - 16), code_style)
            header = self.inline(language.children, max(24, content_width - 16), dict(code_style, size=11, color=self.fg)) if show_language else Box(content_width)
            hh = header.h + 4 if header.h else 0
            box = Box(width, hh + body.h + 10)
            background = self.tint(style.get('bubble_color', self.bubble), '#000000', 0.12) if flat_code and self.dark else self.tint(style.get('bubble_color', self.bubble), '#ffffff', 0.12) if flat_code else '#0e1012' if self.dark else '#f0f2f4'
            bleed = style.get('rich_code_bleed', 0) if flat_code else 0
            box.ops.append(('rect', -bleed, 2, (content_width + 2 * bleed, hh + body.h + 6, background, 0 if bleed else 4)))
            if hh:
                box.ops.append(('rect', 0, 2, (content_width, hh, self.tint(self.bubble, style['accent'], 0.35), 3)))
                box.add(header, 8, 4)
            box.add(body, 8, hh + 5)
            if not flat_code:
                box.ops.append(('rect', 0, 2, (3, hh + body.h + 6, style['accent'], 1)))
            return box
        if node.has('buttons') or node.has('reactions'):
            rich = node.has('rich-buttons')
            items = [child for child in node.children if isinstance(child, Node)]
            if not items:
                return Box(width)
            gap = 5
            align = node.a.get('data-align', 'left') if rich else 'left'
            fill_row = node.has('buttons') and align == 'left'
            cell = max(1, (width - gap * (len(items) - 1)) / len(items)) if fill_row else None
            box = Box(width)
            x = 0
            y = 5 if rich else 0
            lineh = 0
            for child in items:
                button_color = {'primary': '#3567a0', 'danger': '#a84545', 'success': '#327a50'}.get(child.a.get('data-button-style')) if node.has('buttons') else None
                if rich:
                    button_color, foreground = {'primary': (style['accent'], '#ffffff'), 'danger': (self.tint(style.get('bubble_color', self.bubble), '#ff727e', 0.13), '#ff727e'), 'success': (self.tint(style.get('bubble_color', self.bubble), '#73e483', 0.13), '#73e483')}.get(child.a.get('data-button-style'), (self.tint(style.get('bubble_color', self.bubble), style['accent'], 0.08), style['accent']))
                else:
                    foreground = '#ffffff' if button_color else style['color']
                button_style = dict(style, size=13, color=foreground)
                w = cell if fill_row else min(width, max(55, self.inline_width(child.children, button_style) + 24))
                b = self.inline(child.children, w - 14, button_style, align='center')
                if x and x + w > width:
                    x = 0
                    y += lineh + 5
                    lineh = 0
                box.ops.append(('rect', x, y, (w, b.h + 8, button_color or self.code, 8)))
                box.add(b, x + 7, y + 4)
                if rich and child.a.get('data-button-type') in ('switch', 'url'):
                    box.ops.append(('button-arrow', x + w - 19, y + (b.h - 6) / 2, (14, '#ffffff' if child.a.get('data-button-style') == 'primary' else style['accent'])))
                x += w + gap
                lineh = max(lineh, b.h + 8)
            if rich and y == 5 and (x <= width + 5) and (align in ('center', 'right')):
                shift = (width - x + 5) / 2 if align == 'center' else width - x + 5
                box.ops = [(kind, px + shift, py, value) for kind, px, py, value in box.ops]
            box.h = y + lineh + (5 if rich else 6 if lineh else 0)
            return box
        padded = node.tag in ('blockquote', 'details', 'pre') or node.has('reply') or node.has('gift') or node.has('notice') or node.has('poll-option')
        pad = 10 if padded else 0
        if node.tag == 'pre':
            style.update(mono=True, size=13)
        if node.has('reply'):
            style.update(size=13)
        colors = re.findall('#[0-9a-fA-F]{6}', node.a.get('style', ''))
        if node.has('reply') and colors:
            style['accent'] = colors[0]
        children = node.children
        if node.tag == 'details' and 'open' not in node.a:
            children = [c for c in children if isinstance(c, Node) and c.tag == 'summary']
        if node.has('gift'):
            style['align'] = 'center'
            if colors:
                style['color'] = colors[-1]
        if node.has('meta') or node.has('day') or node.has('service'):
            content = self.inline(children, width - 2 * pad, style, align='right' if node.has('meta') else 'center')
        else:
            content = self.flow(children, width - 2 * pad, style)
        if not content.h:
            return Box(width)
        margin = 5 if padded or node.tag in ('p', 'h1', 'h2', 'h3') else 2
        box = Box(width, content.h + pad * 2 + margin * 2)
        if padded:
            if node.has('gift') and len(colors) >= 2:
                box.ops.append(('gradient', 0, margin, (width, box.h - 2 * margin, colors[:2], True)))
            else:
                background = self.tint(style.get('bubble_color', self.bubble), style.get('quote_accent', style['accent']), 0.14) if node.tag in ('blockquote', 'details') else self.code
                box.ops.append(('rect', 0, margin, (width, box.h - 2 * margin, background, 8)))
            if node.tag in ('blockquote', 'details') or node.has('reply'):
                box.ops.append(('quote-bar', 0, margin, (3, box.h - 2 * margin, self.quote_colors(node, style))))
            for child in node.children:
                if isinstance(child, Node) and child.has('pattern-overlay'):
                    sources = [c for c in child.children if isinstance(c, Node)]
                    if sources:
                        color = child.a.get('data-pattern-color', style['accent'])
                        asset = self.asset(sources[0], 40, color)
                        if asset is not None:
                            box.ops.append(('pattern', 0, margin, (width, box.h - 2 * margin, asset, color)))
        if node.has('media-spoiler') and (not node.has('revealed')):
            box.ops.append(('rect', 0, 0, (width, box.h, self.muted, 10)))
            box.add(self.inline(['•••'], width, style, align='center'), 0, box.h / 2 - 12)
        else:
            box.add(content, pad, pad + margin)
        return box

    @staticmethod
    def tint(background, accent, amount):
        base, ink = (ImageColor.getrgb(background), ImageColor.getrgb(accent))
        return '#' + ''.join((f'{round(a * (1 - amount) + b * amount):02x}' for a, b in zip(base, ink)))

    def quote_colors(self, node, style):
        colors = re.findall('#[0-9a-fA-F]{6}', node.a.get('data-quote-colors', ''))[:3]
        colors = colors or style.get('quote_colors') or [style['accent']]
        return colors if len(colors) > 1 else [colors[0], self.tint(colors[0], style.get('bubble_color', self.bubble), 0.45)]

    def reply_preview_nodes(self, nodes):
        result = []
        for node in nodes:
            if isinstance(node, str):
                result.append(re.sub('[\\r\\n]+', ' ', node))
                continue
            if node.has('language'):
                continue
            if node.tag == 'br':
                result.append(' ')
                continue
            block = node.tag in self.BLOCKS
            clone = Node('code' if node.tag == 'pre' else 'span' if block or node.tag in ('b', 'strong') else node.tag, node.a.items())
            clone.children = self.reply_preview_nodes(node.children)
            if block:
                result.append(' ')
            result.append(clone)
            if block:
                result.append(' ')
        return result

    def reply_gift(self, node):
        wrapper = next((c for c in node.children if isinstance(c, Node) and c.has('reply-gift')), None)
        source = next((c for c in wrapper.children if isinstance(c, Node)), None) if wrapper else None
        return self.asset(source, 24, self.fg) if source else None

    def reply_card(self, node, width, style):
        style = dict(style, size=13)
        colors = re.findall('#[0-9a-fA-F]{6}', node.a.get('style', ''))
        if colors:
            style['accent'] = colors[0]
        thumbnail = next((c for c in node.children if isinstance(c, Node) and c.has('reply-thumb')), None)
        content = next((c for c in node.children if isinstance(c, Node) and c.has('reply-content')), None)
        sources = content.children if content else [c for c in node.children if c is not thumbnail and (not (isinstance(c, Node) and c.has('pattern-overlay')))]
        image = self.asset(thumbnail, 44, style['accent']) if thumbnail else None
        gift = self.reply_gift(node)
        left = 66 if image else 12
        inner = max(24, width - left - 12 - (30 if gift else 0))
        text = Box(inner)
        for child in sources:
            if isinstance(child, Node) and child.has('reply-text'):
                snippet = self.inline(self.reply_preview_nodes(child.children), inner, style)
                if snippet.h > 40:
                    snippet.ops = [op for op in snippet.ops if op[2] < 36]
                    snippet.h = 40
                text.add(snippet, 0, text.h)
                text.h += snippet.h
            else:
                b = self.block(child, inner, style) if isinstance(child, Node) else self.inline([child], inner, style)
                text.add(b, 0, text.h)
                text.h += b.h
        height = max(text.h, 44 if image else 0) + 16
        box = Box(width, height + 8)
        background = self.tint(style.get('bubble_color', self.bubble), style['accent'], 0.14)
        box.ops.append(('rect', 0, 4, (width, height, background, 7)))
        for child in node.children:
            if not isinstance(child, Node) or not child.has('pattern-overlay'):
                continue
            pattern = next((c for c in child.children if isinstance(c, Node)), None)
            if pattern:
                asset = self.asset(pattern, 40, style['accent'])
                if asset is not None:
                    pattern_width = min(200, width * 0.55)
                    box.ops.append(('reply-pattern', width - pattern_width, 4, (pattern_width, height, asset, style['accent'])))
        box.ops.append(('quote-bar', 0, 4, (3, height, self.quote_colors(node, dict(style, quote_colors=None)))))
        if image:
            box.ops.append(('image', 12, 12, (image, 44, 44, 'thumb')))
        box.add(text, left, 12)
        if gift:
            box.ops.append(('image', width - 30, 8, (gift, 24, 24, False)))
        return box

    def table(self, node, width, style):
        rows = [c for c in node.children if isinstance(c, Node) and c.tag == 'tr']
        bordered = 'bordered' in node.a
        striped = 'striped' in node.a
        compact = 'compact' in node.a
        padding = 4 if compact else 6
        occupied = {}
        grid = []
        columns = 1
        for ri, row in enumerate(rows):
            ci = 0
            for cell in row.children:
                if not isinstance(cell, Node):
                    continue
                span = max(1, min(100, int(cell.a.get('colspan', '1'))))
                rowspan = max(1, min(len(rows) - ri, int(cell.a.get('rowspan', '1'))))
                while any((occupied.get((ri, col)) for col in range(ci, ci + span))):
                    ci += 1
                if ci + span > 100:
                    raise ValueError('table_columns_limit')
                grid.append((ri, ci, rowspan, span, cell))
                for rr in range(ri, ri + rowspan):
                    for cc in range(ci, ci + span):
                        occupied[rr, cc] = True
                ci += span
                columns = max(columns, ci)
        unit = width / columns
        if unit < 36:
            self.warn('table_narrow_columns')
        heights = [20 if compact else 24 for _ in rows]
        measured = []
        for ri, ci, rowspan, span, cell in grid:
            w = unit * span
            st = dict(style, size=13, bold=cell.tag == 'th')
            align = 'center' if 'center' in cell.a.get('style', '') else 'right' if 'right' in cell.a.get('style', '') else 'left'
            content = self.inline(cell.children, max(8, w - 2 * padding), st, align)
            needed = content.h + 2 * padding - sum(heights[ri:ri + rowspan])
            if needed > 0:
                heights[ri + rowspan - 1] += needed
            measured.append((ri, ci, rowspan, span, content))
        box = Box(width, sum(heights))
        if striped:
            for ri in range(1, len(rows), 2):
                box.ops.append(('rect', 0, sum(heights[:ri]), (width, heights[ri], self.tint(style.get('bubble_color', self.bubble), style['accent'], 0.08), 0)))
        for ri, ci, rowspan, span, b in measured:
            y = sum(heights[:ri])
            h = sum(heights[ri:ri + rowspan])
            if bordered:
                box.ops.append(('border', ci * unit, y, (span * unit, h, self.muted, 0)))
            box.add(b, ci * unit + padding, y + padding)
        return box

    def details_card(self, node, width, style):
        summary = next((c for c in node.children if isinstance(c, Node) and c.tag == 'summary'), None)
        content = summary.children if summary else [self.p.get('details_label', 'Details')]
        expanded = 'open' in node.a
        label_style = dict(style, size=16)
        if hasattr(self, 'classic') and (not self.classic):
            label = self.inline(content, max(1, width - 30), label_style, max_lines=2)
        else:
            label = self.inline(content, max(1, width - 30), label_style)
        header = max(18, label.h) + 10
        box = Box(width, header + 1, [('rect', 0, header, (width, 1, self.muted, 0))])
        box.ops.append(('chevron', 2, (header - 15) / 2, (15, self.muted, expanded)))
        box.add(label, 27, (header - label.h) / 2)
        if expanded:
            children = [c for c in node.children if c is not summary]
            inner = self.flow(children, max(1, width - 27), style)
            box.add(inner, 27, header + 8)
            box.h = header + 8 + inner.h
        return box

    def inline_width(self, nodes, style):
        current = maximum = 0
        for kind, value, st in self.atoms(nodes, style):
            if kind == 'newline':
                maximum = max(maximum, current)
                current = 0
            else:
                current += self.atom_width(kind, value, st)
        return max(maximum, current)

    def natural_width(self, node, style, limit):
        if isinstance(node, str):
            return self.inline_width([node], style)
        if node.has('reply'):
            return 0
        if node.has('geo-card'):
            return min(limit, 320)
        if node.has('todo-card'):
            return min(limit, 340)
        if node.has('giveaway'):
            return min(limit, 340)
        style = dict(style)
        if node.has('meta') or node.has('caption') or node.has('via') or node.has('forward') or node.has('day'):
            style.update(size=12, color=self.muted)
        if node.has('author'):
            style.update(bold=True)
            rank = next((c for c in node.children if isinstance(c, Node) and c.has('rank')), None)
            names = [c for c in node.children if c is not rank]
            width = self.inline_width(names, style)
            if rank:
                width = max(60, width) + max(45, self.inline_width(rank.children, dict(style, size=11)) + 16) + 10
            return width
        if node.has('forward'):
            style.update(size=14)
        if node.has('attachment-title'):
            style.update(size=16, bold=True)
        if node.has('attachment-subtitle'):
            style.update(size=14)
        if node.tag in ('table',) or node.has('grid') or node.has('math'):
            return limit
        if node.has('sticker'):
            return 200
        if node.has('video-card'):
            try:
                ratio = float(node.a.get('data-width', 0)) / float(node.a.get('data-height', 0))
            except (ValueError, ZeroDivisionError):
                ratio = 0
            if ratio <= 0:
                media = next((c for c in node.children if isinstance(c, Node)), None)
                image = self.asset(media, 360, style.get('color', self.fg)) if media else None
                ratio = image.width / max(1, image.height) if image else 1
            return min(limit, max(180, min(360, 360 * ratio)))
        if node.has('media'):
            return limit
        if node.has('pattern-overlay'):
            return 0
        if node.tag == 'pre':
            style.update(mono=True, size=13)
        if node.tag in ('h1', 'h2', 'h3', 'h4', 'h5', 'h6'):
            style.update(size={1: 26, 2: 23, 3: 20}.get(int(node.tag[1:]), 18), bold=True)
        if node.has('reply'):
            style.update(size=13)
        widths = []
        pending = []
        children = node.children
        if node.tag == 'details' and 'open' not in node.a:
            children = [child for child in children if isinstance(child, Node) and child.tag == 'summary']
        for child in children:
            if isinstance(child, Node) and (child.tag in self.BLOCKS or child.has('media') or child.has('sticker') or child.has('math')):
                if pending:
                    widths.append(self.inline_width(pending, style))
                    pending = []
                widths.append(self.natural_width(child, style, limit))
            else:
                pending.append(child)
        if pending:
            widths.append(self.inline_width(pending, style))
        width = max(widths + [0])
        if node.tag == 'details' and 'open' not in node.a:
            width = min(width, 360)
        if node.has('attachment'):
            width += 56
        if node.tag in ('blockquote', 'details', 'pre', 'ul', 'ol') or node.has('reply') or node.has('notice'):
            width += 24
        if node.has('reply') and any((isinstance(c, Node) and c.has('reply-thumb') for c in node.children)):
            width += 54
        if node.has('reply') and any((isinstance(c, Node) and c.has('reply-gift') for c in node.children)):
            width += 30
        if node.has('gift'):
            width = max(260, width + 20)
        return width

    def row_parts(self, row):
        style = dict(size=17, color=self.fg, accent='#79b8e8', bubble_color=self.out if row.has('outgoing') else self.bubble)
        colors = re.findall('#[0-9a-fA-F]{6}', row.a.get('style', ''))
        if colors:
            style['accent'] = colors[0]
        style['quote_colors'] = re.findall('#[0-9a-fA-F]{6}', row.a.get('data-quote-colors', ''))[:3]
        bubble = next((c for c in row.children if isinstance(c, Node) and c.has('bubble')))
        author = next((c for c in bubble.children if isinstance(c, Node) and c.has('author')), None)
        if author and author.a.get('data-quote-colors'):
            style['quote_colors'] = re.findall('#[0-9a-fA-F]{6}', author.a['data-quote-colors'])[:3]
        quote_accent = re.findall('#[0-9a-fA-F]{6}', author.a.get('data-quote-accent', '')) if author else []
        style['quote_accent'] = quote_accent[0] if quote_accent else style['accent']
        avatar = next((c for c in row.children if isinstance(c, Node) and (c.has('avatar') or c.has('initials'))), None)
        children = [c for c in bubble.children if not (isinstance(c, Node) and c.has('author') and row.has('grouped'))]
        return (style, children, avatar)

    def row_width(self, row, limit):
        style, children, avatar = self.row_parts(row)
        width = max([self.natural_width(c, style, limit - 28) for c in children] + [104]) + 28
        return min(limit, max(132, math.ceil(width)))

    def bubble_body(self, children, width, style):
        body = next((c for c in children if isinstance(c, Node) and c.has('body')), None)
        meta = next((c for c in children if isinstance(c, Node) and c.has('meta')), None)
        if body and meta and meta.text() and ('\n' not in body.text()):
            index = children.index(body)
            trailing = children[index + 1:]
            simple = not any((isinstance(c, Node) and c.tag in self.BLOCKS for c in body.children))
            if simple and all((c is meta or (isinstance(c, Node) and (not c.children)) for c in trailing)):
                mw = self.inline_width(meta.children, dict(style, size=12))
                bw = self.inline_width(body.children, style)
                if bw and bw + mw + 16 <= width:
                    box = self.flow(children[:index], width, style)
                    text = self.inline(body.children, width - mw - 16, style)
                    footer = self.inline(meta.children, mw, dict(style, size=12, color=self.muted), align='right')
                    lineheight = max(text.h, footer.h)
                    box.add(text, 0, box.h)
                    box.add(footer, width - mw, box.h + lineheight - footer.h)
                    box.h += lineheight + 2
                    return box
        return self.flow(children, width, style)

    def layout(self, markup):
        tree = Tree(markup)

        def find(node):
            if node.a.get('id') == 'quote':
                return node
            for c in node.children:
                if isinstance(c, Node):
                    result = find(c)
                    if result:
                        return result
        quote = find(tree.root)
        if quote is None:
            raise ValueError('quote_root_missing')
        if self.options.get('compact', True):
            widths = [180]
            for row in quote.children:
                if not isinstance(row, Node) or not row.has('row'):
                    continue
                self.message_id = row.a.get('data-message')
                _, _, avatar = self.row_parts(row)
                margin = 48 + (52 if avatar else 0)
                widths.append(self.row_width(row, self.width - margin) + margin)
            self.width = min(self.width, math.ceil(max(widths)))
        page = Box(self.width, 24)
        breaks = []
        for row in quote.children:
            if not isinstance(row, Node):
                continue
            style = dict(size=16, color=self.fg, accent='#79b8e8')
            if row.has('day'):
                b = self.block(row, self.width - 48, style)
                page.add(b, 24, page.h)
                page.h += b.h + 8
                continue
            if not row.has('row'):
                continue
            self.message_id = row.a.get('data-message')
            self.checkpoint('layout_message')
            style, children, avatar = self.row_parts(row)
            available = self.row_width(row, self.width - 48 - (52 if avatar else 0))
            body = self.bubble_body(children, available - 28, style)
            height = body.h + 24
            bx = self.width - 24 - (52 if avatar else 0) - available if row.has('outgoing') else 24 + (52 if avatar else 0)
            page.ops.append(('rect', bx, page.h, (available, height, self.out if row.has('outgoing') else self.bubble, 14)))
            if not row.has('grouped'):
                page.ops.append(('tail', bx + available - 10 if row.has('outgoing') else bx - 8, page.h + height - 16, (18, 16, self.out if row.has('outgoing') else self.bubble, row.has('outgoing'))))
            page.add(body, bx + 14, page.h + 12)
            if avatar and (not row.has('grouped')):
                ax = self.width - 66 if row.has('outgoing') else 24
                ay = page.h + height - 42
                if avatar.has('avatar'):
                    image = self.asset(avatar, 42, style['accent'])
                    if image is not None:
                        page.ops.append(('image', ax, ay, (image, 42, 42, True)))
                else:
                    page.ops.append(('rect', ax, ay, (42, 42, style['accent'], 21)))
                    initials = self.inline(avatar.children, 42, dict(style, color='#ffffff', bold=True), align='center')
                    page.add(initials, ax, ay + 8)
            page.h += height + 12
            breaks.append(page.h)
        page.h += 12
        return (page, breaks)

    def gradient(self, size, colors, radial=False):
        w, h = size
        a = ImageColor.getrgb(colors[0])
        b = ImageColor.getrgb(colors[-1])
        tw, th = (64, 64) if radial else (128, 1)
        image = Image.new('RGBA', (tw, th))
        pixels = []
        for y in range(th):
            for x in range(tw):
                ratio = min(1, math.hypot((x - 32) / 42, (y - 32) / 42)) if radial else x / (tw - 1)
                pixels.append(tuple((round(a[i] * (1 - ratio) + b[i] * ratio) for i in range(3))) + (255,))
        image.putdata(pixels)
        return image.resize((w, h), Image.Resampling.BILINEAR)

    def paint(self, canvas, op, offset):
        kind, x, y, value = op
        s = self.scale
        x, y = (round(x * s), round((y - offset) * s))
        draw = ImageDraw.Draw(canvas)
        if kind == 'tail':
            w, h, color, outgoing = value
            points = [(0, 0), (10, 0)] + [(10 + 8 * (i / 12) ** 2, 5 + 11 * i / 12) for i in range(13)] + [(0, 16)]
            if not outgoing:
                points = [(w - px, py) for px, py in points]
            draw.polygon([(x + px * s, y + py * s) for px, py in points], fill=color)
        elif kind == 'chevron':
            size, color, expanded = value
            points = [(0, 0.65), (0.5, 0.35), (1, 0.65)] if expanded else [(0, 0.35), (0.5, 0.65), (1, 0.35)]
            draw.line([(x + px * size * s, y + py * size * s) for px, py in points], fill=color, width=max(1, round(1.5 * s)), joint='curve')
        elif kind == 'button-arrow':
            size, color = value
            draw.line([(x + px * size * s, y + py * size * s) for px, py in ((0.1, 0.78), (0.65, 0.22))], fill=color, width=max(1, round(1.7 * s)), joint='curve')
            draw.line([(x + px * size * s, y + py * size * s) for px, py in ((0.35, 0.22), (0.65, 0.22), (0.65, 0.52))], fill=color, width=max(1, round(1.7 * s)), joint='curve')
        elif kind == 'forward-icon':
            size, color = value
            points = [(0, 12), (1, 7), (3, 4), (6, 3), (8, 3), (8, 0), (14, 6), (8, 12), (8, 8), (5, 8), (2, 10)]
            draw.polygon([(x + px * size * s / 14, y + py * size * s / 14) for px, py in points], fill=color)
        elif kind == 'views-icon':
            size, color = value
            points = []
            for i in range(25):
                t = i / 24
                points.append((x + t * size * s, y + (0.5 - 0.32 * math.sin(math.pi * t)) * size * s))
            for i in range(24, -1, -1):
                t = i / 24
                points.append((x + t * size * s, y + (0.5 + 0.32 * math.sin(math.pi * t)) * size * s))
            draw.line(points + [points[0]], fill=color, width=max(1, round(s)))
            draw.ellipse((x + size * 0.37 * s, y + size * 0.37 * s, x + size * 0.63 * s, y + size * 0.63 * s), fill=color)
        elif kind == 'pin-icon':
            size, color = value
            points = [(0.55, 0.04), (0.96, 0.45), (0.78, 0.5), (0.59, 0.72), (0.56, 0.89), (0.35, 0.68), (0.09, 0.94), (0.04, 0.89), (0.3, 0.63), (0.09, 0.42), (0.26, 0.39), (0.48, 0.2)]
            draw.polygon([(x + px * size * s, y + py * size * s) for px, py in points], fill=color)
        elif kind == 'file-icon':
            size, color = value[:2]
            background = value[2] if len(value) > 2 else self.bubble
            points = [(2, 0), (8, 0), (12, 4), (12, 14), (2, 14)]
            draw.polygon([(x + px * size * s / 14, y + py * size * s / 14) for px, py in points], fill=color)
            draw.line([(x + 8 * size * s / 14, y), (x + 8 * size * s / 14, y + 4 * size * s / 14), (x + 12 * size * s / 14, y + 4 * size * s / 14)], fill=self.tint(color, background, 0.5), width=max(1, s))
        elif kind == 'star':
            size, color = value
            radius = size * s / 2
            points = []
            for i in range(10):
                angle = -math.pi / 2 + i * math.pi / 5
                r = radius if i % 2 == 0 else radius * 0.43
                points.append((x + radius + math.cos(angle) * r, y + radius + math.sin(angle) * r))
            draw.polygon(points, fill=color)
        elif kind == 'corner':
            size, color = value
            size *= s
            points = [(x + size * 0.16, y + size * 0.05), (x + size * 0.16, y + size * 0.55), (x + size * 0.2, y + size * 0.7), (x + size * 0.34, y + size * 0.82), (x + size * 0.53, y + size * 0.85), (x + size * 0.96, y + size * 0.85)]
            draw.line(points, fill=color, width=max(1, round(s * 1.2)), joint='curve')
        elif kind == 'code-glyph':
            glyph, width, height, color = value
            width *= s
            height *= s
            if glyph in '█▉▊▋▌▍▎▏▐':
                fractions = {'█': (0, 1), '▉': (0, 7 / 8), '▊': (0, 3 / 4), '▋': (0, 5 / 8), '▌': (0, 1 / 2), '▍': (0, 3 / 8), '▎': (0, 1 / 4), '▏': (0, 1 / 8), '▐': (7 / 8, 1)}
                left, right = fractions[glyph]
                draw.rectangle((round(x + width * left), round(y + height * 0.12), round(x + width * right), round(y + height * 0.88)), fill=color)
            else:
                line = max(1, round((2 if glyph in '━┃' else 1.2) * s))
                cx = x + width * 0.5
                cy = y + height * 0.5
                horizontal = '─━┌┐└┘╭╮╰╯├┤┬┴┼'
                vertical = '│┃┌┐└┘╭╮╰╯├┤┬┴┼'
                if glyph in horizontal:
                    left = x - 0.5 * s if glyph in '─━┤┐┘╮╯┬┴┼' else cx
                    right = x + width + 0.5 * s if glyph in '─━├┌└╭╰┬┴┼' else cx
                    draw.line((left, cy, right, cy), fill=color, width=line)
                if glyph in vertical:
                    top = y - 0.5 * s if glyph in '│┃┘└╯╰├┤┴┼' else cy
                    bottom = y + height + 0.5 * s if glyph in '│┃┌┐╭╮├┤┬┼' else cy
                    draw.line((cx, top, cx, bottom), fill=color, width=line)
        elif kind == 'todo-mark':
            size, color, done = value
            size *= s
            if done:
                draw.line(((x + size * 0.12, y + size * 0.5), (x + size * 0.4, y + size * 0.76), (x + size * 0.9, y + size * 0.18)), fill=color, width=max(2, round(2.3 * s)), joint='curve')
            else:
                draw.ellipse((x + size * 0.32, y + size * 0.32, x + size * 0.68, y + size * 0.68), fill=color)
        elif kind == 'geo-map':
            width, height, accent, dark = value
            width *= s
            height *= s
            background = '#384950' if dark else '#dce8e7'
            road = '#7b898a' if dark else '#ffffff'
            water = '#44677e' if dark else '#a9d8e9'
            draw.rounded_rectangle((x, y, x + width, y + height), radius=10 * s, fill=background)
            draw.polygon([(x, y + height * 0.22), (x + width * 0.25, y), (x + width * 0.42, y), (x + width * 0.13, y + height * 0.59), (x, y + height * 0.68)], fill=water)
            roads = [((0.05, 0.82), (0.95, 0.27)), ((0.29, 0.02), (0.69, 0.98)), ((0.7, 0.06), (0.95, 0.89))]
            for (ax, ay), (bx, by) in roads:
                draw.line((x + width * ax, y + height * ay, x + width * bx, y + height * by), fill=road, width=max(2, round(5 * s)))
            cx = x + width * 0.51
            cy = y + height * 0.43
            r = 13 * s
            draw.ellipse((cx - r, cy - r, cx + r, cy + r), fill=accent)
            draw.polygon([(cx - r * 0.7, cy + r * 0.55), (cx + r * 0.7, cy + r * 0.55), (cx, cy + r * 1.85)], fill=accent)
            draw.ellipse((cx - r * 0.35, cy - r * 0.35, cx + r * 0.35, cy + r * 0.35), fill='#ffffff')
        elif kind == 'giveaway-art':
            size = value[0] * s

            def poly(points, color):
                draw.polygon([(x + px * size, y + py * size) for px, py in points], fill=color)
            draw.ellipse((x + size * 0.07, y + size * 0.08, x + size * 0.93, y + size * 0.94), fill='#3b6128')
            draw.rounded_rectangle((x + size * 0.18, y + size * 0.39, x + size * 0.82, y + size * 0.87), radius=size * 0.08, fill='#47be28')
            draw.rounded_rectangle((x + size * 0.13, y + size * 0.35, x + size * 0.87, y + size * 0.47), radius=size * 0.04, fill='#78de2d')
            draw.rectangle((x + size * 0.44, y + size * 0.4, x + size * 0.56, y + size * 0.87), fill='#ffe332')
            poly(((0.18, 0.59), (0.82, 0.59), (0.82, 0.67), (0.18, 0.67)), '#ffdd24')
            poly(((0.29, 0.34), (0.42, 0.14), (0.5, 0.38)), '#f9bc0b')
            poly(((0.71, 0.34), (0.58, 0.14), (0.5, 0.38)), '#ffdc21')
            points = []
            for i in range(10):
                angle = -math.pi / 2 + i * math.pi / 5
                radius = 0.23 if i % 2 == 0 else 0.105
                points.append((x + (0.5 + math.cos(angle) * radius) * size, y + (0.27 + math.sin(angle) * radius) * size))
            draw.polygon(points, fill='#ffe647')
            draw.line(points + [points[0]], fill='#f2a900', width=max(1, round(size * 0.025)))
            for cx, cy, color in ((0.19, 0.27, '#fb6080'), (0.83, 0.28, '#a873ff'), (0.13, 0.68, '#42d5ff'), (0.87, 0.72, '#ffe647')):
                draw.ellipse((x + (cx - 0.025) * size, y + (cy - 0.025) * size, x + (cx + 0.025) * size, y + (cy + 0.025) * size), fill=color)
        elif kind == 'text':
            text, style = value
            font = self.font(style)
            anchor = style.get('text_anchor', 'lt')
            kwargs = {'font': font, 'fill': style['color'], 'anchor': anchor}
            if self.raqm and self.rtl(text):
                kwargs['direction'] = 'rtl'
            extent = round(self.measure(text, style) * s)
            height = round(style.get('size', 16) * s)
            top = y - font.getmetrics()[0] if anchor == 'ls' else y
            if style.get('background'):
                draw.rectangle((x, top, x + extent, top + height + 2), fill=style['background'])
            if style.get('mono_advance') and (not style.get('gradient')):
                allocated = round(style['mono_advance'] * self.mono_columns(text) * s)
                if allocated > 0 and extent > allocated + 1:
                    left, upper, right, lower = font.getbbox(text, anchor=anchor)
                    mask = Image.new('L', (max(1, right - left), max(1, lower - upper)))
                    ImageDraw.Draw(mask).text((-left, -upper), text, font=font, fill=255, anchor=anchor)
                    mask = mask.resize((max(1, allocated), mask.height), Image.Resampling.LANCZOS)
                    colored = Image.new('RGBA', mask.size, style['color'])
                    colored.putalpha(mask)
                    canvas.alpha_composite(colored, (x + left, y + upper))
                    return
            if style.get('gradient') and extent > 0:
                left, upper, right, lower = font.getbbox(text, anchor=anchor)
                mask = Image.new('L', (max(1, right - left), max(1, lower - upper)))
                ImageDraw.Draw(mask).text((-left, -upper), text, font=font, fill=255, anchor=anchor)
                fill = self.gradient(mask.size, style['gradient'])
                fill.putalpha(mask)
                canvas.alpha_composite(fill, (x + left, y + upper))
            else:
                draw.text((x, y), text, **kwargs)
            underline = y + 2 * s if anchor == 'ls' else y + height + 1
            strike = y - height * 0.35 if anchor == 'ls' else y + height * 0.55
            if style.get('underline'):
                draw.line((x, underline, x + extent, underline), fill=style['color'], width=s)
            if style.get('strike'):
                draw.line((x, strike, x + extent, strike), fill=style['color'], width=s)
        elif kind in ('rect', 'border'):
            w, h, color, radius = value
            if kind == 'border':
                draw.rectangle((x, y, x + round(w * s), y + round(h * s)), outline=color, width=max(1, s))
            else:
                draw.rounded_rectangle((x, y, x + round(w * s), y + round(h * s)), radius=round(radius * s), fill=color)
        elif kind == 'quote-bar':
            w, h, colors = value
            w = max(1, round(w * s))
            h = max(1, round(h * s))
            start = max(0, -y)
            end = min(h, canvas.height - y)
            if end <= start:
                return
            strip = Image.new('RGBA', (w, end - start))
            pixels = []
            palette = [ImageColor.getrgb(c) + (255,) for c in colors]
            for py in range(start, end):
                for px in range(w):
                    color = palette[(py + px) // (6 * s) % len(palette)]
                    radius = min(6 * s, h / 2)
                    cy = radius if py < radius else h - radius if py >= h - radius else py
                    if px < radius and (px - radius) ** 2 + (py - cy) ** 2 > radius ** 2:
                        color = (0, 0, 0, 0)
                    pixels.append(color)
            strip.putdata(pixels)
            canvas.alpha_composite(strip, (x, y + start))
        elif kind == 'image':
            image, w, h, rounded = value
            target = (max(1, round(w * s)), max(1, round(h * s)))
            image = ImageOps.fit(image.resize(image.size), target, Image.Resampling.LANCZOS) if rounded == 'thumb' else image.resize(target, Image.Resampling.LANCZOS)
            if rounded:
                mask = Image.new('L', image.size)
                if rounded == 'thumb':
                    ImageDraw.Draw(mask).rounded_rectangle((0, 0, image.width - 1, image.height - 1), radius=5 * s, fill=255)
                else:
                    ImageDraw.Draw(mask).ellipse((0, 0, image.width - 1, image.height - 1), fill=255)
                from PIL import ImageChops
                image.putalpha(ImageChops.multiply(image.getchannel('A'), mask))
            canvas.alpha_composite(image, (x, y))
        elif kind == 'gradient':
            w, h, colors, radial = value
            if w * h * s * s > 24000000:
                raise ValueError('gradient_pixels_limit')
            fill = self.gradient((max(1, round(w * s)), max(1, round(h * s))), colors, radial)
            mask = Image.new('L', fill.size)
            ImageDraw.Draw(mask).rounded_rectangle((0, 0, fill.width - 1, fill.height - 1), radius=12 * s, fill=255)
            fill.putalpha(mask)
            canvas.alpha_composite(fill, (x, y))
        elif kind == 'reply-pattern':
            w, h, asset, color = value
            layer = Image.new('RGBA', (max(1, round(w * s)), max(1, round(h * s))))
            for row, py in enumerate(range(-4, round(h), 22)):
                for column, px in enumerate(range(8 + row % 2 * 17, round(w), 35)):
                    size = (10, 14, 9)[(row + column) % 3] * s
                    icon = asset.resize((size, size), Image.Resampling.LANCZOS)
                    tint = Image.new('RGBA', icon.size, color)
                    tint.putalpha(icon.getchannel('A').point(lambda a: round(a * 0.22)))
                    tint = tint.rotate((-15, 12)[(row + column) % 2], resample=Image.Resampling.BICUBIC, expand=True)
                    layer.alpha_composite(tint, (px * s, py * s))
            mask = Image.new('L', layer.size)
            ImageDraw.Draw(mask).rounded_rectangle((0, 0, layer.width - 1, layer.height - 1), radius=7 * s, fill=255)
            from PIL import ImageChops
            layer.putalpha(ImageChops.multiply(layer.getchannel('A'), mask))
            canvas.alpha_composite(layer, (x, y))
        elif kind == 'pattern':
            w, h, asset, color = value
            tile = asset.resize((32 * s, 32 * s), Image.Resampling.LANCZOS)
            tint = Image.new('RGBA', tile.size, color)
            tint.putalpha(tile.getchannel('A').point(lambda a: round(a * 0.15)))
            for py in range(max(0, -y) // (64 * s) * (64 * s), round(h * s) - 32 * s, 64 * s):
                if y + py > canvas.height:
                    break
                for px in range(8 * s, round(w * s) - 32 * s, 64 * s):
                    canvas.alpha_composite(tint, (x + px, y + py + 8 * s))

class Composition:

    @staticmethod
    def column(items, width, gap=0):
        result = Box(width)
        for item in items:
            if item.h <= 0:
                continue
            if result.h:
                result.h += gap
            result.add(item, 0, result.h)
            result.h += item.h
        return result

    @staticmethod
    def aligned(items, gap=0):
        items = [b for b in items if b.h > 0]
        baseline = max([getattr(b, 'baseline', b.h * 0.75) for b in items] + [0])
        result = Box(sum((b.w for b in items)) + gap * max(0, len(items) - 1))
        x = 0
        for item in items:
            y = baseline - getattr(item, 'baseline', item.h * 0.75)
            result.add(item, x, y)
            result.h = max(result.h, y + item.h)
            x += item.w + gap
        result.baseline = baseline
        return result

class BalancedPainter(Painter):
    SP = dict(outer=18, inner_x=12, inner_y=8, section=3, avatar=36, avatar_gap=8, message=9, group=3, radius=12, quote_x=10, quote_y=5)

    def __init__(self, payload):
        super().__init__(payload)
        self.classic = False
        if self.options.get('sticker'):
            self.SP = dict(self.SP, outer=10, inner_x=10, inner_y=5, section=2, avatar=30, avatar_gap=5, message=4, group=2)

    def inline(self, nodes, width, style, align='left', max_lines=None):
        if self.classic:
            return super().inline(nodes, width, style, align)
        width = max(1, width)
        groups = []
        word = []

        def finish():
            if word:
                groups.append(list(word))
                word.clear()
        for kind, value, st in self.atoms(nodes, style):
            if kind == 'newline':
                finish()
                groups.append(None)
            elif kind == 'text':
                for part in regex.findall('[^\\S\\n]+|\\n|[^\\s]+', value):
                    if part == '\n':
                        finish()
                        groups.append(None)
                    elif part.isspace():
                        finish()
                        groups.append([('text', part, st)])
                    else:
                        word.append(('text', part, st))
            else:
                word.append((kind, value, st))
        finish()
        lines = []
        current = []
        used = 0

        def line_end():
            nonlocal current, used
            lines.append((current, used))
            current = []
            used = 0

        def place(atom):
            nonlocal used
            k, v, st = atom
            extent = self.atom_width(k, v, st)
            if current and used + extent > width:
                line_end()
            current.append((k, v, st, extent))
            used += extent
        for group in groups:
            if group is None:
                line_end()
                continue
            extent = sum((self.atom_width(*a) for a in group))
            whitespace = len(group) == 1 and group[0][0] == 'text' and group[0][1].isspace()
            if current and used + extent > width:
                line_end()
                if whitespace:
                    continue
            if extent <= width:
                for k, v, st in group:
                    w = self.atom_width(k, v, st)
                    current.append((k, v, st, w))
                    used += w
            else:
                for k, v, st in group:
                    if k == 'text':
                        for cluster in regex.findall('\\X', v):
                            place((k, cluster, st))
                    else:
                        place((k, v, st))
        if current:
            line_end()
        if not lines:
            return Box(width)
        if max_lines and len(lines) > max_lines:
            lines = lines[:max_lines]
            row, used = lines[-1]
            row = list(row)
            ellipsis_width = self.atom_width('text', '…', style)
            while row:
                kind, value, atom_style, extent = row[-1]
                if not (kind == 'text' and value.isspace()) and used + ellipsis_width <= width:
                    break
                if kind == 'text':
                    fragments = regex.findall('\\X', value)
                    shorter = ''.join(fragments[:-1])
                    if shorter:
                        new_extent = self.atom_width(kind, shorter, atom_style)
                        row[-1] = (kind, shorter, atom_style, new_extent)
                        used += new_extent - extent
                        continue
                row.pop()
                used -= extent
            row.append(('text', '…', style, ellipsis_width))
            lines[-1] = (row, used + ellipsis_width)
        base = self.font(style).getmetrics()
        asc, desc = (base[0] / self.scale, base[1] / self.scale)
        body_line = style.get('line_spacing') is not None
        base_asc, base_desc = (asc, desc)
        for row, _ in lines:
            for k, v, st, w in row:
                if k in ('text', 'badge'):
                    a, d = self.font(st).getmetrics()
                    if body_line:
                        asc = max(asc, min(a / self.scale, base_asc + 2))
                        desc = max(desc, min(d / self.scale, base_desc + 2))
                    else:
                        asc = max(asc, a / self.scale)
                        desc = max(desc, d / self.scale)
        line_step = max(style.get('size', 16) * style.get('line_spacing', 1.22), asc + desc - 3)
        if body_line:
            line_step = min(line_step, style.get('size', 16) * 1.2)
        result = Box(width)
        result.baseline = asc
        baseline = asc
        for row, used in lines:
            visual = max([st.get('image_size', 0) for k, v, st, w in row if k == 'image'] + [0])
            height = max(asc + desc, visual)
            text = ''.join((v for k, v, st, w in row if k == 'text'))
            rtl = self.rtl(text)
            if rtl:
                self.warn('mixed_rtl_styles_approximate')
            x = max(0, (width - used) / 2) if align == 'center' else max(0, width - used) if align == 'right' or rtl else 0
            runs = []
            for k, v, st, w in reversed(row) if rtl else row:
                if not rtl and k == 'text' and runs and (runs[-1][0] == 'text') and (runs[-1][2] == st):
                    old = runs[-1]
                    runs[-1] = (k, old[1] + v, st, old[3] + w)
                else:
                    runs.append((k, v, st, w))
            for k, v, st, w in runs:
                y = baseline + st.get('shift', 0)
                if st.get('hidden'):
                    result.ops.append(('rect', x, y - asc, (w, asc + desc, self.muted, 3)))
                elif k == 'text':
                    result.ops.append(('text', x, y, (v, dict(st, text_anchor='ls'))))
                elif k == 'code-glyph':
                    result.ops.append(('code-glyph', x, y - asc, (v, w, line_step, st['color'])))
                elif k == 'image':
                    result.ops.append(('image', x, y - asc + (height - w) / 2, (v, w, w, False)))
                elif k == 'badge':
                    result.ops.append(('rect', x, y - st['size'], (w, st['size'] + 5, self.code, 6)))
                    result.ops.append(('text', x + 7, y, (v, dict(st, text_anchor='ls'))))
                else:
                    result.ops.append((k, x, y - st.get('size', 16), (w, st['color'])))
                x += w
            result.h = baseline + desc
            baseline += max(line_step, min(visual, style.get('size', 16) * 1.2) if body_line else visual)
        return result

    def label(self, nodes, width, style):
        width = max(1, width)
        if self.inline_width(nodes, style) <= width and '\n' not in ''.join((n if isinstance(n, str) else n.text() for n in nodes)):
            return self.inline(nodes, width, style)
        atoms = self.atoms(nodes, style)
        chosen = []
        used = 0
        ew = self.measure('…', style)
        for kind, value, st in atoms:
            if kind == 'newline':
                break
            fragments = regex.findall('\\X', value) if kind == 'text' else [value]
            stopped = False
            for fragment in fragments:
                extent = self.atom_width(kind, fragment, st)
                if used + extent + ew > width:
                    stopped = True
                    break
                chosen.append((kind, fragment, st))
                used += extent
            if stopped:
                break
        original = self.atoms
        try:
            self.atoms = lambda *_: chosen + [('text', '…', style)]
            return self.inline([], width, style)
        finally:
            self.atoms = original

    def header(self, node, width, style):
        title_style = dict(style, size=13, bold=True, color=style['accent'])
        rank = next((c for c in node.children if isinstance(c, Node) and c.has('rank')), None)
        via = next((c for c in node.children if isinstance(c, Node) and c.has('via-inline')), None)
        names = [c for c in node.children if c is not rank and c is not via]
        names = [c for c in names if not isinstance(c, str) or c.strip()]
        badge = None
        reserve = 0
        if rank:
            role = rank.a.get('data-role', 'user')
            color = {'owner': '#956ac8', 'admin': '#49a355'}.get(role, '#999999')
            rs = dict(style, size=9, bold=True, color=color)
            rw = min(max(35, width - 48), max(35, self.inline_width(rank.children, rs) + 14))
            text = self.label(rank.children, max(1, rw - 14), rs)
            badge = Box(rw, text.h + 4)
            if role in ('owner', 'admin'):
                badge.ops.append(('rect', 0, 0, (rw, text.h + 4, self.tint(style.get('bubble_color', self.bubble), color, 0.15), 7)))
            badge.add(text, 7, 2)
            reserve = rw + 8
        available = max(1, width - reserve)
        name_width = min(available, self.inline_width(names, title_style))
        title = self.label(names, max(1, name_width), title_style)
        if via:
            vs = dict(style, size=12, bold=False, color=style['accent'])
            vw = self.inline_width(via.children, vs)
            if title.w + vw + 5 <= available:
                title = Composition.aligned([title, self.inline(via.children, vw, vs)], 5)
            else:
                title = Composition.column([title, self.label(via.children, available, vs)], available, 1)
        result = Box(width, max(title.h, badge.h if badge else 0))
        result.add(title)
        if badge:
            result.add(badge, width - badge.w, 0)
        return result

    def reply_card(self, node, width, style):
        if self.classic:
            return super().reply_card(node, width, style)
        style = dict(style, size=13, bold=False)
        colors = re.findall('#[0-9a-fA-F]{6}', node.a.get('style', ''))
        if colors:
            style['accent'] = colors[0]
        thumb = next((c for c in node.children if isinstance(c, Node) and c.has('reply-thumb')), None)
        content = next((c for c in node.children if isinstance(c, Node) and c.has('reply-content')), node)
        author = next((c for c in content.children if isinstance(c, Node) and c.has('reply-author')), None)
        snippet = next((c for c in content.children if isinstance(c, Node) and c.has('reply-text')), None)
        sticker = node.a.get('data-reply-sticker') == '1'
        if sticker:
            style['size'] = 16
        thumb_size = 48 if sticker else 36
        image = self.asset(thumb, thumb_size, style['accent']) if thumb else None
        gift = self.reply_gift(node)
        left = self.SP['quote_x'] + (thumb_size + 6 if image else 0)
        inner = max(1, width - left - 8 - (24 if gift and (not sticker) else 0))
        parts = []
        author_width = max(1, inner - (24 if gift and sticker else 0))
        if author:
            parts.append(self.label(author.children, author_width, dict(style, color=style['accent'], bold=sticker)))
        if snippet:
            parts.append(self.label(self.reply_preview_nodes(snippet.children), inner, style))
        compact = []
        for part in parts:
            trim = max(0, part.h - 17)
            line = Box(part.w, part.h - trim)
            line.add(part, 0, -trim / 2)
            compact.append(line)
        text = Composition.column(compact, inner, 0)
        height = max(text.h, thumb_size if image else 0) + 8
        result = Box(width, height, [('rect', 0, 0, (width, height, self.tint(style.get('bubble_color', self.bubble), style['accent'], 0.14), 6))])
        for child in node.children:
            if not isinstance(child, Node) or not child.has('pattern-overlay'):
                continue
            source = next((c for c in child.children if isinstance(c, Node)), None)
            if source:
                asset = self.asset(source, 30, style['accent'])
                if asset:
                    pw = min(160, width * 0.7)
                    result.ops.append(('reply-pattern', width - pw, 0, (pw, height, asset, style['accent'])))
        result.ops.append(('quote-bar', 0, 0, (3, height, self.quote_colors(node, dict(style, quote_colors=None)))))
        if image:
            if sticker:
                ratio = min(thumb_size / image.width, thumb_size / image.height)
                iw, ih = (image.width * ratio, image.height * ratio)
                result.ops.append(('image', 10 + (thumb_size - iw) / 2, (height - ih) / 2, (image, iw, ih, False)))
            else:
                result.ops.append(('image', 10, (height - thumb_size) / 2, (image, thumb_size, thumb_size, 'thumb')))
        result.add(text, left, (height - text.h) / 2)
        if gift:
            result.ops.append(('image', width - 26, 5, (gift, 20, 20, False)))
        return result

    def block(self, node, width, style):
        if self.classic:
            return super().block(node, width, style)
        if node.tag == 'details':
            return self.details_card(node, width, dict(style, rich_code_bleed=0))
        if node.has('author'):
            return self.header(node, width, style)
        if node.has('reply'):
            return self.reply_card(node, width, style)
        if node.has('forward'):
            return self.inline(node.children, width, dict(style, size=14, color=style['accent']))
        if node.has('meta'):
            return self.inline(node.children, width, dict(style, size=11, color=self.muted), align='right')
        if node.has('attachment'):
            icon = next((c for c in node.children if isinstance(c, Node) and c.has('disc')), None)
            content = next((c for c in node.children if isinstance(c, Node) and c is not icon), None)
            if not content:
                return Box(width)
            parts = []
            for child in content.children:
                if not isinstance(child, Node):
                    continue
                if child.has('attachment-title'):
                    parts.append(self.label(child.children, max(1, width - 54), dict(style, size=15, bold=True)))
                elif child.has('attachment-subtitle'):
                    parts.append(self.label(child.children, max(1, width - 54), dict(style, size=13, color=self.muted)))
                else:
                    parts.append(self.block(child, max(1, width - 54), style))
            text = Composition.column(parts, max(1, width - 54), 2)
            height = max(42, text.h)
            result = Box(width, height, [('rect', 0, (height - 42) / 2, (42, 42, style['accent'], 21))])
            if icon and icon.has('document-icon'):
                result.ops.append(('file-icon', 10, (height - 24) / 2, (24, style.get('bubble_color', self.bubble), style['accent'])))
            elif icon:
                pict = self.inline(icon.children, 42, dict(style, size=22), align='center')
                result.add(pict, 0, (height - pict.h) / 2)
            result.add(text, 54, (height - text.h) / 2)
            return result
        if node.has('buttons'):
            items = [c for c in node.children if isinstance(c, Node)]
            if not items:
                return Box(width)
            rich = node.has('rich-buttons')
            gap = 4
            align = node.a.get('data-align', 'left') if rich else 'left'
            widths = [min(width, max(55, self.inline_width(child.children, dict(style, size=13)) + 20)) for child in items] if rich and align in ('center', 'right') else []
            if not widths or sum(widths) + gap * (len(items) - 1) > width:
                widths = [max(1, (width - gap * (len(items) - 1)) / len(items))] * len(items)
            total = sum(widths) + gap * (len(items) - 1)
            offset = max(0, (width - total) / 2) if align == 'center' else max(0, width - total) if align == 'right' else 0
            rendered = []
            for child, cell in zip(items, widths):
                if rich:
                    color, foreground = {'primary': (style['accent'], '#ffffff'), 'danger': (self.tint(style.get('bubble_color', self.bubble), '#ff727e', 0.13), '#ff727e'), 'success': (self.tint(style.get('bubble_color', self.bubble), '#73e483', 0.13), '#73e483')}.get(child.a.get('data-button-style'), (self.tint(style.get('bubble_color', self.bubble), style['accent'], 0.08), style['accent']))
                else:
                    color = {'primary': '#3567a0', 'danger': '#a84545', 'success': '#327a50'}.get(child.a.get('data-button-style'), self.code)
                    foreground = '#ffffff' if color != self.code else self.fg
                label = self.label(child.children, max(1, cell - 12), dict(style, size=13, color=foreground))
                rendered.append((label, color))
            height = max((b.h for b, c in rendered)) + 8
            top = 5 if rich else 0
            result = Box(width, height + 2 * top)
            x = offset
            for i, (label, color) in enumerate(rendered):
                cell = widths[i]
                result.ops.append(('rect', x, top, (cell, height, color, 8 if rich else 6)))
                actual = min(cell - 12, self.inline_width(items[i].children, dict(style, size=13)))
                result.add(label, x + max(6, (cell - actual) / 2), top + (height - label.h) / 2)
                if rich and items[i].a.get('data-button-type') in ('switch', 'url'):
                    result.ops.append(('button-arrow', x + cell - 19, top + (height - 14) / 2, (14, '#ffffff' if items[i].a.get('data-button-style') == 'primary' else style['accent'])))
                x += cell + gap
            return result
        if node.tag in ('blockquote', 'details'):
            if node.tag == 'details' and 'open' not in node.a:
                summary = next((c for c in node.children if isinstance(c, Node) and c.tag == 'summary'), None)
                text = self.inline(summary.children, max(1, width - 20), style, max_lines=2) if summary else Box(width)
            else:
                text = self.flow(node.children, max(1, width - 20), dict(style, rich_code_bleed=0))
            if not text.h:
                return Box(width)
            result = Box(width, text.h + 10, [('rect', 0, 0, (width, text.h + 10, self.tint(style.get('bubble_color', self.bubble), style.get('quote_accent', style['accent']), 0.14), 6)), ('quote-bar', 0, 0, (3, text.h + 10, self.quote_colors(node, style)))])
            result.add(text, 10, 5)
            return result
        if node.has('body'):
            return self.flow(node.children, width, dict(style, line_spacing=1.15, rich_code_bleed=style.get('rich_code_bleed', self.SP['inner_x'])))
        if node.has('rich'):
            return self.flow(node.children, width, dict(style, rich_code_bleed=style.get('rich_code_bleed', self.SP['inner_x'])))
        if node.tag == 'p':
            return self.flow(node.children, width, style)
        return super().block(node, width, style)

    def natural_width(self, node, style, limit):
        if self.classic:
            return super().natural_width(node, style, limit)
        if isinstance(node, Node) and node.tag == 'details' and ('open' not in node.a) and self.options.get('sticker'):
            return min(280, super().natural_width(node, style, limit))
        if isinstance(node, Node) and node.has('media') and (node.tag in ('img', 'video')):
            box = self.block(node, limit, style)
            images = [op[3][1] for op in box.ops if op[0] == 'image']
            if images:
                return min(limit, max(images))
        if isinstance(node, Node) and node.has('author'):
            rank = next((c for c in node.children if isinstance(c, Node) and c.has('rank')), None)
            via = next((c for c in node.children if isinstance(c, Node) and c.has('via-inline')), None)
            names = [c for c in node.children if c is not rank and c is not via]
            w = self.inline_width(names, dict(style, size=13, bold=True))
            if via:
                w += 5 + self.inline_width(via.children, dict(style, size=12))
            if rank:
                w += 22 + self.inline_width(rank.children, dict(style, size=9, bold=True))
            return min(limit, w)
        if isinstance(node, Node) and node.has('attachment'):
            content = next((c for c in node.children if isinstance(c, Node) and (not c.has('disc'))), None)
            return 54 + max([self.inline_width(c.children, dict(style, size=15 if c.has('attachment-title') else 13, bold=c.has('attachment-title'))) for c in content.children if isinstance(c, Node)] + [0]) if content else 54
        return super().natural_width(node, style, limit)

    def bubble_body(self, children, width, style):
        if self.classic:
            return super().bubble_body(children, width, style)
        parts = []
        previous = None
        for child in children:
            b = self.block(child, width, style) if isinstance(child, Node) else self.inline([child], width, style)
            if not b.h:
                continue
            gap = self.SP['section'] if parts else 0
            if previous and previous.has('attachment') and isinstance(child, Node) and child.has('body'):
                gap = 6
            elif previous and previous.has('author') and isinstance(child, Node) and child.has('body'):
                gap = 0
            parts.append((b, gap, child))
            previous = child if isinstance(child, Node) else None
        if len(parts) >= 2:
            body, gap, node = parts[-2]
            footer, fgap, meta = parts[-1]
            if isinstance(node, Node) and node.has('reactions') and isinstance(meta, Node) and meta.has('meta'):
                rects = [op for op in body.ops if op[0] == 'rect']
                if rects:
                    last_y = max((op[2] for op in rects))
                    last_row = [op for op in rects if op[2] == last_y]
                    right = max((op[1] + op[3][0] for op in last_row))
                    row_height = max((op[3][1] for op in last_row))
                    fs = dict(style, size=11, color=self.muted)
                    mw = self.inline_width(meta.children, fs)
                    if mw and right + 8 + mw <= width:
                        time = self.inline(meta.children, mw, fs)
                        dy = max(0, last_y + (row_height - time.h) / 2)
                        line = Box(width, max(body.h, dy + time.h))
                        line.add(body)
                        line.add(time, width - mw, dy)
                        parts[-2:] = [(line, gap, node)]
            elif isinstance(node, Node) and node.has('body') and isinstance(meta, Node) and meta.has('meta'):
                simple = not any((isinstance(c, Node) and c.tag in self.BLOCKS for c in node.children))
                text_ops = [op for op in body.ops if op[0] == 'text']
                fs = dict(style, size=11, color=self.muted)
                mw = self.inline_width(meta.children, fs)
                if simple and text_ops and (len(text_ops) == len(body.ops)) and (len({op[2] for op in text_ops}) == 1):
                    bw = max((op[1] + self.measure(op[3][0], op[3][1]) for op in text_ops))
                    if bw + mw + 12 <= width:
                        time = self.inline(meta.children, mw, fs)
                        dy = text_ops[0][2] - time.baseline
                        line = Box(width, max(body.h, dy + time.h))
                        line.add(body)
                        line.add(time, width - mw, dy)
                        parts[-2:] = [(line, gap, node)]
        result = Box(width)
        for b, gap, node in parts:
            result.h += gap
            result.add(b, 0, result.h)
            result.h += b.h
        return result

    def layout(self, markup):
        if not self.options.get('sticker'):
            return self.compose_page(markup)
        canvas_width = self.options['width']
        best = None
        for cap in dict.fromkeys((min(canvas_width, value) for value in (400, 480, 560, 640, canvas_width))):
            self.width = canvas_width
            self._sticker_bubble_cap = cap
            page, breaks = self.compose_page(markup)
            size = max(page.w, page.h)
            if best is None or size < best[0]:
                best = (size, page, breaks)
            if page.h <= page.w:
                break
        self.width = best[1].w
        return (best[1], best[2])

    def compose_page(self, markup):
        tree = Tree(markup)

        def find(n):
            if n.a.get('id') == 'quote':
                return n
            for c in n.children:
                if isinstance(c, Node):
                    found = find(c)
                    if found:
                        return found
        quote = find(tree.root)
        if quote is None:
            raise ValueError('quote_root_missing')
        nodes = [n for n in quote.children if isinstance(n, Node)]
        outer = self.SP['outer']
        gutter = self.SP['avatar'] + self.SP['avatar_gap']
        measurements = []
        for n in nodes:
            if n.has('service-row'):
                style = dict(size=14, color=self.fg, accent=self.muted)
                avail = self.width - 2 * outer
                width = min(avail, max(112, self.natural_width(n, style, avail - 24) + 24))
                measurements.append((n, style, n.children, None, width))
                continue
            if not n.has('row'):
                continue
            style, children, avatar = self.row_parts(n)
            avail = self.width - 2 * outer - (gutter if avatar else 0)
            bodies = [c for c in children if isinstance(c, Node) and c.has('body')]

            def plain(node):
                return all((not isinstance(c, Node) or (c.tag not in self.BLOCKS and plain(c)) for c in node.children))
            simple = bool(bodies) and all((plain(c) for c in bodies)) and all((isinstance(c, Node) and any((c.has(k) for k in ('author', 'body', 'reply', 'meta', 'forward', 'reactions'))) for c in children))
            avail = min(avail, self._sticker_bubble_cap if self.options.get('sticker') else 384 if simple else 480)
            minimum = 196 if any((isinstance(c, Node) and c.has('reply') and (c.a.get('data-reply-sticker') == '1') for c in children)) else 112
            width = min(avail, max(minimum, max([self.natural_width(c, style, avail - 24) for c in children] + [0]) + 24))
            if len(children) >= 2 and isinstance(children[-2], Node) and children[-2].has('body') and isinstance(children[-1], Node) and children[-1].has('meta'):
                body, meta = children[-2:]
                if plain(body):
                    atoms = self.atoms(body.children, style)
                    if atoms and all((kind != 'newline' for kind, _, _ in atoms)):
                        text_width = self.inline_width(body.children, style)
                        time_width = self.inline_width(meta.children, dict(style, size=11, color=self.muted))
                        inline_width = text_width + time_width + 12 + 2 * self.SP['inner_x']
                        if inline_width <= avail:
                            width = max(width, inline_width)
            measurements.append((n, style, children, avatar, width))
        if self.options.get('compact', True):
            self.width = min(self.width, math.ceil(max([w + 2 * outer + (gutter if a else 0) for n, s, c, a, w in measurements] + [160])))
        prepared = {id(n): (s, c, a, w) for n, s, c, a, w in measurements}
        page = Box(self.width, outer)
        breaks = []
        for i, node in enumerate(nodes):
            if node.has('day'):
                b = super().block(node, self.width - 2 * outer, dict(size=12, color=self.muted, accent=self.muted))
                page.add(b, outer, page.h)
                page.h += b.h + 6
                continue
            if node.has('service-row'):
                self.message_id = node.a.get('data-message')
                self.checkpoint('layout_message')
                style, children, avatar, width = prepared[id(node)]
                b = self.flow(children, width - 24, style)
                height = b.h + 10
                x = (self.width - width) / 2
                page.ops.append(('rect', x, page.h, (width, height, self.code, min(18, height / 2))))
                page.add(b, x + 12, page.h + 5)
                page.h += height + self.SP['message']
                breaks.append(page.h)
                continue
            if not node.has('row'):
                continue
            self.message_id = node.a.get('data-message')
            self.checkpoint('layout_message')
            style, children, avatar, width = prepared[id(node)]
            continuation = node.has('grouped')
            next_node = nodes[i + 1] if i + 1 < len(nodes) else None
            continued = bool(next_node and next_node.has('row') and next_node.has('grouped') and (next_node.has('outgoing') == node.has('outgoing')))
            content = self.bubble_body(children, width - 2 * self.SP['inner_x'], style)
            height = max(content.h + 2 * self.SP['inner_y'], self.SP['avatar'] if avatar and (not continued) else 0)
            outgoing = node.has('outgoing')
            color = style['bubble_color']
            x = self.width - outer - (gutter if avatar else 0) - width if outgoing else outer + (gutter if avatar else 0)
            page.ops.append(('bubble-shape', x, page.h, (width, height, color, outgoing, not continued, continuation, continued)))
            page.add(content, x + self.SP['inner_x'], page.h + self.SP['inner_y'])
            if avatar and (not continued):
                ax = self.width - outer - self.SP['avatar'] if outgoing else outer
                ay = page.h + height - self.SP['avatar']
                size = self.SP['avatar']
                if avatar.has('avatar'):
                    asset = self.asset(avatar, size, style['accent'])
                    if asset:
                        page.ops.append(('image', ax, ay, (asset, size, size, True)))
                else:
                    page.ops.append(('rect', ax, ay, (size, size, style['accent'], size / 2)))
                    label = self.inline(avatar.children, size, dict(style, bold=True, color='#ffffff'), align='center')
                    page.add(label, ax, ay + (size - label.h) / 2)
            page.h += height + (self.SP['group'] if continued else self.SP['message'])
            breaks.append(page.h)
        page.h += outer - self.SP['message']
        return (page, breaks)

    def paint(self, canvas, op, offset):
        if op[0] != 'bubble-shape':
            return super().paint(canvas, op, offset)
        _, x, y, value = op
        w, h, color, outgoing, tail, joined_above, joined_below = value
        r = min(self.SP['radius'], w / 2, h / 2)
        top = 4 if joined_above else r
        bottom = 4 if joined_below else r
        points = []

        def arc(cx, cy, rr, a, b):
            for i in range(9):
                angle = math.radians(a + (b - a) * i / 8)
                points.append((cx + rr * math.cos(angle), cy + rr * math.sin(angle)))
        arc(r, r, r, 180, 270)
        arc(w - top, top, top, 270, 360)
        if tail:
            points.append((w, h - r))
            for i in range(1, 13):
                t = i / 12
                points.append((w + 7 * t * t, h - r * (1 - t) ** 2))
        else:
            arc(w - bottom, h - bottom, bottom, 0, 90)
        arc(r, h - r, r, 90, 180)
        if not outgoing:
            points = [(w - px, py) for px, py in points]
        s = self.scale
        outline = [(round((x + px) * s), round((y - offset + py) * s)) for px, py in points]
        transparency = self.options.get('bubble_transparency', 0)
        if transparency >= 100:
            return
        stroke = self.tint(color, '#ffffff' if self.dark else '#19232b', 0.12 if self.dark else 0.09)
        width = max(1, round(0.5 * s))
        if transparency == 0:
            draw = ImageDraw.Draw(canvas)
            draw.polygon(outline, fill=color)
            if self.options.get('bubble_outline', True):
                draw.line(outline + [outline[0]], fill=stroke, width=width, joint='curve')
            return
        pad = width + 1
        left = max(0, min((px for px, py in outline)) - pad)
        top = max(0, min((py for px, py in outline)) - pad)
        right = min(canvas.width, max((px for px, py in outline)) + pad + 1)
        bottom = min(canvas.height, max((py for px, py in outline)) + pad + 1)
        if right <= left or bottom <= top:
            return
        with Image.new('RGBA', (right - left, bottom - top), (0, 0, 0, 0)) as layer:
            points = [(px - left, py - top) for px, py in outline]
            draw = ImageDraw.Draw(layer)
            draw.polygon(points, fill=color)
            if self.options.get('bubble_outline', True):
                draw.line(points + [points[0]], fill=stroke, width=width, joint='curve')
            layer.putalpha(layer.getchannel('A').point(lambda alpha: round(alpha * (100 - transparency) / 100)))
            canvas.alpha_composite(layer, (left, top))

class _QuoteMarkupBase:

    async def code(self, text, language='', rich=False, message=False):
        if message:
            return f'<pre class="message-code">{self.esc(text)}</pre>'
        if rich:
            return f'<pre class="rich-code">{self.esc(text)}</pre>'
        from pygments import highlight
        from pygments.formatters import HtmlFormatter
        from pygments.lexers import get_lexer_by_name, TextLexer
        from pygments.util import ClassNotFound
        try:
            lexer = get_lexer_by_name(language, stripnl=False, ensurenl=False) if language else TextLexer(stripnl=False, ensurenl=False)
        except ClassNotFound:
            lexer = TextLexer(stripnl=False, ensurenl=False)
        formatter = HtmlFormatter(nowrap=True, noclasses=True, style='monokai' if self.options['theme'] == 'dark' else 'friendly')
        painted = highlight(text, lexer, formatter)
        if painted.endswith('\n') and (not text.endswith('\n')):
            painted = painted[:-1]
        label = '' if rich and str(language).casefold() in ('stdout', 'stderr', 'output') else language
        pre_class = ' class="rich-code"' if rich else ''
        return f'<pre{pre_class}><div class="language">{self.esc(label)}</div>{painted}</pre>'

    async def entities(self, text, entities):
        text = text or ''
        raw = text.encode('utf-16-le', 'surrogatepass')
        if len(raw) > 262144:
            raise _GQuoteError('text_limit')
        spans = []
        for entity in entities or []:
            start = max(0, int(getattr(entity, 'offset', 0)))
            end = min(len(raw) // 2, start + int(getattr(entity, 'length', 0)))
            if end > start:
                spans.append((start, end, entity))
        boundaries = sorted({0, len(raw) // 2} | {x for a, b, _ in spans for x in (a, b)})
        result, skip = ([], -1)
        for a, b in zip(boundaries, boundaries[1:]):
            if a < skip:
                continue
            active = sorted((s for s in spans if s[0] <= a < s[1]), key=lambda s: (s[0], -s[1]))
            special = next((s for s in active if self.kind(s[2]) in ('MessageEntityPre', 'MessageEntityCustomEmoji', 'MessageEntityFormattedDate')), None)
            if special:
                start, end, entity = special
                value = raw[max(a, start) * 2:end * 2].decode('utf-16-le', 'replace')
                if self.kind(entity) == 'MessageEntityPre':
                    value = await self.code(value, getattr(entity, 'language', ''), message=True)
                elif self.kind(entity) == 'MessageEntityCustomEmoji':
                    value = await self.emoji(entity.document_id, value)
                else:
                    value = self.esc(self.formatted_date(entity) or value)
                skip = end
            else:
                value = self.esc(raw[a * 2:b * 2].decode('utf-16-le', 'replace'))
            for _, _, entity in reversed(active):
                kind = self.kind(entity).replace('MessageEntity', '')
                tags = {'Bold': 'b', 'Italic': 'i', 'Underline': 'u', 'Strike': 's', 'Code': 'code'}
                if kind in tags:
                    value = f'<{tags[kind]}>{value}</{tags[kind]}>'
                elif kind == 'Spoiler':
                    value = f"""<span class="spoiler {('revealed' if self.options['spoilers'] else '')}">{value}</span>"""
                elif kind == 'Blockquote':
                    pass
                elif kind in ('Url', 'TextUrl', 'Mention', 'MentionName', 'Email', 'Phone', 'Hashtag', 'BotCommand', 'Cashtag'):
                    value = f'<span class="link">{value}</span>'
                elif kind.startswith('Diff'):
                    if kind == 'DiffReplace' and a == getattr(entity, 'offset', -1):
                        value = '<del>' + self.esc(getattr(entity, 'old_text', '')) + '</del>' + value
                    value = f"<{('del' if kind == 'DiffDelete' else 'ins')}>{value}</{('del' if kind == 'DiffDelete' else 'ins')}>"
                elif kind not in ('Pre', 'CustomEmoji', 'FormattedDate', 'BankCard'):
                    self.warn('entity_unsupported', entity)
            quote = next((s for s in active if self.kind(s[2]) == 'MessageEntityBlockquote'), None)
            if quote:
                if a == quote[0]:
                    collapsed = getattr(quote[2], 'collapsed', False) and (not self.options['expanded'])
                    if collapsed:
                        preview = ' '.join(raw[quote[0] * 2:quote[1] * 2].decode('utf-16-le', 'replace').split())
                        if len(preview) > 512:
                            preview = preview[:512].rstrip() + '…'
                        value = '<details><summary>' + self.esc(preview or self.label('Цитата', 'Quote')) + '</summary>' + value
                    else:
                        value = '<blockquote>' + value
                if (skip if special else b) >= quote[1]:
                    value += '</details>' if getattr(quote[2], 'collapsed', False) and (not self.options['expanded']) else '</blockquote>'
            result.append(value)
        return ''.join(result)

    async def rich_text(self, item, depth=0):
        if depth > 24:
            raise _GQuoteError('rich_depth_limit')
        if item is None:
            return ''
        if isinstance(item, str):
            return self.esc(item)
        kind = self.kind(item)
        if kind == 'TextPlain':
            return self.esc(item.text)
        if kind == 'TextEmpty':
            return ''
        if kind == 'TextConcat':
            return ''.join([await self.rich_text(x, depth + 1) for x in item.texts])
        if kind == 'TextCustomEmoji':
            return await self.emoji(getattr(item, 'document_id', None), getattr(item, 'alt', '⭐'))
        if kind == 'TextImage':
            return await self.image(self.documents.get(item.document_id), 'emoji')
        if kind == 'TextMath':
            return self.formula(getattr(item, 'source', ''))
        value = await self.rich_text(getattr(item, 'text', ''), depth + 1)
        tags = {'TextBold': 'b', 'TextItalic': 'i', 'TextUnderline': 'u', 'TextStrike': 's', 'TextFixed': 'code', 'TextSubscript': 'sub', 'TextSuperscript': 'sup', 'TextMarked': 'mark'}
        if kind in tags:
            return f'<{tags[kind]}>{value}</{tags[kind]}>'
        if kind == 'TextSpoiler':
            return f"""<span class="spoiler {('revealed' if self.options['spoilers'] else '')}">{value}</span>"""
        if kind in ('TextUrl', 'TextAutoUrl', 'TextEmail', 'TextAutoEmail', 'TextPhone', 'TextAutoPhone', 'TextMention', 'TextMentionName', 'TextHashtag', 'TextCashtag', 'TextBotCommand'):
            return f'<span class="link">{value}</span>'
        if kind == 'TextDiff':
            return '<del>' + await self.rich_text(getattr(item, 'old_text', ''), depth + 1) + '</del><ins>' + value + '</ins>'
        if kind in ('TextAnchor', 'TextBankCard'):
            return value
        if kind == 'TextDate':
            return self.esc(self.formatted_date(item)) or value
        self.warn('rich_text_unsupported', item)
        return value or self.notice(kind)

    def plain(self, value, depth=0):
        if depth > 24 or value is None:
            return ''
        if isinstance(value, str):
            return value
        if hasattr(value, 'texts'):
            return ''.join((self.plain(x, depth + 1) for x in value.texts))
        return self.plain(getattr(value, 'text', ''), depth + 1)

    async def blocks(self, blocks, depth=0):
        if depth > 20:
            raise _GQuoteError('block_depth_limit')
        result = []
        for block in blocks or []:
            self.block_count += 1
            if self.block_count > 2000:
                raise _GQuoteError('block_count_limit')
            kind = self.kind(block).replace('PageBlock', '')
            self.state['element'] = self.kind(block)
            text = await self.rich_text(getattr(block, 'text', None))
            caption = getattr(block, 'caption', None)
            cap = await self.rich_text(getattr(caption, 'text', caption)) if caption else ''
            if kind in ('Paragraph', 'Footer', 'Kicker', 'AuthorDate'):
                result.append('<p>' + (text or self.esc(getattr(block, 'author', ''))) + '</p>')
            elif kind in ('Title', 'Header', 'Subtitle', 'Subheader') or kind.startswith('Heading'):
                level = kind[-1] if kind[-1:].isdigit() else '2'
                result.append(f'<h{level}>{text}</h{level}>')
            elif kind == 'Preformatted':
                result.append(await self.code(self.plain(block.text), getattr(block, 'language', ''), rich=True))
            elif kind == 'Divider':
                result.append('<hr>')
            elif kind == 'ButtonRow':
                buttons = []
                for button in getattr(block, 'buttons', []) or []:
                    label = await self.rich_text(getattr(button, 'text', None))
                    if not label:
                        continue
                    style = getattr(button, 'style', None)
                    color = next((name for name in ('primary', 'danger', 'success') if getattr(style, 'bg_' + name, False)), '')
                    icon_id = getattr(style, 'icon', None)
                    icon = await self.emoji(icon_id) + ' ' if icon_id else ''
                    button_kind = self.kind(getattr(button, 'type', None))
                    button_type = 'switch' if button_kind == 'InlineButtonTypeSwitchInline' else 'url' if button_kind in ('InlineButtonTypeUrl', 'InlineButtonTypeWebView') else ''
                    buttons.append('<span class="button" data-button-style="' + color + '" data-button-type="' + button_type + '">' + icon + label + '</span>')
                if buttons:
                    align = next((name for name in ('left', 'center', 'right') if getattr(block, 'align_' + name, False)), 'left')
                    result.append(f'<div class="buttons rich-buttons" data-align="{align}">' + ''.join(buttons) + '</div>')
            elif kind == 'Anchor':
                continue
            elif kind in ('Blockquote', 'Pullquote'):
                result.append('<blockquote>' + text + ('<small>' + cap + '</small>' if cap else '') + '</blockquote>')
            elif kind in ('Details', 'Thinking', 'BlockquoteBlocks'):
                title = await self.rich_text(getattr(block, 'title', None))
                inner = await self.blocks(getattr(block, 'blocks', []), depth + 1)
                if kind == 'Thinking':
                    inner = text
                if kind == 'BlockquoteBlocks':
                    result.append('<blockquote>' + inner + '</blockquote>')
                else:
                    expanded = bool(self.options['expanded'] or getattr(block, 'open', False))
                    result.append(f"<details{(' open' if expanded else '')}><summary>{title or self.label('Подробности', 'Details')}</summary>{inner}</details>")
            elif kind in ('List', 'OrderedList'):
                tag = 'ol' if kind == 'OrderedList' else 'ul'
                items = []
                for item in getattr(block, 'items', []):
                    inner = await self.blocks(item.blocks, depth + 1) if hasattr(item, 'blocks') else await self.rich_text(getattr(item, 'text', item))
                    number = getattr(item, 'num', None)
                    attr = f' value="{int(number)}"' if str(number).isdigit() else ''
                    items.append('<li' + attr + '>' + inner + '</li>')
                result.append(f'<{tag}>' + ''.join(items) + f'</{tag}>')
            elif kind == 'Table':
                rows = []
                for row in getattr(block, 'rows', []):
                    cells = []
                    for cell in row.cells:
                        tag = 'th' if getattr(cell, 'header', False) else 'td'
                        align = 'center' if getattr(cell, 'align_center', False) else 'right' if getattr(cell, 'align_right', False) else 'left'
                        cells.append(f'''<{tag} colspan="{max(1, min(100, getattr(cell, 'colspan', 1) or 1))}" rowspan="{max(1, min(100, getattr(cell, 'rowspan', 1) or 1))}" style="text-align:{align}">''' + await self.rich_text(getattr(cell, 'text', None)) + f'</{tag}>')
                    rows.append('<tr>' + ''.join(cells) + '</tr>')
                title = await self.rich_text(getattr(block, 'title', None))
                flags = ' '.join((name for name in ('bordered', 'striped', 'compact') if getattr(block, name, False)))
                result.append((f'<h4>{title}</h4>' if title else '') + f"<table{(' ' + flags if flags else '')}>" + ''.join(rows) + '</table>')
            elif kind in ('Photo', 'Video', 'Audio', 'Document'):
                identity = next((getattr(block, key) for key in ('photo_id', 'video_id', 'audio_id', 'document_id') if getattr(block, key, None)), None)
                media = self.documents.get(identity) or self.photos.get(identity)
                visual = await self.document(media) if self.kind(media) == 'Document' else await self.image(media)
                if getattr(block, 'spoiler', False):
                    reveal = ' revealed' if self.options['spoilers'] else ''
                    visual = f'<div class="media-spoiler{reveal}">{visual}</div>'
                result.append(visual + '<div class="caption">' + cap + '</div>')
            elif kind == 'Collage':
                result.append('<div class="grid">' + await self.blocks(getattr(block, 'items', []), depth + 1) + '</div>' + cap)
            elif kind == 'Slideshow':
                items = getattr(block, 'items', []) or []
                if items:
                    result.append(await self.blocks(items[:1], depth + 1) + f'<small>1 / {len(items)}</small>' + cap)
            elif kind == 'Cover':
                result.append(await self.blocks([block.cover], depth + 1))
            elif kind == 'Channel':
                channel = getattr(block, 'channel', None)
                name = self.esc(getattr(channel, 'title', None) or getattr(channel, 'username', None) or self.label('Канал', 'Channel'))
                username = getattr(channel, 'username', None)
                handle = f' <span class="link">@{self.esc(username)}</span>' if username else ''
                result.append(f'<blockquote><b>{name}</b>{handle}</blockquote>')
            elif kind == 'RelatedArticles':
                title = await self.rich_text(getattr(block, 'title', None))
                articles = []
                for article in getattr(block, 'articles', []) or []:
                    name = self.esc(getattr(article, 'title', None) or getattr(article, 'url', None) or self.label('Статья', 'Article'))
                    description = self.esc(getattr(article, 'description', None) or '')
                    articles.append('<li><span class="link">' + name + '</span>' + (f' — {description}' if description else '') + '</li>')
                result.append((f'<h4>{title}</h4>' if title else '') + '<ul>' + ''.join(articles) + '</ul>')
            elif kind == 'Math':
                result.append(self.formula(getattr(block, 'source', ''), True))
            elif kind == 'Map':
                result.append(self.geo(getattr(block, 'geo', None)) + cap)
            elif kind in ('Embed', 'EmbedPost'):
                result.append(self.notice(getattr(block, 'url', '') or kind) + cap)
                if hasattr(block, 'blocks'):
                    result.append(await self.blocks(block.blocks, depth + 1))
                self.warn('external_embed_static', block)
            else:
                self.warn('block_unsupported', block)
                result.append(self.notice(kind) + text + cap)
        return ''.join(result)

    @staticmethod
    def size(value):
        value = float(value or 0)
        for suffix in ('B', 'KB', 'MB', 'GB', 'TB'):
            if value < 1024 or suffix == 'TB':
                return f'{value:.1f} {suffix}'
            value /= 1024

    def attachment(self, title, subtitle, icon=None, waveform=''):
        disc = '<div class="disc document-icon"></div>' if icon is None else '<div class="disc">' + self.esc(icon) + '</div>'
        return f'<div class="attachment">{disc}<div><div class="attachment-title">{self.esc(title)}</div>{waveform}<div class="attachment-subtitle">{self.esc(subtitle)}</div></div></div>'

_QUOTE_DEFAULTS = dict(theme='dark', background=False, background_mode='transparent', background_url='', dates=True, tags=True, avatars=True, reactions=True, spoilers=True, expanded=False, width=720, scale=2, compact=True, gift_colors=True, bubble_outline=True, bubble_transparency=0, link_preview_position='bottom', composition='balanced', send_format='sticker')

_QUOTE_FONTS = {}
_QUOTE_RENDER_LOCK = threading.Lock()


def _quote_modules():
    global Image, ImageDraw, ImageFont, ImageColor, ImageOps, features, regex
    from PIL import Image, ImageDraw, ImageFont, ImageColor, ImageOps, features
    import regex


class _QuoteValue:
    def __init__(self, value):
        self._raw = value
        for key, item in value.items():
            if key != '_':
                converted = datetime.fromtimestamp(item, timezone.utc) if key in ('date', 'until_date') and isinstance(item, (int, float)) else _quote_value(item)
                setattr(self, key, converted)

    def __eq__(self, other):
        return isinstance(other, _QuoteValue) and self._raw == other._raw

    def __repr__(self):
        return repr(self._raw)


class _GQuoteError(GodChatError):
    pass


def _quote_value(value):
    if isinstance(value, dict):
        return _QuoteValue(value)
    if isinstance(value, list):
        return [_quote_value(item) for item in value]
    return value


class _QuotePainter(BalancedPainter):
    def checkpoint(self, stage, **details):
        self.stage = stage

    def font(self, style):
        size = max(8, min(48, style.get('size', 16)))
        family = style.get('family') or ('mono' if style.get('mono') else 'bolditalic' if style.get('bold') and style.get('italic') else 'bold' if style.get('bold') else 'italic' if style.get('italic') else 'regular')
        key = family, size, self.scale, bool(style.get('bold')) if family in ('cjk', 'hangul') else False
        if key not in self.fonts:
            data = self.p['fonts'].get(family) or self.p['fonts']['regular']
            self.fonts[key] = ImageFont.truetype(io.BytesIO(data), round(size * self.scale))
            if family in ('cjk', 'hangul'):
                try:
                    self.fonts[key].set_variation_by_axes([700 if style.get('bold') else 400])
                except (OSError, ValueError):
                    pass
        return self.fonts[key]

    def cached_image(self, key, producer):
        if key not in self.images:
            image = producer().convert('RGBA')
            if image.width * image.height > 4_500_000:
                raise ValueError('decoded_image_limit')
            self.image_bytes += image.width * image.height * 4
            if self.image_bytes > 48 * 1024 * 1024:
                raise ValueError('decoded_cache_limit')
            self.images[key] = image
        return self.images[key]

    def asset(self, node, size, color):
        identity = node.a.get('src') or node.a.get('data-fallback')
        data = self.p.get('assets', {}).get(identity)
        if not data:
            return None
        def produce():
            with Image.open(io.BytesIO(data)) as source:
                if source.width * source.height > 24_000_000:
                    raise ValueError('image_pixels_limit')
                side = min(2048, max(32, round(size * self.scale)))
                source.thumbnail((side, side))
                image = source.convert('RGBA')
            if node.a.get('data-tint'):
                tint = Image.new('RGBA', image.size, color)
                tint.putalpha(image.getchannel('A'))
                image = tint
            return image
        try:
            return self.cached_image((identity, round(size * self.scale), color if node.a.get('data-tint') else ''), produce)
        except Exception as exc:
            self.warn('asset_decode_fallback', exc)
            return None

    def emoji(self, text, size):
        data = self.p['fonts'].get('emoji')
        if not data:
            return None
        def produce():
            font = ImageFont.truetype(io.BytesIO(data), 109)
            left, top, right, bottom = font.getbbox(text)
            image = Image.new('RGBA', (max(1, right - left), max(1, bottom - top)))
            ImageDraw.Draw(image).text((-left, -top), text, font=font, embedded_color=True)
            if not image.getchannel('A').getbbox():
                raise ValueError('emoji_glyph_missing')
            return image
        try:
            return self.cached_image(('emoji', text), produce)
        except Exception as exc:
            self.warn('unicode_emoji_fallback', exc)
            return None

    def render(self, markup):
        layout, breaks = self.layout(markup)
        maxheight = min(4000, 24000000 // (self.width * self.scale ** 2))
        maxpages = 24
        if layout.h > maxheight * maxpages:
            raise ValueError('output_pages_limit')
        paths = []
        offset = 0
        total = 0
        while offset < layout.h:
            if len(paths) >= maxpages:
                raise ValueError('output_pages_limit')
            end = min(offset + maxheight, math.ceil(layout.h))
            if end < layout.h:
                candidates = [b for b in breaks if offset + maxheight / 2 < b <= end]
                if candidates:
                    end = math.ceil(max(candidates))
            self.checkpoint('paint_page')
            output_scale = self.scale
            output_size = (self.width * output_scale, round((end - offset) * output_scale))
            aa = 2 if output_size[0] * output_size[1] <= 2000000 else 1
            name = f'page-{len(paths) + 1}.png'
            stream = io.BytesIO()
            while True:
                canvas = None
                try:
                    canvas = Image.new('RGBA', (output_size[0] * aa, output_size[1] * aa), self.bg if self.options['background'] else (0, 0, 0, 0))
                    wallpaper = self.p.get('wallpaper')
                    if wallpaper:
                        from PIL import ImageOps
                        with Image.open(io.BytesIO(wallpaper)) as source:
                            with ImageOps.fit(source.convert('RGBA'), canvas.size, method=Image.Resampling.LANCZOS) as fitted:
                                canvas.alpha_composite(fitted)
                    self.scale = output_scale * aa
                    for op in layout.ops:
                        if op[2] > end:
                            continue
                        self.paint(canvas, op, offset)
                    if self.options['background']:
                        opaque = canvas.convert('RGB')
                        canvas.close()
                        canvas = opaque
                    if aa > 1:
                        reduced = canvas.resize(output_size, Image.Resampling.LANCZOS)
                        canvas.close()
                        canvas = reduced
                    canvas.save(stream, format='PNG')
                    break
                except MemoryError:
                    if aa == 1:
                        raise
                    if canvas is not None:
                        canvas.close()
                        canvas = None
                    self.fonts.clear()
                    self.glyphs.clear()
                    import gc
                    gc.collect()
                    self.warn('antialias_memory_fallback')
                    aa = 1
                finally:
                    self.scale = output_scale
                    if canvas is not None:
                        canvas.close()
            total += len(stream.getvalue())
            if total > 64 * 1024 * 1024:
                raise ValueError('output_bytes_limit')
            paths.append(stream.getvalue())
            offset = end
        return paths


async def _quote_fonts(ctx, markup=''):
    base = 'https://raw.githubusercontent.com/notofonts/noto-fonts/ffebf8c1ee449e544955a7e813c54f9b73848eac/hinted/ttf/'
    names = {'regular': 'NotoSans/NotoSans-Regular.ttf', 'bold': 'NotoSans/NotoSans-Bold.ttf', 'italic': 'NotoSans/NotoSans-Italic.ttf', 'bolditalic': 'NotoSans/NotoSans-BoldItalic.ttf', 'mono': 'NotoSansMono/NotoSansMono-Regular.ttf', 'symbols': 'NotoSansSymbols/NotoSansSymbols-Regular.ttf'}
    text = html.unescape(markup)
    selected = {}
    async def load(family, url, required=False):
        try:
            if family not in _QUOTE_FONTS:
                response = await ctx.cap('net', dict(url=url, binary=True, max_bytes=24 * 1024 * 1024, timeout=40))
                if not isinstance(response, dict) or response.get('status') != 200 or response.get('truncated'):
                    raise GodChatError('Font download failed: ' + family)
                data = base64.b64decode(response['body'], validate=True)
                if not data:
                    raise GodChatError('Empty font: ' + family)
                ImageFont.truetype(io.BytesIO(data), 109 if family == 'emoji' else 16)
                _QUOTE_FONTS[family] = data
            selected[family] = _QUOTE_FONTS[family]
        except asyncio.CancelledError:
            raise
        except Exception as exc:
            await ctx.cap('logs', dict(op='write', level='warning', msg='GodChat quote font=' + family + ' unavailable: ' + type(exc).__name__))
            if required:
                raise GodChatError('Cannot load quote font: ' + family) from exc
    for family, filename in names.items():
        if family != 'symbols':
            await load(family, base + filename, required=True)
    await load('symbols', 'https://raw.githubusercontent.com/matplotlib/matplotlib/v3.10.7/lib/matplotlib/mpl-data/fonts/ttf/DejaVuSans.ttf')
    if 'symbols' not in selected:
        await load('symbols', base + names['symbols'])
    scripts = _QuoteMarkupOriginal.SCRIPT_FONTS
    serif = _QuoteMarkupOriginal.SERIF_FONTS
    for family, script in (*scripts.items(), *serif.items()):
        if regex.search(r'\p{Script=' + script + '}', text):
            name = ('NotoSerif' if family in serif else 'NotoSans') + script
            await load(family, base + name + '/' + name + '-Regular.ttf')
    for family, (name, pattern) in _QuoteMarkupOriginal.EXTRA_FONTS.items():
        if re.search(pattern, text):
            await load(family, base + name + '/' + name + '-Regular.ttf')
    if re.search(r'[\u2200-\u22ff\u27c0-\u27ef\u2980-\u2aff\U0001d400-\U0001d7ff]', text):
        await load('math', base + 'NotoSansMath/NotoSansMath-Regular.ttf')
    if re.search(r'[\u2100-\u2bff\U0001d100-\U0001d1ff\U0001f000-\U0001f0ff]', text):
        await load('symbols2', base + 'NotoSansSymbols2/NotoSansSymbols2-Regular.ttf')
    if re.search(r'[\u2e80-\u9fff\uf900-\ufaff\uff00-\uffef\U00020000-\U0003134f]', text):
        await load('cjk', 'https://raw.githubusercontent.com/google/fonts/66a36c8c94b1a5d992ee4e7f392fccfe4945767c/ofl/notosansjp/NotoSansJP%5Bwght%5D.ttf')
    if re.search(r'[\u1100-\u11ff\u3130-\u318f\uac00-\ud7ff]', text):
        await load('hangul', 'https://raw.githubusercontent.com/google/fonts/66a36c8c94b1a5d992ee4e7f392fccfe4945767c/ofl/notosanskr/NotoSansKR%5Bwght%5D.ttf')
    await load('emoji', 'https://raw.githubusercontent.com/googlefonts/noto-emoji/v2.051/fonts/NotoColorEmoji.ttf')
    while sum(len(data) for data in _QUOTE_FONTS.values()) > 64 * 1024 * 1024:
        oldest = next(iter(_QUOTE_FONTS))
        del _QUOTE_FONTS[oldest]
    return selected


class _QuoteMarkupOriginal(_QuoteMarkupBase):
    SCRIPT_FONTS = {'tailue' if name == 'NewTaiLue' else name.lower(): name for name in 'Adlam AnatolianHieroglyphs Arabic Armenian Avestan Balinese Bamum BassaVah Batak Bengali Bhaiksuki Brahmi Buginese Buhid CanadianAboriginal Carian CaucasianAlbanian Chakma Cham Cherokee Chorasmian Coptic Cuneiform Cypriot CyproMinoan Deseret Devanagari Duployan EgyptianHieroglyphs Elbasan Elymaic Ethiopic Georgian Glagolitic Gothic Grantha Gujarati GunjalaGondi Gurmukhi HanifiRohingya Hanunoo Hatran Hebrew ImperialAramaic InscriptionalPahlavi InscriptionalParthian Javanese Kaithi Kannada KayahLi Kharoshthi Khmer Khojki Khudawadi Lao Lepcha Limbu LinearA LinearB Lisu Lycian Lydian Mahajani Malayalam Mandaic Manichaean Marchen MasaramGondi Medefaidrin MeeteiMayek MendeKikakui Miao Modi Mongolian Mro Multani Myanmar NKo Nabataean Nandinagari NewTaiLue Newa Nushu Ogham OlChiki OldHungarian OldItalic OldNorthArabian OldPermic OldPersian OldSogdian OldSouthArabian OldTurkic Oriya Osage Osmanya PahawhHmong Palmyrene PauCinHau PhagsPa Phoenician PsalterPahlavi Rejang Runic Samaritan Saurashtra Sharada Shavian Siddham SignWriting Sinhala Sogdian SoraSompeng Soyombo Sundanese SylotiNagri Syriac Tagalog Tagbanwa TaiLe TaiTham TaiViet Takri Tamil Tangsa Telugu Thaana Thai Tifinagh Tirhuta Ugaritic Vai Vithkuqi Wancho WarangCiti Yi ZanabazarSquare'.split()}
    SERIF_FONTS = {name.lower(): name for name in 'Ahom DivesAkuru Dogra Makasar NyiakengPuachueHmong OldUyghur Tangut Tibetan Toto Yezidi'.split()}
    EXTRA_FONTS = {'meroitic': ('NotoSansMeroitic', '[\\U00010980-\\U000109ff]'), 'indicsiyaq': ('NotoSansIndicSiyaqNumbers', '[\\U0001ec70-\\U0001ecbf]'), 'mayan': ('NotoSansMayanNumerals', '[\\U0001d2e0-\\U0001d2ff]'), 'tamilsupplement': ('NotoSansTamilSupplement', '[\\U00011fc0-\\U00011fff]')}
    MAX_PIXELS = 24000000
    PEER_COLORS = ('#ef7777', '#d99c58', '#af8add', '#70b87c', '#6dbcc5', '#76a8e6', '#d883b1')
    CSS = ''

    @staticmethod
    def color(value, default='#79b8e8'):
        return f'#{int(value) & 16777215:06x}' if isinstance(value, int) else default

    @staticmethod
    def username(peer):
        return getattr(peer, 'username', None) or next((item.username for item in getattr(peer, 'usernames', None) or [] if getattr(item, 'active', False) and getattr(item, 'username', None)), None)

    def name(self, peer):
        getter = getattr(self.module, '_custom_name', None)
        custom = getter(peer) if callable(getter) else None
        if custom:
            return custom
        return getattr(peer, 'title', None) or ' '.join(filter(None, (getattr(peer, 'first_name', None), getattr(peer, 'last_name', None)))) or self.username(peer) or 'Deleted account'

    @staticmethod
    def _image_bytes(data):
        from PIL import Image, ImageOps
        with Image.open(io.BytesIO(data)) as image:
            if image.width * image.height > _QuoteMarkupOriginal.MAX_PIXELS:
                raise _GQuoteError('image_pixels_limit')
            image = ImageOps.exif_transpose(image)
            image.thumbnail((2048, 2048))
            out = io.BytesIO()
            image.convert('RGBA').save(out, format='PNG')
            return (out.getvalue(), '.png')

    async def pattern(self, document=None, identity=None, color='#ffffff'):
        if not document and identity:
            try:
                docs = await asyncio.wait_for(self.module.client(_QUOTE_REQUESTS.messages.GetCustomEmojiDocumentsRequest([identity])), 20)
                document = next(iter(docs), None)
            except Exception as error:
                self.warn('pattern_unavailable', error=error)
        if not document:
            return ''
        return f'<div class="pattern-overlay" data-pattern-color="{color}">' + await self.image(document, 'pattern-source') + '</div>'

    def local_date(self, date):
        return date.astimezone(getattr(self, 'quote_timezone', None))

    def formatted_date(self, item):
        date = getattr(item, 'date', None)
        if not hasattr(date, 'strftime'):
            return ''
        date = self.local_date(date)
        parts = []
        if getattr(item, 'day_of_week', False):
            days = ('Понедельник', 'Вторник', 'Среда', 'Четверг', 'Пятница', 'Суббота', 'Воскресенье') if self.ru else ('Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday', 'Sunday')
            parts.append(days[date.weekday()])
        if getattr(item, 'long_date', False) or getattr(item, 'short_date', False):
            parts.append(date.strftime('%d.%m.%Y'))
        if getattr(item, 'long_time', False) or getattr(item, 'short_time', False):
            parts.append(date.strftime('%H:%M:%S' if getattr(item, 'long_time', False) else '%H:%M'))
        if getattr(item, 'relative', False):
            self.warn('relative_date_absolute', item)
        return ' '.join(parts) or date.strftime('%d.%m.%Y %H:%M')

    async def document(self, doc):
        if not doc:
            self.warn('document_missing')
            return self.notice(self.label('Файл недоступен', 'File unavailable'))
        attrs = {self.kind(a): a for a in getattr(doc, 'attributes', [])}
        filename = getattr(attrs.get('DocumentAttributeFilename'), 'file_name', 'File')
        audio = attrs.get('DocumentAttributeAudio')
        video = attrs.get('DocumentAttributeVideo')
        mime = getattr(doc, 'mime_type', '') or ''
        if 'DocumentAttributeSticker' in attrs or 'DocumentAttributeCustomEmoji' in attrs:
            return await self.image(doc, 'sticker')
        if audio:
            duration = int(getattr(audio, 'duration', 0) or 0)
            wave = getattr(audio, 'waveform', None)
            waveform = ''
            if wave:
                bits = int.from_bytes(wave, 'little')
                values = [bits >> i & 31 for i in range(0, len(wave) * 8 - 4, 5)]
                step = max(1, math.ceil(len(values) / 64))
                waveform = '<div class="wave">' + ''.join((f'<i style="height:{max(3, v)}px"></i>' for v in values[::step])) + '</div>'
            title = self.label('Голосовое сообщение', 'Voice message') if getattr(audio, 'voice', False) else getattr(audio, 'title', None) or filename
            performer = getattr(audio, 'performer', '') or ''
            return self.attachment(title, f'{performer} {duration // 60}:{duration % 60:02}', '▶', waveform)
        if video or mime.startswith('video/') or mime == 'image/gif':
            animated = 'DocumentAttributeAnimated' in attrs or mime == 'image/gif'
            thumbs = [t for t in getattr(doc, 'thumbs', []) or [] if getattr(t, 'w', 0) and getattr(t, 'h', 0)]
            thumb = max(thumbs, key=lambda t: t.w * t.h) if thumbs else None
            image = await self.image(doc, 'media round' if getattr(video, 'round_message', False) else 'media', thumb)
            duration = int(getattr(video, 'duration', 0) or 0)
            label = 'GIF' if animated else f'{duration // 60}:{duration % 60:02} · {self.size(doc.size)}'
            return f'''<div class="video-card" data-width="{getattr(video, 'w', 0)}" data-height="{getattr(video, 'h', 0)}" data-gif="{int(animated)}" data-label="{self.esc(label)}">{image}</div>'''
        if mime.startswith('image/'):
            return await self.image(doc)
        thumb = await self.image(doc, 'media', -1) if getattr(doc, 'thumbs', None) else ''
        return thumb + self.attachment(filename, self.size(getattr(doc, 'size', 0)))

    def geo(self, media):
        geo = getattr(media, 'geo', None)
        if not geo:
            return self.notice(self.label('Геопозиция недоступна', 'Location unavailable'))
        title = getattr(media, 'title', None) or (self.label('Геопозиция в реальном времени', 'Live location') if self.kind(media) == 'MessageMediaGeoLive' else self.label('Геопозиция', 'Location'))
        address = getattr(media, 'address', None) or ''
        try:
            lat, lon = (float(geo.lat), float(geo.long))
            coords = f'{lat:.5f}, {lon:.5f}' if math.isfinite(lat) and math.isfinite(lon) else ''
        except (AttributeError, TypeError, ValueError):
            coords = ''
        fields = (('geo-title', title), ('geo-address', address), ('geo-coords', coords))
        return '<div class="geo-card">' + ''.join((f'<div class="{kind}">{self.esc(value)}</div>' for kind, value in fields if value)) + '</div>'

    async def giveaway(self, media, results=False):
        count = int(getattr(media, 'winners_count' if results else 'quantity', 0) or 0)
        stars = int(getattr(media, 'stars', 0) or 0)
        months = int(getattr(media, 'months', 0) or 0)
        if stars:
            prize = self.label(f'{count} победителей · {stars:,} звёзд', f'{count} winners · {stars:,} Stars').replace(',', ' ')
        elif months:
            prize = self.label(f'{count} победителей · Premium на {months} мес.', f'{count} winners · {months} months Premium')
        else:
            prize = self.label(f'{count} победителей', f'{count} winners')
        description = str(getattr(media, 'prize_description', None) or '').strip()
        if len(description) > 180:
            description = description[:179].rstrip() + '…'
        channel_ids = [getattr(media, 'channel_id', None)] if results else getattr(media, 'channels', None) or []
        channel_names = []
        for channel_id in channel_ids[:3]:
            if not channel_id:
                continue
            identity = _QUOTE_TYPES.PeerChannel(channel_id)
            try:
                peer = await asyncio.wait_for(self.peer(identity), 3)
                channel_names.append(self.name(peer))
            except Exception as error:
                self.warn('giveaway_channel_unavailable', media, error)
        if len(channel_ids) > 3:
            channel_names.append(self.label(f'и ещё {len(channel_ids) - 3}', f'and {len(channel_ids) - 3} more'))
        participants = self.label('Участники: ', 'Participants: ') + ', '.join(channel_names) if channel_names else ''
        if getattr(media, 'only_new_subscribers', False):
            restriction = self.label('Только новые подписчики', 'New subscribers only')
            participants = participants + ' · ' + restriction if participants else restriction
        countries = []
        country_names = {'RU': ('Россия', 'Russia'), 'BY': ('Беларусь', 'Belarus'), 'UZ': ('Узбекистан', 'Uzbekistan'), 'KZ': ('Казахстан', 'Kazakhstan'), 'AE': ('ОАЭ', 'UAE'), 'UA': ('Украина', 'Ukraine'), 'US': ('США', 'USA'), 'GB': ('Великобритания', 'UK')}
        country_codes = getattr(media, 'countries_iso2', None) or []
        for code in country_codes[:5]:
            code = str(code).upper()
            if len(code) == 2 and code.isalpha() and code.isascii():
                flag = ''.join((chr(127462 + ord(char) - ord('A')) for char in code))
                name = country_names.get(code, (code, code))[0 if self.ru else 1]
                countries.append(f'{flag} {name}')
        if len(country_codes) > 5:
            countries.append(f'+{len(country_codes) - 5}')
        until = getattr(media, 'until_date', None)
        date = ''
        if hasattr(until, 'strftime'):
            date = self.label('Итоги: ', 'Results: ') + self.local_date(until).strftime('%d.%m.%Y %H:%M')
        fields = (('giveaway-title', self.label('Результаты розыгрыша', 'Giveaway results') if results else self.label('Розыгрыш призов', 'Prize giveaway')), ('giveaway-prize', prize), ('giveaway-description', description), ('giveaway-channels', participants), ('giveaway-countries', ' · '.join(countries)), ('giveaway-date', date))
        return '<div class="giveaway">' + ''.join((f'<div class="{kind}">{self.esc(value)}</div>' for kind, value in fields if value)) + '</div>'

    async def media(self, media):
        kind = self.kind(media)
        self.state['element'] = kind
        if media is None or kind == 'MessageMediaEmpty':
            return ''
        if kind == 'MessageMediaPhoto':
            value = await self.image(getattr(media, 'photo', None))
        elif kind == 'MessageMediaDocument':
            value = await self.document(getattr(media, 'document', None))
        elif kind == 'MessageMediaWebPage':
            page = media.webpage
            value = '<blockquote><b>' + self.esc(getattr(page, 'site_name', '')) + '</b><div>' + self.esc(getattr(page, 'title', '')) + '</div>' + self.esc(getattr(page, 'description', ''))
            if getattr(page, 'photo', None):
                value += await self.image(page.photo)
            value += '</blockquote>'
        elif kind == 'MessageMediaPoll':
            poll, results = (media.poll, media.results)
            question = getattr(poll.question, 'text', poll.question)
            value = '<b>' + await self.entities(question, getattr(poll.question, 'entities', [])) + '</b>'
            total = getattr(results, 'total_voters', 0) or 0
            counts = {r.option: r for r in getattr(results, 'results', []) or []}
            for answer in poll.answers:
                item = counts.get(answer.option)
                votes = getattr(item, 'voters', 0) or 0
                text = getattr(answer.text, 'text', answer.text)
                rendered = await self.entities(text, getattr(answer.text, 'entities', []))
                percent = round(votes * 100 / total) if total else 0
                value += '<div class="poll-option">' + ('✓ ' if getattr(item, 'chosen', False) else '') + rendered
                if item is not None:
                    value += f' · {percent}%<div class="poll-bar" style="width:{percent}%"></div>'
                value += '</div>'
            value += '<div class="caption">' + self.label(f'Голосов: {total}', f'Votes: {total}') + '</div>'
        elif kind == 'MessageMediaContact':
            getter = getattr(self.module, '_custom_name', None)
            custom = getter(SimpleNamespace(id=getattr(media, 'user_id', None))) if callable(getter) else None
            value = self.attachment(custom or f'{media.first_name} {media.last_name}', media.phone_number, '☎')
        elif kind in ('MessageMediaGeo', 'MessageMediaGeoLive', 'MessageMediaVenue'):
            value = self.geo(media)
        elif kind == 'MessageMediaDice':
            value = self.attachment(media.emoticon, str(media.value), media.emoticon)
            self.warn('dice_static_value', media)
        elif kind == 'MessageMediaToDo':
            todo = media.todo
            completions = {item.id: item for item in getattr(media, 'completions', []) or [] if getattr(item, 'completed_by', None)}
            items = getattr(todo, 'list', []) or []
            title = getattr(todo, 'title', None)
            value = '<div class="todo-card"><div class="todo-title">' + await self.entities(getattr(title, 'text', title) or '', getattr(title, 'entities', []) or []) + '</div>'
            value += '<div class="todo-label">' + self.label('Список задач', 'To-do list') + '</div>'
            for item in items:
                item_title = getattr(item, 'title', None)
                done = item.id in completions
                body = await self.entities(getattr(item_title, 'text', item_title) or '', getattr(item_title, 'entities', []) or [])
                value += f'<div class="todo-item" data-done="{int(done)}"><div class="todo-text">{body}</div>'
                if done:
                    try:
                        peer = await asyncio.wait_for(self.peer(completions[item.id].completed_by), 3)
                        value += '<div class="todo-by">' + self.esc(self.name(peer)) + '</div>'
                    except Exception as error:
                        self.warn('todo_completer_unavailable', media, error)
                value += '</div>'
            done_count = sum((item.id in completions for item in items))
            value += '<div class="todo-progress">' + self.label(f'{done_count} из {len(items)} выполнено', f'{done_count} of {len(items)} completed') + '</div></div>'
        elif kind == 'MessageMediaGame':
            value = self.attachment(media.game.title, media.game.description, '🎮')
            if getattr(media.game, 'photo', None):
                value += await self.image(media.game.photo)
        elif kind == 'MessageMediaInvoice':
            value = self.attachment(media.title, f'{media.description} · {media.total_amount} {media.currency}', '🧾')
            self.warn('invoice_raw_amount', media)
        elif kind == 'MessageMediaPaidMedia':
            parts = []
            for item in getattr(media, 'extended_media', []):
                parts.append(await self.media(item.media) if getattr(item, 'media', None) else self.notice(self.label('Платное медиа: предпросмотр недоступен', 'Paid media: preview unavailable')))
            value = ''.join(parts)
        elif kind == 'MessageMediaStory':
            story = getattr(media, 'story', None)
            if not story or not getattr(story, 'media', None):
                result = await asyncio.wait_for(self.module.client(_QUOTE_REQUESTS.stories.GetStoriesByIDRequest(peer=media.peer, id=[media.id])), 20)
                story = next(iter(getattr(result, 'stories', [])), None)
            if story and getattr(story, 'media', None):
                value = await self.media(story.media) + await self.entities(getattr(story, 'caption', ''), getattr(story, 'entities', []))
            else:
                self.warn('story_unavailable', media)
                value = self.notice(self.label('История недоступна', 'Story unavailable'))
        elif kind in ('MessageMediaGiveaway', 'MessageMediaGiveawayResults'):
            value = await self.giveaway(media, kind == 'MessageMediaGiveawayResults')
        elif kind == 'MessageMediaVideoStream':
            value = self.attachment(self.label('Прямая трансляция', 'Live stream'), '', '▶')
        else:
            self.warn('media_type_unsupported', media)
            value = self.notice(kind)
        if getattr(media, 'spoiler', False):
            value = f"""<div class="media-spoiler {('revealed' if self.options['spoilers'] else '')}">{value}</div>"""
        return value

    async def todo_source(self, message):
        info = getattr(message, 'reply_to', None)
        msg_id = getattr(info, 'reply_to_msg_id', None)
        if not msg_id:
            return None
        peer = getattr(info, 'reply_to_peer_id', None) or message.peer_id
        key = (str(peer), msg_id)
        if key not in self.replies:
            result = await asyncio.wait_for(self.module.client.get_messages(peer, ids=msg_id), 5)
            self.replies[key] = next((item for item in result if item), None) if isinstance(result, (list, tuple)) else result
        return self.replies[key]

    async def action(self, action, actor=None, message=None):
        kind = self.kind(action)
        if kind == 'MessageActionTodoCompletions':
            titles = {}
            if message:
                try:
                    source = await self.todo_source(message)
                    todo = getattr(getattr(source, 'media', None), 'todo', None)
                    titles = {item.id: getattr(item.title, 'text', item.title) for item in getattr(todo, 'list', []) or []}
                except Exception as error:
                    self.warn('todo_source_unavailable', action, error)
            parts = []
            for ids, ru, en in ((getattr(action, 'completed', []) or [], 'отметил(а) как выполненное', 'completed'), (getattr(action, 'incompleted', []) or [], 'снял(а) отметку выполнения', 'unchecked')):
                if ids:
                    names = [f"«{titles.get(item_id) or self.label(f'задача №{item_id}', f'task #{item_id}')}»" for item_id in ids]
                    parts.append(self.label(ru, en) + ' ' + ', '.join(names))
            if parts:
                return '<div class="service"><b>' + self.esc(actor or self.label('Участник', 'Member')) + '</b> ' + self.esc('; '.join(parts)) + '</div>'
        if kind == 'MessageActionTodoAppendTasks':
            items = []
            for item in getattr(action, 'list', []) or []:
                title = getattr(item, 'title', None)
                items.append(getattr(title, 'text', title) or self.label('задачу', 'a task'))
            return '<div class="service"><b>' + self.esc(actor or self.label('Участник', 'Member')) + '</b> ' + self.esc(self.label('добавил(а) задачи: ', 'added tasks: ') + ', '.join(map(str, items))) + '</div>'
        if kind == 'MessageActionBoostApply':
            title = self.label('проголосовал(а) за группу', 'boosted the group')
            boosts = getattr(action, 'boosts', 1)
            if isinstance(boosts, int) and boosts > 1:
                title += f' · {boosts}'
            return '<div class="service"><b>' + self.esc(actor or self.label('Участник', 'Member')) + '</b> ' + self.esc(title) + '</div>'
        if kind in ('MessageActionStarGift', 'MessageActionStarGiftUnique'):
            gift = action.gift
            attrs = {self.kind(a): a for a in getattr(gift, 'attributes', [])}
            backdrop = attrs.get('StarGiftAttributeBackdrop') or getattr(gift, 'background', None)
            style = ''
            if backdrop:
                style = f"background:radial-gradient(circle,{self.color(getattr(backdrop, 'center_color', None))},{self.color(getattr(backdrop, 'edge_color', None))});color:{self.color(getattr(backdrop, 'text_color', None), '#ffffff')}"
            model = attrs.get('StarGiftAttributeModel')
            doc = getattr(model, 'document', None) or getattr(gift, 'sticker', None)
            title = getattr(gift, 'title', None) or self.label('Подарок', 'Gift')
            number = getattr(gift, 'num', None)
            pattern = attrs.get('StarGiftAttributePattern')
            pattern_html = await self.pattern(getattr(pattern, 'document', None), color=self.color(getattr(backdrop, 'pattern_color', None))) if pattern else ''
            result = f'<div class="gift" style="{style}">' + pattern_html + await self.image(doc, 'sticker') + '<h3>' + self.esc(title) + (f' #{number}' if number else '') + '</h3>'
            for key in ('StarGiftAttributeModel', 'StarGiftAttributePattern', 'StarGiftAttributeBackdrop'):
                if key in attrs:
                    result += '<div>' + self.esc(getattr(attrs[key], 'name', '')) + '</div>'
            result += '</div>'
            text = getattr(action, 'message', None)
            if text:
                result += await self.entities(text.text, text.entities)
            return result
        labels = {'MessageActionPinMessage': ('Закреплённое сообщение', 'Pinned message'), 'MessageActionPhoneCall': ('Звонок', 'Call'), 'MessageActionChatJoinedByLink': ('Вступление по ссылке', 'Joined by link'), 'MessageActionChatJoinedByRequest': ('Заявка на вступление принята', 'Join request approved'), 'MessageActionChatAddUser': ('Добавлены участники', 'Members added'), 'MessageActionChatDeleteUser': ('Участник вышел или удалён', 'Member left or removed'), 'MessageActionGiftPremium': ('Подарок Telegram Premium', 'Telegram Premium gift'), 'MessageActionGiftCode': ('Подарочный код Premium', 'Premium gift code'), 'MessageActionGiftTon': ('Подарок TON', 'TON gift'), 'MessageActionGroupCall': ('Групповой звонок', 'Group call'), 'MessageActionGroupCallScheduled': ('Запланирован звонок', 'Scheduled call'), 'MessageActionTopicEdit': ('Изменён топик', 'Topic edited'), 'MessageActionSetChatTheme': ('Изменена тема чата', 'Chat theme changed'), 'MessageActionSetChatWallPaper': ('Изменён фон чата', 'Chat wallpaper changed'), 'MessageActionHistoryClear': ('История очищена', 'History cleared'), 'MessageActionScreenshotTaken': ('Сделан снимок экрана', 'Screenshot taken'), 'MessageActionContactSignUp': ('Контакт присоединился к Telegram', 'Contact joined Telegram'), 'MessageActionChatCreate': ('Создан чат', 'Chat created'), 'MessageActionChannelCreate': ('Создан канал', 'Channel created'), 'MessageActionGiftStars': ('Подарок Telegram Stars', 'Telegram Stars gift'), 'MessageActionSetMessagesTTL': ('Изменён таймер удаления', 'Auto-delete timer changed'), 'MessageActionChatEditTitle': ('Изменено название чата', 'Chat title changed'), 'MessageActionChatEditPhoto': ('Изменена фотография чата', 'Chat photo changed'), 'MessageActionTopicCreate': ('Создан топик', 'Topic created')}
        if kind not in labels:
            self.warn('service_unsupported', action)
        title = self.label(*labels[kind]) if kind in labels else self.label('Служебное сообщение', 'Service message')
        parts = [getattr(action, name, None) for name in ('title', 'duration', 'months', 'stars', 'period')]
        rendered = '<div class="service">' + self.esc(title) + '<br>' + self.esc(' · '.join((str(x) for x in parts if x is not None))) + '</div>'
        if getattr(action, 'message', None) and hasattr(action.message, 'text'):
            rendered += await self.entities(action.message.text, action.message.entities)
        if getattr(action, 'photo', None):
            rendered += await self.image(action.photo)
        return rendered

    async def refresh_avatar_peer(self, identity, sender, retry=False):
        key = str(identity)
        now = time.monotonic()
        if not retry and now < self.avatar_refresh_after.get(key, 0):
            return sender
        self.avatar_refresh_after[key] = now + 15
        if len(self.avatar_refresh_after) > 512:
            self.avatar_refresh_after = {peer_key: expires for peer_key, expires in self.avatar_refresh_after.items() if expires > now}
            if len(self.avatar_refresh_after) > 512:
                self.avatar_refresh_after = dict(list(self.avatar_refresh_after.items())[-512:])
        client = self.module.client
        try:
            forced = getattr(client, 'force_get_entity', None)
            if callable(forced):
                fresh = await asyncio.wait_for(forced(identity), 5)
            else:
                fresh = await asyncio.wait_for(client.get_entity(identity, force=True), 5)
        except (TypeError, asyncio.TimeoutError):
            return sender
        except Exception:
            return sender
        if fresh is not None:
            self.peers[key] = fresh
            return fresh
        return sender

    def accent_colors(self, palette, accent, collectible=True):
        colors = None
        if self.kind(palette) == 'PeerColorCollectible' and collectible:
            colors = getattr(palette, 'dark_colors', None) if self.options['theme'] == 'dark' else None
            colors = colors or getattr(palette, 'colors', None)
        elif getattr(palette, 'color', None) is not None:
            colors = self.palettes.get(palette.color)
        return ','.join((self.color(c, accent) for c in colors[:3])) if colors else accent

    @staticmethod
    def short_quote_name(name):
        import regex
        parts = regex.findall('\\X', name)
        return ''.join(parts[:15]) + '..' if len(parts) > 15 else name

    async def author(self, message, via=None):
        sender = None
        identity = getattr(message, 'from_id', None) or message.peer_id
        try:
            sender = await self.peer(identity)
        except Exception as error:
            self.warn('sender_unavailable', message, error)
        if self.options['avatars'] and self.kind(sender) == 'User' and (not getattr(sender, 'photo', None)):
            sender = await self.refresh_avatar_peer(identity, sender)
        name = getattr(message, 'display_name', None) or self.name(sender)
        shown_name = self.short_quote_name(name)
        palette = getattr(sender, 'color', None)
        fallback = self.PEER_COLORS
        accent = fallback[abs(getattr(sender, 'id', 0)) % len(fallback)]
        if getattr(palette, 'color', None) is not None:
            identity = palette.color
            if identity in self.palettes:
                colors = self.palettes[identity]
                accent = self.color(colors[0]) if colors else accent
            elif 0 <= identity < len(fallback):
                accent = fallback[identity]
            else:
                self.warn('peer_palette_missing', palette)
        avatar = ''
        if self.options['avatars'] and sender:
            for attempt in range(2):
                if not getattr(sender, 'photo', None):
                    break
                try:
                    key = f"avatar:{sender.id}:{getattr(sender.photo, 'photo_id', 0)}"

                    async def get():
                        data = await asyncio.wait_for(self.module.client.download_profile_photo(sender, bytes, download_big=False), 20)
                        if not data:
                            raise _GQuoteError('avatar_empty')
                        return await _quote_sync(self._image_bytes, data)
                    path = await self._cache_asset(key, get)
                    avatar = f'<img class="avatar" src="{path}">'
                    break
                except Exception as error:
                    if attempt == 0:
                        fresh = await self.refresh_avatar_peer(identity, sender, retry=True)
                        if fresh is not sender and getattr(fresh, 'photo', None):
                            sender = fresh
                            continue
                    self.warn('avatar_unavailable', sender, error)
                    break
        if self.options['avatars'] and (not avatar):
            avatar = '<div class="initials">' + self.esc(name[:1]) + '</div>'
        status = getattr(sender, 'emoji_status', None)
        display_status = getattr(message, 'display_status', None)
        if display_status is None:
            status_html = await self.emoji(getattr(status, 'document_id', None)) if status else '<span class="premium">★</span>' if getattr(sender, 'premium', False) else ''
        elif isinstance(display_status, int) and (not isinstance(display_status, bool)):
            status_html = await self.emoji(display_status)
        elif isinstance(display_status, str):
            status_html = '<span class="emoji-status">' + self.esc(display_status) + '</span>'
        elif isinstance(display_status, dict):
            status_html = await self.image(display_status.get('document'), 'emoji')
        elif display_status is False:
            status_html = ''
        rank = getattr(message, 'from_rank', None) or getattr(message, 'post_author', None)
        role = 'user'
        if self.options['tags'] and sender and getattr(message, 'is_group', False):
            try:
                key = (str(message.peer_id), sender.id)
                if key not in self.ranks:
                    permissions = await asyncio.wait_for(self.module.client.get_permissions(message.peer_id, sender), 15)
                    resolved_role = 'owner' if permissions.is_creator else 'admin' if permissions.is_admin else 'user'
                    resolved_rank = getattr(getattr(permissions, 'participant', None), 'rank', None) or (self.label('Владелец', 'Owner') if permissions.is_creator else self.label('Админ', 'Admin') if permissions.is_admin else '')
                    self.ranks[key] = (resolved_rank, resolved_role)
                resolved_rank, role = self.ranks[key]
                rank = rank or resolved_rank
            except Exception as error:
                self.warn('rank_unavailable', message, error)
        if getattr(message, 'display_role', None):
            role = message.display_role
        if getattr(message, 'display_rank', None) is not None:
            rank = message.display_rank
        quote_colors = self.accent_colors(palette, accent, self.options.get('gift_colors', True))
        quote_accent = None
        if self.options.get('gift_colors', True):
            quote_accent = getattr(palette, 'dark_accent_color', None) if self.options['theme'] == 'dark' else None
            if quote_accent is None:
                quote_accent = getattr(palette, 'accent_color', None)
        quote_accent = self.color(quote_accent, accent)
        header = '<div class="author" data-quote-colors="' + quote_colors + '" data-quote-accent="' + quote_accent + '"><span class="name">' + self.esc(shown_name) + '</span>'
        header += status_html
        if rank and self.options['tags']:
            header += ' <span class="rank" data-role="' + role + '">' + self.esc(rank) + '</span>'
        if via:
            header += ' <span class="via-inline">' + self.esc(via) + '</span>'
        header += '</div>'
        return (avatar, header, accent)

    async def reply(self, message):
        info = getattr(message, 'reply_to', None)
        if not info:
            return ''
        if getattr(info, 'forum_topic', False) and (not getattr(info, 'quote_text', None)) and (getattr(info, 'reply_to_msg_id', None) == getattr(info, 'reply_to_top_id', None)):
            return ''
        source = None
        try:
            peer = getattr(info, 'reply_to_peer_id', None) or message.peer_id
            key = (str(peer), getattr(info, 'reply_to_msg_id', None))
            if key[1]:
                if key not in self.replies:
                    result = await asyncio.wait_for(self.module.client.get_messages(peer, ids=key[1]), 20)
                    self.replies[key] = next((x for x in result if x), None) if isinstance(result, (list, tuple)) else result
                source = self.replies[key]
            name = self.label('Ответ', 'Reply')
            if source:
                sender = await self.peer(getattr(source, 'from_id', None) or source.peer_id)
                name = getattr(source, 'display_name', None) or self.name(sender)
            else:
                sender = None
            reply_author = self.esc(self.short_quote_name(name))
            forwarded = getattr(source, 'fwd_from', None)
            if forwarded:
                forwarded_name = getattr(forwarded, 'from_name', None) or getattr(forwarded, 'post_author', None)
                getter = getattr(self.module, '_custom_name', None)
                if callable(getter) and getattr(forwarded, 'from_id', None):
                    forwarded_name = getter(forwarded.from_id) or forwarded_name
                if not forwarded_name and getattr(forwarded, 'from_id', None):
                    try:
                        forwarded_name = self.name(await self.peer(forwarded.from_id))
                    except Exception as error:
                        self.warn('reply_forward_sender_unavailable', forwarded, error)
                if forwarded_name:
                    reply_author += ' <span class="reply-forward"><span class="reply-forward-icon"></span> ' + self.esc(forwarded_name) + '</span>'
            quote = getattr(info, 'quote_text', None)
            text = quote if quote is not None else getattr(source, 'message', None)
            entities = getattr(info, 'quote_entities', []) if quote is not None else getattr(source, 'entities', [])
            if text is None:
                text = '' if source else self.label('Сообщение недоступно', 'Message unavailable')
            body = await self.entities(text, entities)
            document = getattr(getattr(source, 'media', None), 'document', None)
            sticker_attr = next((a for a in getattr(document, 'attributes', []) or [] if self.kind(a) == 'DocumentAttributeSticker'), None)
            sticker = sticker_attr is not None
            if not text and quote is None and source:
                media = getattr(source, 'media', None)
                document = getattr(media, 'document', None)
                if document:
                    filename = next((a.file_name for a in getattr(document, 'attributes', []) if self.kind(a) == 'DocumentAttributeFilename'), None)
                    label = self.label('Стикер', 'Sticker') if sticker else filename or self.label('Файл', 'File')
                    if sticker and getattr(sticker_attr, 'alt', None):
                        label += ' ' + sticker_attr.alt
                    body = '<span class="reply-media">' + ('' if sticker else '<span class="reply-file-icon"></span> ') + self.esc(label) + '</span>'
                elif getattr(media, 'photo', None):
                    body = '<span class="reply-media">' + self.label('Фото', 'Photo') + '</span>'
                else:
                    body = self.esc(self.label('Сообщение', 'Message'))
            palette = getattr(sender, 'color', None)
            reply_accent = getattr(palette, 'dark_accent_color', None) if self.options['theme'] == 'dark' else None
            reply_accent = reply_accent if reply_accent is not None else getattr(palette, 'accent_color', None)
            palette_id = getattr(palette, 'color', None)
            if reply_accent is None and self.palettes.get(palette_id):
                reply_accent = self.palettes[palette_id][0]
            ordinary_id = palette_id if isinstance(palette_id, int) and 0 <= palette_id < len(self.PEER_COLORS) else abs(getattr(sender, 'id', 0)) % len(self.PEER_COLORS)
            reply_color = self.color(reply_accent, self.PEER_COLORS[ordinary_id] if sender else '#79b8e8')
            pattern = await self.pattern(identity=getattr(palette, 'background_emoji_id', None), color=reply_color)
            gift_id = getattr(palette, 'gift_emoji_id', None)
            gift_image = await self.emoji(gift_id, alt='') if gift_id else ''
            if gift_id and (not gift_image):
                self.warn('reply_gift_unavailable', palette)
            gift = '<div class="reply-gift">' + gift_image + '</div>' if gift_image else ''
            thumbnail = ''
            photo = getattr(getattr(source, 'media', None), 'photo', None)
            if photo:
                thumbnail = await self.image(photo, 'reply-thumb')
            if not thumbnail:
                document = getattr(getattr(source, 'media', None), 'document', None)
                if sticker:
                    thumbnail = await self.image(document, 'reply-thumb reply-sticker')
                elif getattr(document, 'thumbs', None):
                    thumbnail = await self.image(document, 'reply-thumb', -1)
            quote_colors = self.accent_colors(palette, reply_color)
            return '<div class="reply"' + (' data-reply-sticker="1"' if sticker else '') + ' style="--accent:' + reply_color + '" data-quote-colors="' + quote_colors + '">' + pattern + gift + thumbnail + '<div class="reply-content"><div class="reply-author">' + reply_author + '</div><div class="reply-text">' + body + '</div></div></div>'
        except Exception as error:
            self.warn('reply_unavailable', info, error)
            return self.notice(self.label('Ответ: сообщение недоступно', 'Reply: message unavailable'))

    async def _original_message(self, message, grouped=False):
        self.state['message_id'] = message.id
        self.state['element'] = 'Message'
        action = getattr(message, 'action', None)
        if action and self.kind(action) not in ('MessageActionStarGift', 'MessageActionStarGiftUnique'):
            actor = None
            try:
                actor = self.name(await self.peer(getattr(message, 'from_id', None) or getattr(message, 'sender_id', None)))
            except Exception as error:
                self.warn('service_sender_unavailable', action, error)
            return f'<div class="service-row" data-message="{message.id}">' + await self.action(action, actor, message) + '</div>'
        prefix = ''
        forwarded = getattr(message, 'fwd_from', None)
        if forwarded:
            name = getattr(forwarded, 'from_name', None) or getattr(forwarded, 'post_author', None)
            getter = getattr(self.module, '_custom_name', None)
            if callable(getter) and getattr(forwarded, 'from_id', None):
                name = getter(forwarded.from_id) or name
            if not name and getattr(forwarded, 'from_id', None):
                try:
                    name = self.name(await self.peer(forwarded.from_id))
                except Exception as error:
                    self.warn('forward_sender_unavailable', forwarded, error)
            prefix += '<div class="forward">' + self.label('Переслано от ', 'Forwarded from ') + self.esc(name or self.label('скрытый автор', 'hidden sender')) + '</div>'
        bot = getattr(message, 'via_bot_id', None) or getattr(message, 'via_business_bot_id', None)
        via = getattr(message, 'display_via', None)
        if bot:
            try:
                bot_peer = await self.peer(bot)
                username = self.username(bot_peer)
                via = self.label('через ', 'via ') + ('@' + username if username else self.name(bot_peer))
            except Exception as error:
                self.warn('bot_unavailable', message, error)
        avatar, header, accent = await self.author(message, via=via)
        reply = await self.reply(message)
        rich = getattr(message, 'rich_message', None)
        rich_placeholder = self.kind(getattr(message, 'media', None)) == 'MessageMediaUnsupported'
        rich_suspected = rich_placeholder or bool(not getattr(message, 'message', None) and getattr(message, 'media', None) is None and (not getattr(message, 'action', None)))
        if rich and getattr(rich, 'part', False) or (rich_suspected and (not rich)):
            failure = None
            for method in ('rich', 'message'):
                try:
                    if method == 'rich':
                        result = await asyncio.wait_for(self.module.client(_QUOTE_REQUESTS.messages.GetRichMessageRequest(message.peer_id, message.id)), 20)
                        full = next((m for m in getattr(result, 'messages', []) or [] if getattr(m, 'id', None) == message.id), None)
                    else:
                        result = await asyncio.wait_for(self.module.client.get_messages(message.peer_id, ids=message.id), 20)
                        full = next((m for m in result if getattr(m, 'id', None) == message.id), None) if isinstance(result, (list, tuple)) else result
                    candidate = getattr(full, 'rich_message', None)
                    if candidate and getattr(candidate, 'blocks', None):
                        rich = candidate
                        if not getattr(rich, 'part', False):
                            break
                except Exception as error:
                    failure = error
            if not rich or not getattr(rich, 'blocks', None):
                if rich_placeholder:
                    self.warn('rich_message_unavailable', message, failure)
                rich = None
            elif getattr(rich, 'part', False):
                self.warn('rich_message_partial', message, failure)
        if rich:
            self.documents.update({d.id: d for d in getattr(rich, 'documents', []) or []})
            self.photos.update({p.id: p for p in getattr(rich, 'photos', []) or []})
            body = '<div class="rich"' + (' dir="rtl"' if getattr(rich, 'rtl', False) else '') + '>' + await self.blocks(rich.blocks) + '</div>'
        elif getattr(message, 'action', None):
            body = await self.action(message.action)
        elif rich_placeholder:
            body = self.notice(self.label('Rich-сообщение недоступно', 'Rich message unavailable'))
        else:
            text = '<div class="body" dir="auto">' + await self.entities(getattr(message, 'message', ''), getattr(message, 'entities', [])) + '</div>'
            message_media = getattr(message, 'media', None)
            media = await self.media(message_media)
            if self.kind(message_media) == 'MessageMediaWebPage' and self.options.get('link_preview_position', 'bottom') == 'bottom':
                body = text + media
            else:
                body = media + text
        reactions = ''
        if self.options['reactions']:
            for entry in getattr(getattr(message, 'reactions', None), 'results', []) or []:
                reaction = entry.reaction
                emoji = await self.emoji(reaction.document_id) if hasattr(reaction, 'document_id') else self.esc(getattr(reaction, 'emoticon', '⭐'))
                reactions += f'<span class="reaction">{emoji} {entry.count}</span>'
        buttons = ''
        for row in getattr(getattr(message, 'reply_markup', None), 'rows', []) or []:
            buttons += '<div class="buttons">'
            for button in row.buttons:
                style = getattr(button, 'style', None)
                color = next((name for name in ('primary', 'danger', 'success') if getattr(style, 'bg_' + name, False)), '')
                icon_id = getattr(style, 'icon', None)
                icon = await self.emoji(icon_id) + ' ' if icon_id else ''
                buttons += '<span class="button" data-button-style="' + color + '">' + icon + self.esc(button.text) + '</span>'
            buttons += '</div>'
        metadata = []
        if getattr(message, 'views', None) is not None:
            metadata.append('<span class="views-icon"></span> ' + self.esc(str(message.views)))
        if getattr(message, 'pinned', False):
            metadata.append('<span class="pin-icon"></span>')
        if self.options['dates'] and getattr(message, 'date', None):
            metadata.append(self.esc(getattr(message, 'display_time', None) or self.local_date(message.date).strftime('%H:%M')))
        classes = 'row' + (' grouped' if grouped else '') + (' noavatar' if not self.options['avatars'] else '')
        return f'''<div class="{classes}" data-message="{message.id}" style="--accent:{accent}">{avatar}<div class="bubble">{header}{prefix}{reply}{body}<div class="reactions">{reactions}</div>{buttons}<div class="meta">{' · '.join(metadata)}</div></div></div>'''

    async def _original_build(self, state):
        self.state = state
        timezone_getter = getattr(self.module, '_quote_timezone', None)
        self.quote_timezone = timezone_getter() if callable(timezone_getter) else None
        self.options = state['options']
        self.ru = state['ru']
        self.documents, self.photos, self.animations = ({}, {}, {})
        self.animation_count = 0
        self.peers, self.replies, self.ranks, self.palettes = ({}, {}, {}, {})
        self.peers.update(state.get('resolved_peers', {}))
        self.replies.update(state.get('resolved_replies', {}))
        self.block_count = 0
        state['warnings'] = []
        state['stage'] = 'collect'
        await self._prime_emoji(state['messages'])
        try:
            response = await asyncio.wait_for(self.module.client(_QUOTE_REQUESTS.help.GetPeerColorsRequest(hash=0)), 15)
            for item in getattr(response, 'colors', []):
                palette = getattr(item, 'dark_colors', None) if self.options['theme'] == 'dark' else None
                palette = palette or getattr(item, 'colors', None)
                self.palettes[item.color_id] = getattr(palette, 'colors', [])
        except Exception as error:
            self.warn('palettes_unavailable', error=error)
        rows = []
        previous = None
        messages = [m for m in state['messages'] if m.id in state['selected']]
        album_ids = {getattr(m, 'grouped_id', None) for m in messages if getattr(m, 'grouped_id', None)}
        handled = set()
        for message in messages:
            if message.id not in state['selected']:
                continue
            if message.id in handled:
                continue
            date = getattr(message, 'date', None)
            prev_date = getattr(previous, 'date', None)
            grouped = bool(previous and getattr(previous, 'from_id', None) == getattr(message, 'from_id', None) and date and prev_date and ((date - prev_date).total_seconds() < 300) and (not getattr(message, 'reply_to', None)))
            if getattr(previous, 'action', None) or getattr(message, 'action', None):
                grouped = False
            if grouped and any((getattr(previous, field, None) != getattr(message, field, None) for field in ('via_bot_id', 'via_business_bot_id', 'out'))):
                grouped = False
            album_id = getattr(message, 'grouped_id', None)
            album = [m for m in messages if getattr(m, 'grouped_id', None) == album_id] if album_id in album_ids else []
            if len(album) > 1 and all((self.kind(getattr(m, 'media', None)) == 'MessageMediaPhoto' for m in album)):
                combined = copy.copy(message)
                combined.media = None
                combined.message = ''
                combined.entities = []
                base = await self._original_message(combined, grouped)
                photos = '<div class="grid">' + ''.join([await self.media(m.media) for m in album]) + '</div>'
                captions = ''.join(['<div class="body">' + await self.entities(getattr(m, 'message', ''), getattr(m, 'entities', [])) + '</div>' for m in album if getattr(m, 'message', None)])
                rows.append(base.replace('<div class="body" dir="auto"></div>', photos + captions, 1))
                handled.update((m.id for m in album))
            else:
                rows.append(await self._original_message(message, grouped))
            previous = message
        if not rows:
            raise _GQuoteError('no_selected_messages')
        css_class = self.options['theme'] + (' transparent' if not self.options['background'] else '')
        return '<!doctype html><meta charset="utf-8"><style>' + self.CSS + f'''</style><div id="quote" class="{css_class}" style="width:{self.options['width']}px">''' + ''.join(rows) + '</div>'

    async def _prime_emoji(self, messages):
        identities = set()
        visited = 0

        def visit(value, depth=0):
            nonlocal visited
            visited += 1
            if depth > 24 or visited > 12000 or value is None or isinstance(value, (str, int, float, bytes)):
                return
            if isinstance(value, (list, tuple)):
                for item in value:
                    visit(item, depth + 1)
                return
            if self.kind(value) in ('MessageEntityCustomEmoji', 'TextCustomEmoji', 'ReactionCustomEmoji'):
                identity = getattr(value, 'document_id', None)
                if identity:
                    identities.add(identity)
            if self.kind(value) == 'RichMessage':
                self.documents.update({d.id: d for d in getattr(value, 'documents', []) or []})
            for name in ('blocks', 'items', 'rows', 'cells', 'buttons', 'text', 'texts', 'caption', 'rich_message', 'entities', 'reaction', 'results', 'reactions', 'title'):
                child = getattr(value, name, None)
                if child is not None:
                    visit(child, depth + 1)
        visit(messages)
        missing = sorted(identities - self.documents.keys())
        for offset in range(0, len(missing), 80):
            try:
                docs = await asyncio.wait_for(self.module.client(_QUOTE_REQUESTS.messages.GetCustomEmojiDocumentsRequest(missing[offset:offset + 80])), 20)
                self.documents.update({d.id: d for d in docs})
            except Exception as error:
                self.warn('emoji_prefetch_failed', error=error)
                break

class _QuoteMarkup(_QuoteMarkupOriginal):
    def __init__(self, ctx, options):
        self.ctx, self.options = ctx, options
        self.ru = not str(getattr(getattr(ctx, 'i18n', None), 'language', 'ru')).startswith('en')
        self.assets, self.documents, self.photos, self.peers = {}, {}, {}, {}
        self.warnings, self.block_count, self.state = [], 0, {}
        self.asset_bytes = 0
        self.asset_cache = {}
        self.avatar_refresh_after = {}
        self.module = SimpleNamespace(client=_QuoteClient(self), _custom_name=self.custom_name, _quote_timezone=lambda: _tz(ctx))
        self.quote_timezone = _tz(ctx)
        self.replies, self.ranks, self.palettes = {}, {}, {}

    def custom_name(self, peer):
        raw = _quote_raw(peer)
        uid = _id(raw) if isinstance(raw, dict) else getattr(peer, 'id', None)
        return self.ctx.state.get('name_overrides', {}).get(str(uid), {}).get('name')

    async def peer(self, identity):
        key = str(identity)
        if key not in self.peers:
            raw = _quote_raw(identity)
            uid = _id(raw) if isinstance(raw, dict) else raw
            try:
                value = await _resolve(self.ctx, uid)
            except Exception:
                value = {'_': 'userEmpty', 'id': uid or 0, 'first_name': str(uid or 'Deleted account')}
            self.peers[key] = _quote_value(value)
        return self.peers[key]

    async def _cache_asset(self, key, producer):
        if key not in self.asset_cache:
            data, suffix = await producer()
            self.asset_cache[key] = self.store(data)
        return self.asset_cache[key]

    async def message(self, message, grouped=False):
        value = await self.prepare(message)
        return await self._original_message(value, grouped)

    async def prepare(self, message):
        raw = copy.deepcopy(message)
        raw.setdefault('peer_id', _quote_peer(self.ctx.chat_id))
        if not raw.get('from_id'):
            raw['from_id'] = _quote_peer(_id(await _me(self.ctx)) if raw.get('out') else self.ctx.chat_id)
        if not hasattr(self, 'chat_is_group'):
            self.chat_is_group = False
            if self.ctx.chat_id < 0:
                try:
                    chat = await _resolve(self.ctx, self.ctx.chat_id)
                    self.chat_is_group = chat.get('_') == 'chat' or bool(chat.get('megagroup'))
                except Exception:
                    self.chat_is_group = self.ctx.chat_id > -1000000000000
        raw.setdefault('is_group', self.chat_is_group)
        raw.setdefault('date', int(time.time()))
        raw.setdefault('id', 0)
        raw.setdefault('message', '')
        raw.setdefault('entities', [])
        if raw.get('quote_author'):
            raw['from_id'] = _quote_peer(_id(raw['quote_author']))
        result = _quote_value(raw)
        if isinstance(raw.get('display_status'), dict):
            result.display_status = {key: _quote_value(item) for key, item in raw['display_status'].items()}
        return result

    async def build(self, messages):
        values = [await self.prepare(message) for message in messages]
        lookup = {}
        replies = {}
        for value, raw in zip(values, messages):
            if raw.get('quote_entry'):
                value.id = -1000000 - raw['quote_entry']
                lookup[raw['quote_entry']] = value
        for value, raw in zip(values, messages):
            linked = lookup.get(raw.get('quote_reply_key'))
            manual = raw.get('quote_reply')
            if isinstance(manual, dict):
                linked = await self.prepare(dict(manual, id=-2000000 - raw['quote_entry'], date=raw.get('date', int(time.time()))))
            if linked:
                value.reply_to = _quote_value(dict(_='messageReplyHeader', reply_to_msg_id=linked.id))
                replies[str(value.peer_id), linked.id] = linked
        peers = {str(value.from_id): _quote_value(raw['quote_author']) for value, raw in zip(values, messages) if raw.get('quote_author')}
        for linked in replies.values():
            raw = linked._raw
            if raw.get('quote_author'):
                peers[str(linked.from_id)] = _quote_value(raw['quote_author'])
        state = dict(options=self.options, ru=self.ru, messages=values, selected={value.id for value in values}, resolved_peers=peers, resolved_replies=replies)
        return await self._original_build(state)

    @staticmethod
    def kind(value):
        name = value._raw.get('_', '') if isinstance(value, _QuoteValue) else ''
        return name[:1].upper() + name[1:]

    @staticmethod
    def esc(value):
        return _esc(value or '')

    def label(self, ru, en):
        return ru if self.ru else en

    def warn(self, code, obj=None, error=None):
        if code not in self.warnings:
            self.warnings.append(code)

    def notice(self, value):
        return '<div class="notice">' + self.esc(value) + '</div>'

    def formula(self, value, block=False):
        self.warn('math_as_text')
        return '<code>' + self.esc(self.plain(value)) + '</code>'



    def store(self, data):
        if len(data) > 8 * 1024 * 1024 or self.asset_bytes + len(data) > 24 * 1024 * 1024:
            raise GodChatError('Превышен лимит изображений цитаты.')
        identity = 'memory:' + hashlib.sha256(data).hexdigest()
        if identity not in self.assets:
            self.assets[identity] = data
            self.asset_bytes += len(data)
        return identity

    async def getfile(self, location, limit=8 * 1024 * 1024):
        data = bytearray()
        while len(data) <= limit:
            result = await _rpc(self.ctx, 'upload.getFile', dict(location=location, offset=len(data), limit=128 * 1024))
            chunk = result.get('bytes') if isinstance(result, dict) else None
            if not isinstance(chunk, bytes):
                raise GodChatError('Telegram не вернул файл для цитаты.')
            data.extend(chunk)
            if len(data) > limit:
                raise GodChatError('Файл для цитаты слишком большой.')
            if len(chunk) < 128 * 1024:
                return bytes(data)
        raise GodChatError('Файл для цитаты слишком большой.')

    async def image(self, value, css='media', thumb=None):
        raw = value._raw if isinstance(value, _QuoteValue) else value
        if not isinstance(raw, dict):
            return ''
        document = raw.get('_') == 'document'
        animated = document and (raw.get('mime_type') in ('application/x-tgsticker', 'video/webm', 'video/mp4') or any(attr.get('_') == 'documentAttributeVideo' for attr in raw.get('attributes', [])))
        try:
            if document and (animated or thumb):
                thumbs = [item for item in raw.get('thumbs', []) if item.get('type') and item.get('_') not in ('photoStrippedSize', 'photoPathSize')]
                if not thumbs:
                    self.warn('animated_media_thumbnail_unavailable')
                    return self.notice(self.label('Анимированное медиа', 'Animated media')) if css != 'emoji' else ''
                location = dict(_='inputDocumentFileLocation', id=raw['id'], access_hash=raw['access_hash'], file_reference=raw.get('file_reference', b''), thumb_size=max(thumbs, key=lambda item: item.get('w', 0) * item.get('h', 0))['type'])
                data = await self.getfile(location)
                if animated:
                    self.warn('animated_media_thumbnail')
            else:
                data = await _download(self.ctx, {'media': {'document' if document else 'photo': raw}}, limit=8 * 1024 * 1024)
            data, suffix = self._image_bytes(data)
            identity = self.store(data)
            custom = next((attr for attr in raw.get('attributes', []) if attr.get('_') in ('documentAttributeCustomEmoji', 'documentAttributeSticker')), {})
            extra = ' data-document="' + self.esc(raw.get('id')) + '" data-alt="' + self.esc(custom.get('alt') or '◇') + '"'
            if custom.get('text_color'):
                extra += ' data-tint="1"'
            return '<img class="' + css + '" src="' + identity + '"' + extra + '>'
        except asyncio.CancelledError:
            raise
        except Exception:
            self.warn('image_unavailable')
            return '' if css in ('avatar', 'emoji') else self.notice(self.label('Изображение недоступно', 'Image unavailable'))

    async def emoji(self, identity, alt='⭐'):
        try:
            if identity not in self.documents:
                response = await _rpc(self.ctx, 'messages.getCustomEmojiDocuments', {'document_id': [int(identity)]})
                documents = response if isinstance(response, list) else response.get('documents', [])
                for document in documents:
                    self.documents[document['id']] = _quote_value(document)
            image = await self.image(self.documents.get(identity), 'emoji')
            if image:
                return image
        except asyncio.CancelledError:
            raise
        except Exception:
            pass
        self.warn('custom_emoji_fallback')
        return self.esc(alt)







async def _quote_upload(ctx, data, filename, sticker=False, size=None, photo=False):
    identity = secrets.randbits(63)
    chunk = 128 * 1024
    parts = (len(data) + chunk - 1) // chunk
    for index in range(parts):
        result = await _rpc(ctx, 'upload.saveFilePart', dict(file_id=identity, file_part=index, bytes=data[index * chunk:(index + 1) * chunk]))
        if result is not True:
            raise GodChatError('Telegram не подтвердил загрузку цитаты.')
    attrs = [dict(_='documentAttributeFilename', file_name=filename)]
    if sticker:
        attrs += [dict(_='documentAttributeSticker', alt='', stickerset={'_': 'inputStickerSetEmpty'}), dict(_='documentAttributeImageSize', w=size[0], h=size[1])]
    media = dict(_='inputMediaUploadedDocument', file=dict(_='inputFile', id=identity, parts=parts, name=filename, md5_checksum=hashlib.md5(data).hexdigest()), mime_type='image/webp' if sticker else 'image/png', attributes=attrs, force_file=not sticker)
    if photo:
        media = dict(_='inputMediaUploadedPhoto', file=media['file'])
    request = dict(peer=await _input(ctx, ctx.chat_id), media=media, message='', random_id=secrets.randbits(63))
    await _rpc(ctx, 'messages.sendMedia', request)


async def _quote_pack_document(ctx, data, size):
    identity = secrets.randbits(63)
    chunk = 128 * 1024
    parts = (len(data) + chunk - 1) // chunk
    for index in range(parts):
        if await _rpc(ctx, 'upload.saveFilePart', dict(file_id=identity, file_part=index, bytes=data[index * chunk:(index + 1) * chunk])) is not True:
            raise GodChatError('Telegram не подтвердил загрузку стикера.')
    media = dict(_='inputMediaUploadedDocument', file=dict(_='inputFile', id=identity, parts=parts, name='quote.webp', md5_checksum=hashlib.md5(data).hexdigest()), mime_type='image/webp', attributes=[dict(_='documentAttributeFilename', file_name='quote.webp'), dict(_='documentAttributeImageSize', w=size[0], h=size[1]), dict(_='documentAttributeSticker', alt='💬', stickerset={'_': 'inputStickerSetEmpty'})])
    result = await _rpc(ctx, 'messages.uploadMedia', dict(peer={'_': 'inputPeerSelf'}, media=media))
    document = result.get('document') or {}
    if not document.get('id') or document.get('access_hash') is None:
        raise GodChatError('Telegram не вернул загруженный стикер.')
    return dict(_='inputDocument', id=document['id'], access_hash=document['access_hash'], file_reference=document.get('file_reference') or b'')


async def _quote_pack_connect(ctx, chat, value):
    match = re.fullmatch(r'(?:https?://)?(?:t\.me/addstickers/)?([A-Za-z0-9_]{1,64})/?', value.strip())
    if not match:
        raise GodChatError('Укажи ссылку t.me/addstickers/… или короткое имя пака.')
    result = await _rpc(ctx, 'messages.getStickerSet', dict(stickerset=dict(_='inputStickerSetShortName', short_name=match[1]), hash=0))
    pack = result.get('set') or {}
    if not pack.get('creator') or pack.get('masks') or pack.get('emojis') or pack.get('animated') or pack.get('videos'):
        raise GodChatError('Нужен собственный обычный пак статичных стикеров.')
    if pack.get('count', 0) >= 120:
        raise GodChatError('В паке уже 120 стикеров. Выбери другой пак.')
    _save(ctx, 'quote_packs', chat, dict(short_name=pack.get('short_name') or match[1], enabled=False))


async def _quote_pack_create(ctx, chat):
    _quote_modules()
    image = Image.new('RGBA', (512, 512), (0, 0, 0, 0))
    try:
        draw = ImageDraw.Draw(image)
        draw.rounded_rectangle((24, 110, 488, 402), radius=64, fill='#323a40', outline='#b47aa2', width=6)
        fonts = await _quote_fonts(ctx, 'GodChat')
        font = ImageFont.truetype(io.BytesIO(fonts['bold']), 62)
        draw.text((256, 250), 'GodChat', font=font, anchor='mm', fill='#f2f3f5')
        out = io.BytesIO()
        image.save(out, 'WEBP', lossless=True, method=4)
        document = await _quote_pack_document(ctx, out.getvalue(), image.size)
    finally:
        image.close()
    entity = await _resolve(ctx, chat)
    short_name = 'godchat_' + str(abs(chat)) + '_' + secrets.token_hex(5)
    await _rpc(ctx, 'stickers.createStickerSet', dict(user_id={'_': 'inputUserSelf'}, title=(_name(ctx, entity)[:40] + ' · цитаты')[:64], short_name=short_name, stickers=[dict(_='inputStickerSetItem', document=document, emoji='💬')], software='GodChat'))
    _save(ctx, 'quote_packs', chat, dict(short_name=short_name, enabled=False))


async def _quote_pack_append(ctx, pages):
    pack = ctx.state.get('quote_packs', {}).get(str(ctx.chat_id))
    if not pack or not pack.get('enabled'):
        return
    try:
        reference = dict(_='inputStickerSetShortName', short_name=pack['short_name'])
        result = await _rpc(ctx, 'messages.getStickerSet', dict(stickerset=reference, hash=0))
        info = result.get('set') or {}
        if info.get('count', 0) >= 120 or not info.get('creator'):
            pack['enabled'] = False
            _save(ctx, 'quote_packs', ctx.chat_id, pack)
            raise GodChatError('Автодобавление выключено: пак заполнен или недоступен для изменения.')
        data, size = _quote_sticker_bytes(pages)
        document = await _quote_pack_document(ctx, data, size)
        await _rpc(ctx, 'stickers.addStickerToSet', dict(stickerset=reference, sticker=dict(_='inputStickerSetItem', document=document, emoji='💬')))
    except asyncio.CancelledError:
        raise
    except Exception as exc:
        await ctx.cap('logs', dict(op='write', level='warning', msg='GodChat quote pack failed: ' + str(exc)[:250]))


def _quote_options(ctx):
    stored = ctx.state.get('quote_options', {})
    options = dict(_QUOTE_DEFAULTS)
    for key, default in _QUOTE_DEFAULTS.items():
        value = stored.get(key)
        if isinstance(default, bool) and isinstance(value, bool):
            options[key] = value
    if stored.get('theme') in ('dark', 'light'):
        options['theme'] = stored['theme']
    if stored.get('send_format') in ('sticker', 'png', 'photo'):
        options['send_format'] = stored['send_format']
    if stored.get('background_mode') in ('transparent', 'dark', 'light', 'custom'):
        options['background_mode'] = stored['background_mode']
        options['background'] = options['background_mode'] != 'transparent'
    if isinstance(stored.get('background_url'), str):
        options['background_url'] = stored['background_url']
    if stored.get('link_preview_position') in ('top', 'bottom'):
        options['link_preview_position'] = stored['link_preview_position']
    transparency = stored.get('bubble_transparency')
    if isinstance(transparency, int) and not isinstance(transparency, bool) and 0 <= transparency <= 100 and transparency % 5 == 0:
        options['bubble_transparency'] = transparency
    options.update(width=720, scale=2, sticker=False)
    return options


_QUOTE_ACTIVITY = contextvars.ContextVar('godchat_quote_activity', default=False)


def _quote_sent_id(result):
    if not isinstance(result, dict):
        return None
    if result.get('_', '').lower() == 'updateshortsentmessage':
        return result.get('id')
    for update in result.get('updates') or []:
        if not isinstance(update, dict):
            continue
        message = update.get('message')
        if isinstance(message, dict) and message.get('id'):
            return message['id']
        if update.get('_', '').lower() == 'updatemessageid':
            return update.get('id')
    return result.get('id') if isinstance(result.get('id'), int) else None


@asynccontextmanager
async def _quote_activity(ctx):
    if _QUOTE_ACTIVITY.get():
        yield
        return
    token = _QUOTE_ACTIVITY.set(True)
    message_id = None
    try:
        text = '<tg-emoji emoji-id="5447421246172069841">📄</tg-emoji> Создаю цитату…'
        message_id = _quote_sent_id(await _send(ctx, ctx.chat_id, text))
        yield
    finally:
        _QUOTE_ACTIVITY.reset(token)
        if message_id:
            try:
                await _delete(ctx, ctx.chat_id, [message_id])
            except Exception as exc:
                await ctx.cap('logs', dict(op='write', level='warning', msg='GodChat quote status cleanup failed: ' + str(exc)[:200]))


def _quote_working(handler):
    async def wrapped(ctx, *args, **kwargs):
        async with _quote_activity(ctx):
            return await handler(ctx, *args, **kwargs)
    return wrapped


@_quote_working
async def _quote_render(ctx, messages, output='sticker', options=None, add_to_pack=True):
    if not _QUOTE_RENDER_LOCK.acquire(blocking=False):
        raise GodChatError('Цитата уже рисуется. Дождись завершения.')
    op = secrets.token_hex(4)
    painter = None
    try:
        await ctx.cap('logs', dict(op='write', level='info', msg='GodChat quote op=' + op + ' stage=imports'))
        _quote_modules()
        options = dict(options or _quote_options(ctx), sticker=output == 'sticker')
        if output != 'sticker':
            options['scale'] = 4
        markup = _QuoteMarkup(ctx, options)
        await ctx.cap('logs', dict(op='write', level='info', msg='GodChat quote op=' + op + ' stage=assets'))
        html_text = await markup.build(messages)
        fonts = await _quote_fonts(ctx, html_text)
        payload = dict(options=options, fonts=fonts, assets=markup.assets)
        mode = options.get('background_mode', 'transparent')
        if mode in ('dark', 'light'):
            options['background_color'] = '#181b1e' if mode == 'dark' else '#dce5e9'
        elif mode == 'custom':
            payload['wallpaper'] = _quote_background(ctx)
        painter = _QuotePainter(payload)
        await ctx.cap('logs', dict(op='write', level='info', msg='GodChat quote op=' + op + ' stage=render'))
        pages = painter.render(html_text)
        if output == 'sticker':
            payload, size = _quote_sticker_bytes(pages)
            await _quote_upload(ctx, payload, 'quote.webp', True, size)
        else:
            for page in pages:
                await asyncio.sleep(0)
                await _quote_upload(ctx, page, 'quote.png', photo=output == 'photo')
        if add_to_pack:
            await _quote_pack_append(ctx, pages)
        warnings = list(dict.fromkeys(markup.warnings + [item['code'] for item in painter.warnings]))
        if warnings:
            await ctx.cap('logs', dict(op='write', level='warning', msg='GodChat quote op=' + op + ' warnings=' + ','.join(warnings)))
        await ctx.cap('logs', dict(op='write', level='info', msg='GodChat quote op=' + op + ' stage=done'))
    finally:
        if painter:
            for image in painter.images.values():
                image.close()
            painter.fonts.clear()
        _QUOTE_RENDER_LOCK.release()


async def _quote_messages(ctx, invocation):
    args = list(invocation.args)
    user_only = '-u' in args
    if args.count('-u') > 1:
        raise GodChatError('Флаг -u указан повторно.')
    args = [item for item in args if item != '-u']
    if len(args) > 1 or (args and (not args[0].isdigit() or not 1 <= int(args[0]) <= 30)):
        raise GodChatError('Используй q [1–30] [-u] реплаем на сообщение.')
    count = int(args[0]) if args else 1
    reply = await ctx.reply()
    if not isinstance(reply, dict) or not reply.get('id'):
        raise GodChatError('Ответь на сообщение для цитаты.')
    if reply.get('noforwards'):
        raise GodChatError('В сообщении запрещено сохранение содержимого.')
    messages = [reply]
    if count > 1:
        offset, scanned = reply['id'], 0
        owner = _sender(reply)
        while len(messages) < count and scanned < 5000:
            await _history_pace()
            result = await _rpc(ctx, 'messages.getHistory', dict(peer=await _input(ctx, ctx.chat_id), offset_id=offset, offset_date=0, add_offset=0, limit=100 if user_only else count, max_id=0, min_id=0, hash=0))
            page = sorted((item for item in result.get('messages', []) if 0 < item.get('id', 0) < offset), key=lambda item: item['id'], reverse=True)
            if not page:
                break
            scanned += len(page)
            for item in page:
                if item.get('_') not in ('messageEmpty', 'messageService') and (not user_only or _sender(item) == owner):
                    messages.append(item)
                    if len(messages) == count:
                        break
            offset = min(item['id'] for item in page)
        if len(messages) < count:
            raise GodChatError('Недостаточно доступных сообщений до выбранного (проверено не больше 5000).')
    if any(message.get('noforwards') for message in messages):
        raise GodChatError('Среди выбранных сообщений есть запрет сохранения содержимого.')
    return sorted(messages, key=lambda item: item['id'])


@_command
@_quote_working
async def command_q(ctx, invocation):
    messages = await _quote_messages(ctx, invocation)
    await _quote_render(ctx, messages, _quote_options(ctx)['send_format'])


@_command
@_quote_working
async def command_fq(ctx, invocation):
    args = getattr(invocation, 'raw_args', None)
    args = args if isinstance(args, str) else ' '.join(invocation.args)
    args, keep_media, source_reply_first, keep_source_reply = _fq_command_flags(args)
    if not args:
        raise GodChatError('Укажи автора и текст цитаты: fq [-r|-s] [-m] @username текст.')
    reply = await ctx.reply()
    if reply and reply.get('noforwards'):
        raise GodChatError('В сообщении запрещено сохранение содержимого.')
    if keep_media and not (reply or {}).get('media'):
        raise GodChatError('Для -m нужен реплай на медиа.')
    messages = await _fq_parse(ctx, args, reply, keep_media, source_reply_first, keep_source_reply)
    await _quote_render(ctx, messages, _quote_options(ctx)['send_format'])


def _fq_command_flags(args):
    leading = []
    args = args.strip()
    while True:
        match = re.match(r'^(-[rms])(?:\s+|$)', args)
        if not match:
            break
        leading.append(match[1])
        args = args[match.end():].strip()
    trailing = []
    while True:
        match = re.search(r'(?:^|\s+)(-[rms])$', args)
        if not match:
            break
        trailing.append(match[1])
        args = args[:match.start()].strip()
    flags = leading + trailing
    if len(flags) != len(set(flags)):
        raise GodChatError('Повторяющийся флаг.')
    if '-r' in flags and '-s' in flags:
        raise GodChatError('Нельзя использовать -r и -s вместе.')
    if '-r' in trailing:
        args = (args + ' -r').strip()
    return args, '-m' in flags, '-r' in leading, '-s' in flags


async def _fq_parse(ctx, args, reply, keep_media=False, source_reply_first=False, keep_source_reply=False):
    if len(args) > 65536:
        raise GodChatError('Слишком длинный текст команды.')
    blocks = re.split(r'(?:\s*\|\s*|\s+;\s+)(?=@[A-Za-z0-9_]+\s|-?\d+\s)', args)
    if len(blocks) > 30:
        raise GodChatError('В цитате может быть не больше 30 сообщений.')
    if keep_source_reply and len(blocks) != 1:
        raise GodChatError('С -s можно заменить только одно сообщение.')
    cache = {}

    async def resolve(identity):
        if identity not in cache:
            cache[identity] = await _resolve(ctx, identity)
        return cache[identity]

    async def parse_author(value, fallback=None):
        match = re.match(r'^(@[A-Za-z0-9_]+|-?\d+)\s+([\s\S]+)$', value.strip())
        if match:
            identity, text = match.groups()
            return await resolve(int(identity) if identity.lstrip('-').isdigit() else identity), text
        if fallback:
            identity = _sender(fallback)
            if identity is None and fallback.get('out'):
                identity = _id(await _me(ctx))
            return await resolve(identity or _id(fallback.get('peer_id') or {})), value.strip()
        raise GodChatError('Укажи автора и текст: @username текст или ID текст.')

    async def original_reply(source):
        if source.get('noforwards'):
            raise GodChatError('В исходном реплае запрещено сохранение содержимого.')
        result = copy.deepcopy(source)
        identity = _sender(source)
        if identity is None and source.get('out'):
            identity = _id(await _me(ctx))
        result['quote_author'] = await resolve(identity or _id(source.get('peer_id') or {}) or ctx.chat_id)
        return result

    parent = None
    if keep_source_reply:
        info = (reply or {}).get('reply_to') or {}
        if not info.get('reply_to_msg_id'):
            raise GodChatError('Для -s ответь на сообщение, у которого есть реплай.')
        peer = _id(info.get('reply_to_peer_id') or reply.get('peer_id') or {}) or ctx.chat_id
        parent = await ctx.msg(peer, info['reply_to_msg_id'])
        if not isinstance(parent, dict) or parent.get('_') == 'messageEmpty':
            raise GodChatError('Не удалось получить сообщение из исходного реплая.')
    messages = []
    for index, block in enumerate(blocks):
        source_reply = bool(re.search(r'\s+-r\s*$', block)) or (source_reply_first and index == 0)
        if source_reply:
            if not reply:
                raise GodChatError('Для -r нужен реплай на сообщение.')
            block = re.sub(r'\s+-r\s*$', '', block)
        parts = re.split(r'\s+-r\s+', block, maxsplit=1)
        entity, text = await parse_author(parts[0], reply if index == 0 else None)
        message = copy.deepcopy(reply) if keep_source_reply else dict(id=0, date=int(time.time()))
        message.update(await _quote_parse_text(ctx, text))
        message.update(quote_entry=index + 1, quote_author=entity, from_id=_quote_peer(_id(entity)), out=False, fwd_from=None)
        message['media'] = copy.deepcopy(reply.get('media')) if keep_media and index == 0 else None
        message.pop('reply_to', None)
        if parent is not None or source_reply:
            message['quote_reply'] = await original_reply(parent if parent is not None else reply)
        if len(parts) == 2:
            reply_entity, reply_text = await parse_author(parts[1])
            message['quote_reply'] = dict(quote_author=reply_entity, **(await _quote_parse_text(ctx, reply_text)))
        messages.append(message)
    return messages


@_command
async def command_mfq(ctx, invocation):
    if invocation.args:
        raise GodChatError('Используй mfq реплаем на сообщение или без аргументов.')
    reply = await ctx.reply()
    message = copy.deepcopy(reply) if isinstance(reply, dict) else dict(id=0, date=int(time.time()), message='', entities=[])
    if message.get('noforwards'):
        raise GodChatError('В сообщении запрещено сохранение содержимого.')
    if 'quote_author' not in message:
        try:
            author = await _resolve(ctx, _sender(message) or _id(await _me(ctx)))
        except Exception:
            author = await _me(ctx)
        message['quote_author'] = author
    state = _session(ctx, 'quote', quote_messages=[message], quote_index=0, options=_quote_options(ctx))
    await _quote_menu(ctx, state)


def _quote_raw(value):
    if isinstance(value, _QuoteValue):
        return value._raw
    if isinstance(value, dict):
        return {key: _quote_raw(item) for key, item in value.items()}
    if isinstance(value, list):
        return [_quote_raw(item) for item in value]
    return value


def _quote_peer(uid):
    if uid < -1000000000000:
        return dict(_='peerChannel', channel_id=-uid - 1000000000000)
    if uid < 0:
        return dict(_='peerChat', chat_id=-uid)
    return dict(_='peerUser', user_id=uid)


async def _quote_sync(function, *args, **kwargs):
    await asyncio.sleep(0)
    return function(*args, **kwargs)


class _QuoteClient:
    def __init__(self, owner):
        self.owner = owner

    async def __call__(self, request):
        method, kwargs = request
        result = await _rpc(self.owner.ctx, method, _quote_raw(kwargs))
        return _quote_value(result)

    async def get_entity(self, identity, force=False):
        raw = _quote_raw(identity)
        return _quote_value(await _resolve(self.owner.ctx, _id(raw) if isinstance(raw, dict) else raw))

    async def get_messages(self, peer, ids):
        raw = _quote_raw(peer)
        result = await self.owner.ctx.msg(_id(raw) if isinstance(raw, dict) else raw, ids)
        return await self.owner.prepare(result) if isinstance(result, dict) else None

    async def get_permissions(self, peer, sender):
        raw = _quote_raw(peer)
        rights = await _permissions(self.owner.ctx, _id(raw) if isinstance(raw, dict) else raw, _quote_raw(sender))
        return SimpleNamespace(is_creator=bool(rights.get('creator')), is_admin=bool(rights.get('admin')), participant=_quote_value(rights.get('participant', {})))

    async def download_profile_photo(self, peer, destination, download_big=False):
        raw = _quote_raw(peer)
        photo = raw.get('photo') or {}
        if not photo.get('photo_id'):
            return None
        location = dict(_='inputPeerPhotoFileLocation', peer=await _input(self.owner.ctx, raw), photo_id=photo['photo_id'], big=download_big)
        return await self.owner.getfile(location, limit=2 * 1024 * 1024)


_QUOTE_REQUESTS = SimpleNamespace(
    messages=SimpleNamespace(
        GetRichMessageRequest=lambda peer, identity: ('messages.getRichMessage', dict(peer=peer, id=identity)),
        GetCustomEmojiDocumentsRequest=lambda identities: ('messages.getCustomEmojiDocuments', dict(document_id=identities)),
    ),
    help=SimpleNamespace(GetPeerColorsRequest=lambda **kwargs: ('help.getPeerColors', kwargs)),
    stories=SimpleNamespace(GetStoriesByIDRequest=lambda **kwargs: ('stories.getStoriesByID', kwargs)),
)
_QUOTE_TYPES = SimpleNamespace(PeerChannel=lambda uid: _quote_value(dict(_='peerChannel', channel_id=uid)))


def _quote_sticker_bytes(data):
    from PIL import Image
    pages = data if isinstance(data, list) else [data]
    dimensions = []
    for page in pages:
        with Image.open(io.BytesIO(page)) as source:
            dimensions.append(source.size)
    if not dimensions:
        raise _GQuoteError('no_output_pages')
    width = max((w for w, h in dimensions))
    height = sum((h for w, h in dimensions))
    ratio = 512 / max(width, height)
    size = (max(1, round(width * ratio)), max(1, round(height * ratio)))
    with Image.new('RGBA', size, (0, 0, 0, 0)) as resized:
        offset = 0
        for page, (w, h) in zip(pages, dimensions):
            top = round(offset * ratio)
            bottom = round((offset + h) * ratio)
            offset += h
            if bottom <= top:
                continue
            with Image.open(io.BytesIO(page)) as source:
                with source.convert('RGBA') as image:
                    with image.resize((max(1, round(w * ratio)), bottom - top), Image.Resampling.LANCZOS) as part:
                        resized.alpha_composite(part, ((size[0] - part.width) // 2, top))
        out = io.BytesIO()
        resized.save(out, format='WEBP', lossless=True, method=6)
        if out.tell() > 512 * 1024:
            for quality in (95, 90, 80, 70):
                out = io.BytesIO()
                resized.save(out, format='WEBP', quality=quality, method=6)
                if out.tell() <= 512 * 1024:
                    break
        if out.tell() > 512 * 1024:
            raise _GQuoteError('sticker_bytes_limit')
        return (out.getvalue(), size)


