             'en': {'name': 'GodChat',
                    'description': '[Hotaru] Moderation and member management.',
                    'commands': {'gcfg': {'description': 'GodChat settings'},
 'ban': {'usage': '[user] [time] [-d] [reason]', 'description': 'ban; [-d] - delete all messages'},
 'unban': {'usage': '[user] [-all]', 'description': 'unban; [-all] - unban all'},
 'gban': {'usage': '[user] [reason] [-f]',
          'description': 'ban in all accessible chats; -f: chat list'},
 'gunban': {'usage': '[user] [-f]', 'description': 'unban in all accessible chats; -f: chat list'},
 'mute': {'usage': '[user] [time] [reason]', 'description': 'mute'},
 'dmute': {'usage': '[user] [time]', 'description': 'delete-mute; repeat to remove'},
 'unmute': {'usage': '[user]', 'description': 'unmute'},
 'kick': {'usage': '[user] [reason] [-d]', 'description': 'kick; [-d] - kick deleted accounts'},
 'tkick': {'description': 'kick members by join time'},
 'del': {'usage': '[user] [n|-all]',
         'description': 'delete messages; without arguments deletes the reply'},
 'purge': {'description': 'delete messages up to the replied one'},
 'req': {'description': 'manage join requests'},
 'panic': {'description': 'enable/disable panic'},
 'banchat': {'usage': '[time]', 'description': 'close/open the chat'},
 'banmedia': {'usage': '[-p] [-g]',
              'description': 'ban replied media or toggle a sticker ban; -p - sticker pack; -g - '
                             'globally'},
 'unbanmedia': {'usage': '[-p] [-g] [-all]',
                'description': 'unban replied media/sticker; -p - sticker pack; -g - globally; '
                               '-all - clear all bans'},
 'id': {'usage': '[@username]',
        'description': 'user/bot/chat ID; otherwise replied sender or current chat'},
 'member': {'usage': '[user/reply]', 'description': 'member or sender channel card'},
 'rmember': {'description': 'actions with a random member'},
 'pref': {'usage': '[user] [tag] [-a]', 'description': 'set a tag; -a - admin tag'},
 'aclear': {'description': 'remove all chat administrators while keeping their tags'},
 'q': {'usage': '[n] [-u]',
       'description': "quote n messages up to the replied one; -u selects only that author's "
                      'messages'},
 'fq': {'usage': '[-r] [-s] [-m] [@|ID] [Text]',
        'description': 'Quick fake quote. -r replies to the source message; -s keeps its original '
                       'reply; -m keeps media.'},
 'mfq': {'description': 'create a fake quote'},
 'guest': {'description': 'forbid or allow guest bots in the chat'},
 'nochan': {'description': 'forbid messages sent as a channel; repeat to allow'},
 'inline': {'usage': '[-all/reply in a group]',
            'description': 'toggle inline; in private chats, delete incoming inline messages'}},
