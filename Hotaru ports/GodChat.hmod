k.', 'gq_pack_failed': 'Could not update the quote sticker pack. See logs.', 'gq_pack_full': 'The quote sticker pack is full. Auto-add has been disabled.', 'gq_pack_send_failed': 'Sticker added to the pack, but could not be sent from it. The quote was sent normally.', 'gq_pack_saved': 'Quote pack', 'gq_trigger_enable': 'Quotes by trigger', 'gq_trigger_name': 'Trigger', 'gq_trigger_input': 'Trigger text (1–32 characters); reply with trigger [n], n=1–30', 'gq_trigger_invalid': 'Enter 1–32 characters for the trigger.', 'gq_trigger_usage': 'Reply to the last message: <code>{trigger}</code> or <code>{trigger} 4</code> for four messages', 'gcfg_quotes': 'Quote settings', 'gcfg_quotes_short': 'Quotes'}}

class _QuoteOriginalMenus:

    def _gq_markup(self, state, busy=False):
        token = state['id']
        if busy:
            if state.get('fake') and state.get('config', True):
                return self._mfq_markup(state)
            rows = []
            if state.get('config', True):
                rows.append([{'text': self._s('gq_close'), 'callback': self._mfq_callback if state.get('fake') else self._gq_callback, 'args': (token, 'close'), 'style': 'danger'}])
            return rows
        if state.get('fake') and state.get('config', True):
            return self._mfq_markup(state)
        if not state.get('config', True):
            return []

        def button(text, action, style=None):
            result = {'text': text, 'callback': self._gq_callback, 'args': (token, action)}
            if style or action in ('close', 'back'):
                result['style'] = style or 'danger'
            return result
        options = state['options']
        if state.get('gq_view') == 'extra':
            toggles = [button(('✓ ' if options[key] else '✗ ') + self._s('gq_' + key), key, 'success' if options[key] else 'danger') for key in ('spoilers', 'expanded')]
            return [toggles, [button(self._s('gq_link_preview_position') + ': ' + self._s('gq_link_preview_' + options.get('link_preview_position', 'bottom')), 'link_preview_position')], [button('−5%', 'transparency_down'), button(self._s('gq_transparency_short') + ' ' + str(options['bubble_transparency']) + '%', 'transparency_info'), button('+5%', 'transparency_up')], [button(self._s('gq_back'), 'extra_back', 'danger'), button(self._s('gq_close'), 'close')]]
        rows = [[button(self._s('gq_theme') + ': ' + options['theme'], 'theme')]]
        rows.append([button(self._s('gq_send_format') + ': ' + self._s('gq_format_' + options.get('send_format', 'sticker')), 'send_format')])
        rows.append([button(self._s('gq_background') + ': ' + self._s('gq_bg_' + options.get('background_mode', 'transparent')), 'background_menu')])
        keys = ('gift_colors', 'bubble_outline')
        toggles = [button(('✓ ' if options[k] else '✗ ') + self._s('gq_' + k), k, 'success' if options[k] else 'danger') for k in keys]
        rows.extend([toggles[i:i + 2] for i in range(0, len(toggles), 2)])
        rows.append([button(self._s('gq_extra'), 'extra', 'primary')])
        if state.get('gcfg') and state.get('gq_view') != 'extra' and getattr(state['source'], 'is_group', False):
            trigger = self._gq_trigger_get(state['source'].chat_id)
            rows.append([button(('✓ ' if trigger['enabled'] else '✗ ') + self._s('gq_trigger_enable'), 'trigger_toggle', 'success' if trigger['enabled'] else 'danger')])
            rows.append([{'text': self._s('gq_trigger_name') + ': ' + trigger['trigger'], 'input': self._s('gq_trigger_input'), 'handler': self._gq_trigger_input, 'args': (token,), 'style': 'primary'}])
            pack = self._gq_pack_get(state['source'].chat_id)
            rows.append([button(self._s('gq_pack_replace' if pack else 'gq_pack_create'), 'pack_create', 'primary')])
            rows.append([{'text': self._s('gq_pack_connect'), 'input': self._s('gq_pack_input'), 'handler': self._gq_pack_input, 'args': (token,), 'style': 'primary'}])
            if pack:
                rows.append([button(('✓ ' if pack.get('enabled') else '✗ ') + self._s('gq_pack_auto'), 'pack_toggle', 'success' if pack.get('enabled') else 'danger')])
                rows.append([{'text': self._s('gq_pack_open'), 'url': 'https://t.me/addstickers/' + pack['short_name']}])
        back = [{'text': self._s('gq_back'), 'callback': self._gcfg_open, 'args': (token, 'main'), 'style': 'danger'}]
        if state.get('reply'):
            rows.append([button(self._s('gq_png'), 'png'), button(self._s('gq_preview'), 'preview')])
        rows.append([button(self._s('gq_reset'), 'reset')])
        rows.append((back if state.get('gcfg') else []) + [button(self._s('gq_close'), 'close')])
        return rows

    def _gq_text(self, state):
        if state.get('fake'):
            return self._mfq_text(state)
        title = self._s('gcfg_quotes')
        if state.get('gq_view') == 'extra':
            title += ' · ' + self._s('gq_extra')
        text = _QUOTE_UI_EMOJI['message'] + ' <b>GodChat · ' + title + '</b>'
        if state.get('gcfg') and state.get('gq_view') != 'extra' and getattr(state['source'], 'is_group', False):
            trigger = self._gq_trigger_get(state['source'].chat_id)
            if trigger['enabled']:
                text += '\n\n' + self._s('gq_trigger_usage', trigger=_QUOTE_UI_UTILS.escape_html(trigger['trigger']))
            pack = self._gq_pack_get(state['source'].chat_id)
            if pack:
                text += '\n\n' + self._s('gq_pack_saved') + ': <code>' + _QUOTE_UI_UTILS.escape_html(pack['short_name']) + '</code>'
        return text

    def _gq_background_text(self, state, uploaded=False):
        mode = state['options'].get('background_mode', 'transparent')
        text = self._gq_text(state) + '\n\n' + self._s('gq_background') + ': <b>' + self._s('gq_bg_' + mode) + '</b>'
        if uploaded:
            text += '\n' + _QUOTE_UI_EMOJI['success'] + ' ' + self._s('gq_bg_loaded')
        return text

    def _gq_background_markup(self, state):
        token = state['id']
        mode = state['options'].get('background_mode', 'transparent')
        cache = self.get('gquote_background_cache', {})
        saved = isinstance(cache, dict) and bool(cache.get('url'))
        rows = []
        for pair in (('transparent', 'dark'), ('light',)):
            rows.append([{'text': ('✓ ' if mode == value else '') + self._s('gq_bg_' + value), 'callback': self._gq_callback, 'args': (token, 'bg:' + value), **({'style': 'success'} if mode == value else {})} for value in pair])
        rows.append([{'text': self._s('gq_bg_replace' if saved else 'gq_bg_upload'), 'input': self._s('gq_bg_input'), 'handler': self._gq_background_input, 'args': (token,), 'style': 'primary'}])
        if saved:
            rows.append([{'text': ('✓ ' if mode == 'custom' else '') + self._s('gq_bg_saved'), 'callback': self._gq_callback, 'args': (token, 'bg:custom'), 'style': 'success' if mode == 'custom' else 'primary'}])
        rows.append([{'text': self._s('gq_back'), 'callback': self._gcfg_open, 'args': (token, 'quotes'), 'style': 'danger'}, {'text': self._s('gq_close'), 'callback': self._gq_callback, 'args': (token, 'close'), 'style': 'danger'}])
        return rows

    def _mfq_text(self, state):
        tr = lambda ru, en: self._mfq_tr(state, ru, en)
        current = state['draft'][state['cursor']]
        esc = _QUOTE_UI_UTILS.escape_html
        name = current['name'] or self._name(current['peer'])
        text = self._mfq_edit_text(current)[:900] or tr('Текст не задан', 'No text yet')
        details = [tr('Автор: ', 'Author: ') + esc(name), esc(text)]
        if current['media']:
            details.append(tr('📎 Медиа прикреплено', '📎 Media attached'))
        button_count = sum((len(row) for row in current.get('buttons', [])))
        if button_count:
            details.append(tr('🔘 Кнопок: ', '🔘 Buttons: ') + str(button_count))
        if current['reply'] or current['original_reply']:
            details.append(tr('↩ Ответ добавлен', '↩ Reply added'))
        reply = current['reply']
        if isinstance(reply, dict):
            details.append('↩ ' + esc(self._name(reply['peer'])) + ': ' + esc(self._mfq_edit_text(reply)[:240] or tr('Текст ответа не задан', 'No reply text yet')))
        elif isinstance(reply, int):
            target = next((e for e in state['draft'] if e['id'] == reply), None)
            if target:
                details.append('↩ ' + esc(target['name'] or self._name(target['peer'])) + ': ' + esc(self._mfq_edit_text(target)[:240]))
        if current['rank']:
            details.append(tr('Префикс: ', 'Tag: ') + esc(current['rank']))
        if current.get('via'):
            via = current['via']
            username = _QuoteMarkupOriginal.username(via)
            details.append('via ' + esc('@' + username if username else str(via)))
        if current.get('status') is not None:
            status = current['status']
            icon = f'<tg-emoji emoji-id="{status}">⭐</tg-emoji>' if isinstance(status, int) and (not isinstance(status, bool)) else tr('Стикер', 'Sticker') if isinstance(status, dict) else esc(status) if status else tr('Без статуса', 'No status')
            details.append(tr('Эмодзи-статус: ', 'Emoji status: ') + icon)
        details.append(esc(current.get('time_label') or current['date'].astimezone(self._quote_timezone()).strftime('%H:%M')))
        title = tr('Фейк-цитата', 'Fake quote')
        waiting = state.get('await_media')
        hint = ''
        if waiting:
            hint = '\n\n' + tr(f"Отправьте следующим сообщением медиа для сообщения {waiting['number']} в этом чате.", f"Send media in this chat for message {waiting['number']}.")
        if state.get('await_status'):
            hint += '\n\n' + tr('Отправьте следующим сообщением эмодзи или стикер в этом чате.', 'Send an emoji or sticker in this chat.')
        if state.get('await_text'):
            hint += '\n\n' + tr('Отправьте текст следующим сообщением в этом чате. Он будет удалён после сохранения.', 'Send the text as the next message in this chat. It will be deleted after saving.')
        return _QUOTE_UI_EMOJI['message'] + f' <b>GodChat · {title}</b>\n\n' + tr('Сообщение', 'Message') + f" {state['cursor'] + 1} / {len(state['draft'])}\n" + '<blockquote>' + '\n'.join(details) + '</blockquote>\n' + tr('Оформление — из .gcfg', 'Appearance — from .gcfg') + hint + '\n\n<blockquote expandable>' + self._s('markup_hint') + '</blockquote>'

    def _mfq_markup(self, state):
        tr = lambda ru, en: self._mfq_tr(state, ru, en)
        token = state['id']

        def button(ru, en, action, style=None):
            result = dict(text=tr(ru, en), callback=self._mfq_callback, args=(token, action))
            if style:
                result['style'] = style
            return result

        def inp(ru, en, field, prompt=None):
            entry_id = state['draft'][state['cursor']]['id']
            queries = state.setdefault('input_queries', {})
            query = queries.setdefault((entry_id, field), secrets.token_hex(5))
            return dict(text=tr(ru, en), input=prompt or tr(ru, en), handler=self._mfq_input, args=(token, field, entry_id), style='primary', _switch_query=query)
        close = button('Закрыть', 'Close', 'close', 'danger')
        back = button('Назад', 'Back', 'editor', 'danger')
        if state.get('view') == 'status':
            return [[inp('По ID эмодзи', 'Emoji ID', 'status_id', tr('ID премиум-эмодзи', 'Custom emoji ID'))], [button('Отменить ожидание', 'Cancel waiting', 'status_cancel', 'danger') if state.get('await_status') else button('Следующим сообщением', 'Send next message', 'status_message', 'primary')], [button('Убрать статус', 'Remove status', 'status_clear', 'danger'), button('Вернуть статус автора', 'Restore author status', 'status_reset')], [button('Назад', 'Back', 'extra', 'danger'), close]]
        if state.get('view') == 'reply':
            rows = [[button('Без ответа', 'No reply', 'reply_clear', 'danger')], [inp('Автор ответа', 'Reply author', 'reply_author', '@username / ID'), inp('Текст ответа', 'Reply text', 'reply_text')], [button('Отменить ввод текста', 'Cancel text input', 'text_message_cancel', 'danger') if state.get('await_text', {}).get('field') == 'reply_text' else button('Текст следующим сообщением', 'Text as next message', 'reply_text_message')]]
            for entry in state['draft']:
                if entry['id'] != state['draft'][state['cursor']]['id']:
                    label = f"{state['draft'].index(entry) + 1}. " + (entry['text'][:25] or tr('Медиа', 'Media'))
                    rows.append([button(label, label, 'reply:' + str(entry['id']))])
            return rows + [[back, close]]
        if state.get('view') == 'extra':
            return [[inp('Отображаемое имя', 'Display name', 'name'), inp('Префикс', 'Tag', 'rank')], [inp('via @bot', 'via @bot', 'via', '@bot'), *([button('Убрать via', 'Remove via', 'via_clear', 'danger')] if state['draft'][state['cursor']].get('via') else [])], [button('Эмодзи-статус', 'Emoji status', 'status_menu')], [inp('Время HH:MM', 'Time HH:MM', 'time'), button('Сбросить имя и префикс', 'Reset name and tag', 'reset_author')], [inp('Добавить кнопку', 'Add button', 'button_label', tr('Текст кнопки', 'Button text')), *([button('Убрать кнопки', 'Remove buttons', 'buttons_clear', 'danger')] if state['draft'][state['cursor']].get('buttons') else [])], [button('Дублировать', 'Duplicate', 'duplicate'), button('Убрать медиа', 'Remove media', 'media_clear')], [back, close]]
        send_buttons = [button('Отправить PNG', 'Send PNG', 'png')]
        if state.get('options', {}).get('send_format', 'sticker') != 'sticker':
            send_buttons.insert(0, button('Отправить стикер', 'Send sticker', 'sticker', 'success'))
        return [[inp('Автор', 'Author', 'author', '@username / ID'), inp('Текст', 'Text', 'text')], [button('Отменить ввод текста', 'Cancel text input', 'text_message_cancel', 'danger') if state.get('await_text', {}).get('field') == 'text' else button('Текст следующим сообщением', 'Text as next message', 'text_message')], [button('Отменить добавление медиа', 'Cancel media upload', 'media_cancel', 'danger') if state.get('await_media') else button('Добавить медиа', 'Add media', 'media_add', 'primary')], [button('Реплай', 'Reply', 'reply_menu'), button('Дополнительно', 'More', 'extra')], [button('Добавить', 'Add', 'add'), button('Удалить', 'Delete', 'delete', 'danger')], *([[button('←', '←', 'prev'), button('→', '→', 'next')]] if len(state['draft']) > 1 else []), [button('Превью', 'Preview', 'preview')], send_buttons, [close]]

_QUOTE_UI_UTILS = SimpleNamespace(escape_html=_esc)
_QUOTE_UI_EMOJI = dict(message=_ICONS['source'], success=_ICONS['ok'])


def _quote_entry(state):
    entries = state['quote_messages']
    state['quote_index'] = max(0, min(state.get('quote_index', 0), len(entries) - 1))
    used = [entry.get('quote_entry', 0) for entry in entries]
    next_id = max([state.get('quote_next_id', 1)] + [identity + 1 for identity in used])
    for entry in entries:
        if not entry.get('quote_entry'):
            entry['quote_entry'] = next_id
            next_id += 1
    state['quote_next_id'] = next_id
    return entries[state['quote_index']]


def _quote_edit_text(message):
    return message.get('quote_edit_text', message.get('message', ''))


class _QuoteMenus(_QuoteOriginalMenus):
    _gq_callback = 'settings'
    _mfq_callback = 'editor'
    _mfq_input = 'editor_input'
    _gcfg_open = 'config'
    _gq_background_input = 'background_input'
    _gq_trigger_input = 'trigger_input'
    _gq_pack_input = 'pack_input'

    def __init__(self, ctx, state):
        self.ctx, self.state = ctx, state
        self.ru = not str(getattr(getattr(ctx, 'i18n', None), 'language', 'ru')).startswith('en')

    def _s(self, key, **values):
        language = 'ru' if self.ru else 'en'
        return _QUOTE_UI_STRINGS[language].get(key, key).format(**values)

    def _mfq_tr(self, state, ru, en):
        return ru if self.ru else en

    def _name(self, peer):
        return _name(self.ctx, _quote_raw(peer))

    def _quote_timezone(self):
        return _tz(self.ctx)

    def _mfq_edit_text(self, entry):
        return entry.get('edit_text', entry.get('text', ''))

    def _gq_trigger_get(self, chat):
        return _quote_trigger(self.ctx, chat)

    def _gq_pack_get(self, chat):
        return self.ctx.state.get('quote_packs', {}).get(str(chat))

    def get(self, key, default=None):
        return self.ctx.state.get('quote_background', default) if key == 'gquote_background_cache' else default

    def snapshot(self):
        state = self.state
        group = state.get('quote_is_group', False)
        fake = bool(state.get('quote_messages'))
        value = dict(id=state['token'], options=state['options'], fake=fake, config=True, gcfg=not fake, source=SimpleNamespace(chat_id=state['chat'], is_group=group), ru=self.ru, gq_view=state.get('quote_view', 'main'), view=state.get('quote_view', 'editor'), cursor=state.get('quote_index', 0), reply=state.get('quote_source'))
        if not fake:
            return value
        _quote_entry(state)
        draft = []
        for message in state['quote_messages']:
            manual = message.get('quote_reply')
            reply = dict(peer=_quote_value(manual['quote_author']), text=manual.get('message', ''), entities=[], edit_text=_quote_edit_text(manual)) if isinstance(manual, dict) else message.get('quote_reply_key')
            draft.append(dict(id=message['quote_entry'], peer=_quote_value(message['quote_author']), name=message.get('display_name'), text=message.get('message', ''), edit_text=_quote_edit_text(message), entities=message.get('entities', []), media=message.get('media'), reply=reply, original_reply=message.get('reply_to'), rank=message.get('display_rank'), via=message.get('quote_via'), status=message.get('display_status'), date=datetime.fromtimestamp(_date(message.get('date')) or time.time(), _tz(self.ctx)), time_label=message.get('display_time'), buttons=[row.get('buttons', []) for row in (message.get('reply_markup') or {}).get('rows', [])]))
        value.update(draft=draft, cursor=state['quote_index'])
        wait = state.get('quote_wait')
        if wait:
            if wait['kind'] == 'media':
                value['await_media'] = dict(number=next((index + 1 for index, entry in enumerate(draft) if entry['id'] == wait['entry']), 1))
            elif wait['kind'] == 'status':
                value['await_status'] = True
            else:
                value['await_text'] = dict(field=wait['field'])
        return value


def _quote_ui_buttons(ctx, state, markup):
    result = []
    for row in markup:
        buttons = []
        for original in row:
            label, style = original['text'], original.get('style')
            handler = original.get('handler')
            if original.get('url'):
                button = ctx.ui.url(label, original['url'])
            elif original.get('input') is not None:
                args = original.get('args', ())
                field = args[1] if handler == 'editor_input' else {'background_input': 'background', 'trigger_input': 'trigger', 'pack_input': 'pack'}[handler]
                entry = args[2] if handler == 'editor_input' else None
                button = _button(ctx, label, state, 'quote_input', style, field=field, entry=entry, prompt=original['input'])
            elif original.get('callback') == 'config':
                view = original['args'][-1]
                button = _button(ctx, label, state, 'config' if view == 'main' else 'quote_ui', style, **(dict(view=view) if view == 'main' else dict(ui='settings')))
            else:
                action = original['args'][-1]
                button = _button(ctx, label, state, 'close' if action == 'close' else 'quote_ui', style, **({} if action == 'close' else dict(ui=action)))
                if action == 'close':
                    button['_quote_keyboard'] = True
            button['text'] = label
            button['_quote_plain'] = True
            button.pop('icon_custom_emoji_id', None)
            buttons.append(button)
        result.append(buttons)
    return result


async def _quote_menu(ctx, state, callback=None):
    if 'quote_is_group' not in state:
        try:
            entity = await _resolve(ctx, state['chat'])
            state['quote_is_group'] = entity.get('_') == 'chat' or bool(entity.get('megagroup'))
        except Exception:
            state['quote_is_group'] = False
    state['options'] = _quote_options(ctx)
    ui = _QuoteMenus(ctx, state)
    snapshot = ui.snapshot()
    if snapshot['fake']:
        text, rows = ui._mfq_text(snapshot), ui._mfq_markup(snapshot)
    elif state.get('quote_view') == 'background':
        text, rows = ui._gq_background_text(snapshot), ui._gq_background_markup(snapshot)
    else:
        text, rows = ui._gq_text(snapshot), ui._gq_markup(snapshot)
    if state.get('quote_notice'):
        text += '\n\n' + _esc(state.pop('quote_notice'))
    await _form(ctx, state, text, _quote_ui_buttons(ctx, state, rows), callback)


def _quote_trigger(ctx, chat):
    saved = ctx.state.get('quote_triggers', {}).get(str(chat), {})
    return dict(enabled=saved.get('enabled') is True, trigger=saved.get('trigger') or 'цитата')


def _quote_wait(state, kind, field=None):
    entry = _quote_entry(state)
    _INPUTS.pop((state['chat'], state['actor']), None)
    for other in _SESSIONS.values():
        if other['chat'] == state['chat'] and other['actor'] == state['actor']:
            other.pop('quote_wait', None)
    state['quote_wait'] = dict(kind=kind, field=field, entry=entry['quote_entry'], expires=time.time() + 300)


async def _quote_callback(ctx, callback, state, payload):
    action = payload['action']
    if action in ('quote_input', 'quote_author', 'quote_text'):
        field = payload.get('field') or action.removeprefix('quote_')
        if state.get('quote_messages') and payload.get('entry') is not None and payload['entry'] != _quote_entry(state)['quote_entry']:
            raise GodChatError('Сообщение в редакторе изменилось. Нажми кнопку ввода заново.')
        return await _prompt(ctx, callback, state, 'quote_' + field, payload.get('prompt') or 'Введи значение.')
    ui = payload.get('ui')
    legacy = {'quote_add': 'add', 'quote_remove': 'delete', 'quote_page': 'prev' if payload.get('step') == -1 else 'next', 'quote_send': 'sticker' if payload.get('output') == 'sticker' else 'png'}
    ui = ui or legacy.get(action) or ''
    if action == 'quote_store':
        ctx.state.set('quote_options', state['options'])
        return await _quote_menu(ctx, state, callback)
    if action == 'quote_option':
        ui = payload['key']
    options = _quote_options(ctx)
    fake = bool(state.get('quote_messages'))
    if ui in ('preview', 'png', 'sticker'):
        messages = copy.deepcopy(state['quote_messages'] if fake else [state['quote_source']])
        for index, message in enumerate(messages):
            if not message.get('message', '').strip() and not message.get('media') and not message.get('rich_message'):
                if ui != 'preview':
                    raise GodChatError('Добавь текст или медиа в сообщение ' + str(index + 1) + '.')
                message['message'] = 'Текст не задан'
        state['busy'] = True
        try:
            await callback.respond('Создаю цитату…')
            await _quote_render(ctx, messages, 'photo' if ui == 'preview' else ui, options, add_to_pack=ui != 'preview')
        finally:
            state['busy'] = False
        return await _quote_menu(ctx, state, callback)
    if not fake:
        if ui in ('extra', 'background_menu', 'extra_back', 'settings'):
            state['quote_view'] = {'extra': 'extra', 'background_menu': 'background'}.get(ui, 'main')
        elif ui == 'theme':
            options['theme'] = 'light' if options['theme'] == 'dark' else 'dark'
        elif ui == 'send_format':
            formats = ('sticker', 'png', 'photo')
            options['send_format'] = formats[(formats.index(options['send_format']) + 1) % 3]
        elif ui in ('gift_colors', 'bubble_outline', 'spoilers', 'expanded'):
            options[ui] = not options[ui]
        elif ui == 'link_preview_position':
            options[ui] = 'top' if options.get(ui, 'bottom') == 'bottom' else 'bottom'
        elif ui in ('transparency_down', 'transparency_up'):
            options['bubble_transparency'] = max(0, min(100, options['bubble_transparency'] + (-5 if ui == 'transparency_down' else 5)))
        elif ui == 'transparency_info':
            return await callback.respond(str(options['bubble_transparency']) + '%', alert=True)
        elif ui == 'reset':
            options = dict(_QUOTE_DEFAULTS)
        elif ui and ui.startswith('bg:'):
            mode = ui[3:]
            if mode not in ('transparent', 'dark', 'light', 'custom') or (mode == 'custom' and not ctx.state.get('quote_background')):
                raise GodChatError('Сначала загрузи фон.')
            options.update(background_mode=mode, background=mode != 'transparent')
        elif ui == 'trigger_toggle':
            config = _quote_trigger(ctx, state['chat'])
            config['enabled'] = not config['enabled']
            _save(ctx, 'quote_triggers', state['chat'], config)
        elif ui == 'pack_toggle':
            pack = ctx.state.get('quote_packs', {}).get(str(state['chat']))
            if not pack:
                raise GodChatError('Сначала добавь стикерпак.')
            pack['enabled'] = not pack.get('enabled')
            _save(ctx, 'quote_packs', state['chat'], pack)
        elif ui == 'pack_create':
            state['busy'] = True
            try:
                await callback.respond('Создаю пак цитат…')
                await _quote_pack_create(ctx, state['chat'])
            finally:
                state['busy'] = False
        else:
            raise GodChatError(_l('m376'))
        ctx.state.set('quote_options', options)
        return await _quote_menu(ctx, state, callback)
    entry = _quote_entry(state)
    if ui in ('editor', 'extra', 'reply_menu', 'status_menu'):
        state['quote_view'] = {'reply_menu': 'reply', 'status_menu': 'status'}.get(ui, ui)
    elif ui in ('add', 'duplicate'):
        if len(state['quote_messages']) >= 30:
            raise GodChatError('В цитате может быть не больше 30 сообщений.')
        new = copy.deepcopy(entry) if ui == 'duplicate' else dict(id=0, date=int(time.time()), message='', entities=[], quote_author=copy.deepcopy(entry['quote_author']))
        new.pop('quote_entry', None)
        state['quote_messages'].insert(state['quote_index'] + 1, new)
        state['quote_index'] += 1
        state['quote_view'] = 'editor'
    elif ui == 'delete':
        if len(state['quote_messages']) == 1:
            raise GodChatError('Нужно хотя бы одно сообщение.')
        deleted = state['quote_messages'].pop(state['quote_index'])['quote_entry']
        for message in state['quote_messages']:
            if message.get('quote_reply_key') == deleted:
                message.pop('quote_reply_key', None)
        if state.get('quote_wait', {}).get('entry') == deleted:
            state.pop('quote_wait', None)
    elif ui in ('prev', 'next'):
        state['quote_index'] = (state['quote_index'] + (-1 if ui == 'prev' else 1)) % len(state['quote_messages'])
    elif ui in ('text_message', 'reply_text_message', 'media_add', 'status_message'):
        _quote_wait(state, 'media' if ui == 'media_add' else 'status' if ui == 'status_message' else 'text', 'reply_text' if ui == 'reply_text_message' else 'text')
    elif ui in ('text_message_cancel', 'media_cancel', 'status_cancel'):
        state.pop('quote_wait', None)
    elif ui == 'status_clear':
        entry['display_status'] = False
        state.pop('quote_wait', None)
    elif ui == 'status_reset':
        entry.pop('display_status', None)
        state.pop('quote_wait', None)
    elif ui == 'via_clear':
        entry.pop('display_via', None)
        entry.pop('quote_via', None)
        entry['via_bot_id'] = None
    elif ui == 'reply_clear':
        for field in ('quote_reply', 'quote_reply_key', 'reply_to'):
            entry.pop(field, None)
    elif ui.startswith('reply:'):
        key = int(ui.split(':', 1)[1])
        if key == entry['quote_entry'] or not any(item.get('quote_entry') == key for item in state['quote_messages']):
            raise GodChatError('Сообщение для реплая недоступно.')
        entry['quote_reply_key'] = key
        entry.pop('quote_reply', None)
        entry.pop('reply_to', None)
        state['quote_view'] = 'editor'
    elif ui == 'media_clear':
        entry['media'] = None
    elif ui == 'buttons_clear':
        entry['reply_markup'] = None
    elif ui == 'reset_author':
        entry.pop('display_name', None)
        entry.pop('display_rank', None)
        entry.pop('display_role', None)
    else:
        raise GodChatError(_l('m376'))
    return await _quote_menu(ctx, state, callback)


async def _quote_parse_text(ctx, value):
    normalized = re.sub(r'<qe\s*>', '<blockquote expandable>', re.sub(r'<q\s*>', '<blockquote>', value, flags=re.I), flags=re.I)
    normalized = re.sub(r'</q(?:e)?>', '</blockquote>', normalized, flags=re.I)
    parsed = await ctx._ctx_prepare(normalized, 'HTML', None)
    text = parsed.get('message', '')
    if not text.strip() or len(text.encode('utf-16-le')) // 2 > 4096:
        raise GodChatError('Текст должен содержать от 1 до 4096 символов.')
    return dict(message=text, entities=parsed.get('entities') or [], rich_message=None, quote_edit_text=value)


async def _quote_apply_input(ctx, state, field, value, entry_id=None, from_message=False):
    if state['busy']:
        raise GodChatError('Дождись завершения операции.')
    value = value.strip()
    state['busy'] = True
    try:
        if field == 'background':
            data = await _quote_background_fetch(ctx, value)
            key = secrets.token_hex(6)
            chunks = [data[index:index + 128 * 1024] for index in range(0, len(data), 128 * 1024)]
            for index, chunk in enumerate(chunks):
                ctx.state.set('quote_bg:' + key + ':' + str(index), base64.b64encode(chunk).decode())
            old = ctx.state.get('quote_background') or {}
            ctx.state.set('quote_background', dict(url=value, key=key, parts=len(chunks)))
            if old.get('key'):
                for index in range(old.get('parts', 0)):
                    await ctx.cap('state', dict(op='delete', key='quote_bg:' + old['key'] + ':' + str(index)))
            options = _quote_options(ctx)
            options.update(background_mode='custom', background_url=value, background=True)
            ctx.state.set('quote_options', options)
            state['quote_view'] = 'background'
            state['quote_notice'] = 'Фон загружен и выбран.'
            return
        if field == 'trigger':
            value = ' '.join(value.split())
            if not 1 <= len(value) <= 32:
                raise GodChatError('Триггер должен содержать от 1 до 32 символов.')
            config = _quote_trigger(ctx, state['chat'])
            config['trigger'] = value
            _save(ctx, 'quote_triggers', state['chat'], config)
            return
        if field == 'pack':
            await _quote_pack_connect(ctx, state['chat'], value)
            return
        _quote_entry(state)
        message = next((entry for entry in state['quote_messages'] if entry['quote_entry'] == entry_id), None) if entry_id is not None else _quote_entry(state)
        if message is None:
            raise GodChatError('Сообщение уже удалено из редактора.')
        limit = 16384 if field in ('text', 'reply_text') else 64 if field == 'button_label' else 128
        if not value or len(value) > limit:
            raise GodChatError('Проверь длину введённого значения.')
        if field in ('text', 'reply_text') and not from_message and len(value.encode('utf-16-le')) // 2 >= 240:
            raise GodChatError('Для длинного текста используй «Текст следующим сообщением».')
        if field == 'author':
            author = await _resolve(ctx, value)
            message['quote_author'] = author
            message['from_id'] = _quote_peer(_id(author))
            for key in ('display_name', 'display_rank', 'display_role'):
                message.pop(key, None)
        elif field == 'text':
            message.update(await _quote_parse_text(ctx, value))
        elif field in ('name', 'rank'):
            message['display_name' if field == 'name' else 'display_rank'] = value
        elif field == 'via':
            message.update(quote_via=value, display_via=('через ' if not str(getattr(getattr(ctx, 'i18n', None), 'language', 'ru')).startswith('en') else 'via ') + value, via_bot_id=None, via_business_bot_id=None)
        elif field == 'time':
            if not re.fullmatch(r'[0-9]{1,4}:[0-9]{1,4}', value):
                raise GodChatError('Время: ЧЧ:ММ. Например: 18:30.')
            message['display_time'] = value
        elif field == 'status_id':
            if not re.fullmatch(r'[1-9]\d{0,18}', value):
                raise GodChatError('Укажи числовой ID премиум-эмодзи.')
            identity = int(value)
            documents = await _rpc(ctx, 'messages.getCustomEmojiDocuments', dict(document_id=[identity]))
            if not isinstance(documents, list) or not any(document.get('id') == identity for document in documents):
                raise GodChatError('Премиум-эмодзи с этим ID не найден.')
            message['display_status'] = identity
            state.pop('quote_wait', None)
        elif field == 'button_label':
            rows = (message.get('reply_markup') or {}).get('rows', [])
            if sum(len(row.get('buttons', [])) for row in rows) >= 16:
                raise GodChatError('Можно добавить не больше 16 кнопок.')
            rows.append(dict(_='keyboardButtonRow', buttons=[dict(_='keyboardButtonCallback', text=value, data=b'quote')]))
            message['reply_markup'] = dict(_='replyInlineMarkup', rows=rows)
        elif field in ('reply_author', 'reply_text'):
            manual = copy.deepcopy(message.get('quote_reply') or dict(quote_author=message['quote_author'], message='', entities=[]))
            if field == 'reply_author':
                manual['quote_author'] = await _resolve(ctx, value)
            else:
                manual.update(await _quote_parse_text(ctx, value))
            message['quote_reply'] = manual
            message.pop('quote_reply_key', None)
            message.pop('reply_to', None)
        else:
            raise GodChatError('Неизвестное поле редактора.')
        message.update(out=False, fwd_from=None)
    finally:
        state['busy'] = False


async def _quote_background_fetch(ctx, value):
    from urllib.parse import urlsplit, urljoin
    def valid(url):
        parsed = urlsplit(url)
        return parsed.scheme in ('http', 'https') and bool(parsed.hostname) and not parsed.username and not parsed.password and len(url) <= 2048
    if not valid(value):
        raise GodChatError('Укажи ссылку http/https на изображение.')
    class Images(HTMLParser):
        def __init__(self):
            super().__init__(convert_charrefs=True)
            self.links = []
        def handle_starttag(self, tag, attributes):
            attrs = dict(attributes)
            target, priority = None, 3
            if tag == 'meta' and (attrs.get('property') or attrs.get('name', '')).lower() in ('og:image', 'og:image:secure_url', 'twitter:image', 'twitter:image:src'):
                target, priority = attrs.get('content'), 1
            elif tag == 'link' and attrs.get('rel', '').lower() == 'image_src':
                target, priority = attrs.get('href'), 1
            elif tag == 'a' and ('download' in attrs or re.search(r'(?:raw|download|original)', attrs.get('href', ''), re.I)):
                target, priority = attrs.get('href'), 0
            elif tag == 'img' and not re.search(r'(?:logo|favicon|avatar|icon)', attrs.get('class', '') + ' ' + attrs.get('id', ''), re.I):
                target = attrs.get('data-original') or attrs.get('data-src') or attrs.get('src')
            if target:
                self.links.append((priority, target))
    queue, seen, data = [(value, 0)], set(), None
    while queue and len(seen) < 6:
        url, depth = queue.pop(0)
        if url in seen or not valid(url):
            continue
        seen.add(url)
        try:
            response = await ctx.cap('net', dict(url=url, binary=True, max_bytes=12 * 1024 * 1024, timeout=30))
            if response.get('status') != 200 or response.get('truncated'):
                continue
            candidate = base64.b64decode(response['body'], validate=True)
            if candidate.lstrip().startswith(b'<'):
                if len(candidate) > 2 * 1024 * 1024 or depth >= 2:
                    continue
                parser = Images()
                parser.feed(candidate.decode('utf-8', 'replace'))
                queue = [(urljoin(response.get('url') or url, link), depth + 1) for _, link in sorted(parser.links)][:6] + queue
                continue
            _quote_modules()
            with Image.open(io.BytesIO(candidate)) as image:
                if image.format not in ('PNG', 'JPEG', 'WEBP', 'GIF') or image.width * image.height > 16_000_000:
                    continue
                normalized = ImageOps.exif_transpose(image).convert('RGB')
                normalized.thumbnail((1280, 1280), Image.Resampling.LANCZOS)
                out = io.BytesIO()
                normalized.save(out, format='WEBP', quality=95, method=4)
                normalized.close()
                data = out.getvalue()
            if len(data) > 3 * 1024 * 1024:
                raise GodChatError('Фоновое изображение слишком большое.')
            break
        except asyncio.CancelledError:
            raise
        except Exception:
            continue
    if data is None:
        raise GodChatError('Не удалось загрузить фон по этой ссылке.')
    return data


def _quote_background(ctx):
    saved = ctx.state.get('quote_background') or {}
    if not saved.get('key') or not 1 <= saved.get('parts', 0) <= 24:
        raise GodChatError('Загрузи фон заново в настройках цитат.')
    return b''.join(base64.b64decode(ctx.state.get('quote_bg:' + saved['key'] + ':' + str(index)) or '', validate=True) for index in range(saved['parts']))


_QUOTE_TRIGGER_HITS = {}


@_localized
async def watcher_quotes(ctx, invocation):
    active = [state for state in list(_SESSIONS.values()) if state['chat'] == ctx.chat_id and state.get('quote_wait')]
    trigger = _quote_trigger(ctx, ctx.chat_id)
    if not active and not trigger['enabled']:
        return
    message = await ctx.msg(ctx.chat_id, ctx.message_id)
    if not isinstance(message, dict) or message.get('via_bot_id'):
        return
    sender = _sender(message) or (_id(await _me(ctx)) if message.get('out') else None)
    for state in active:
        wait = state.get('quote_wait')
        if not wait or sender != state['actor'] or state['busy']:
            continue
        if time.time() > wait['expires'] or _session_expired(state, time.time()):
            state.pop('quote_wait', None)
            continue
        text = message.get('message') or ''
        if text.startswith(str(ctx.prefix)) or message.get('action'):
            continue
        entry = next((item for item in state['quote_messages'] if item.get('quote_entry') == wait['entry']), None)
        if entry is None:
            state.pop('quote_wait', None)
            continue
        try:
            if message.get('noforwards'):
                raise GodChatError('В сообщении запрещено сохранение содержимого.')
            if wait['kind'] == 'media':
                if not message.get('media'):
                    continue
                entry['media'] = copy.deepcopy(message['media'])
            elif wait['kind'] == 'status':
                import regex
                document = (message.get('media') or {}).get('document')
                custom = next((entity.get('document_id') for entity in message.get('entities', []) if entity.get('_') == 'messageEntityCustomEmoji'), None)
                if document:
                    if not any(attr.get('_') in ('documentAttributeSticker', 'documentAttributeCustomEmoji') for attr in document.get('attributes', [])):
                        raise GodChatError('Отправь эмодзи или стикер.')
                    entry['display_status'] = dict(document=copy.deepcopy(document))
                elif custom:
                    entry['display_status'] = custom
                elif text and len(text) <= 32 and len(regex.findall(r'\X', text)) == 1:
                    entry['display_status'] = text
                else:
                    raise GodChatError('Отправь один эмодзи или стикер.')
            else:
                if not text.strip():
                    continue
                await _quote_apply_input(ctx, state, wait['field'], text, entry_id=wait['entry'], from_message=True)
                if wait['field'] == 'text':
                    entry.update(message=text, entities=copy.deepcopy(message.get('entities') or []), quote_edit_text=text, rich_message=copy.deepcopy(message.get('rich_message')))
            state.pop('quote_wait', None)
            await _delete(ctx, ctx.chat_id, [ctx.message_id])
        except asyncio.CancelledError:
            raise
        except Exception as exc:
            state['quote_notice'] = str(exc)[:250]
        await _quote_menu(ctx, state, _SavedForm(ctx, state))
        return
    reply = message.get('reply_to') or {}
    if not trigger['enabled'] or not reply.get('reply_to_msg_id') or ctx.chat_id >= 0:
        return
    text = ' '.join((message.get('message') or '').split()).casefold()
    expected = trigger['trigger'].casefold()
    if text != expected and not re.fullmatch(re.escape(expected) + r' [0-9]{1,2}', text):
        return
    try:
        if (await _resolve(ctx, sender)).get('bot'):
            return
        count = 1 if text == expected else int(text[len(expected) + 1:])
        if not 1 <= count <= 30:
            return
        now = time.monotonic()
        hits = [stamp for stamp in _QUOTE_TRIGGER_HITS.get(ctx.chat_id, []) if now - stamp < 5]
        if len(hits) >= 2:
            return
        hits.append(now)
        _QUOTE_TRIGGER_HITS[ctx.chat_id] = hits
        async with _quote_activity(ctx):
            messages = await _quote_messages(ctx, SimpleNamespace(args=[str(count)]))
            await _quote_render(ctx, messages, _quote_options(ctx)['send_format'])
    except asyncio.CancelledError:
        raise
    except Exception as exc:
        await ctx.cap('logs', dict(op='write', level='warning', msg='GodChat quote trigger failed: ' + str(exc)[:250]))
